# Credenciales para el sync desatendido con Jira (scripts/jira-sync.mjs).
# NO usa el MCP (que es OAuth interactivo): usa un API token para poder correr en cron/CI.
# Copia a .env (o exporta en tu shell / secrets de CI). NO commitees el token real.

# Site de Jira (host, sin https://). O usa JIRA_BASE_URL para el URL completo.
JIRA_SITE=singularis-su.atlassian.net

# Email de la cuenta Atlassian dueña del token.
JIRA_EMAIL=tu-email@ejemplo.com

# API token: crealo en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Key del proyecto (default: KAN).
JIRA_PROJECT=KAN
