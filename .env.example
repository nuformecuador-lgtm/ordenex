# Plantilla de variables de entorno. Copia a `.env` y rellena los valores reales.
# NUNCA se commitean valores: este archivo solo documenta los NOMBRES (docs/architecture.md).

# --- Integracion WhatsApp Cloud API (Meta Graph API) ---
# Credenciales del ENVIO saliente (features 107 / 109). Ver lib/config/whatsapp.ts.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_NUMERO_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_CATEGORY=
WHATSAPP_TEMPLATE_LANG=

# Volcado SIN redactar de lo que se envia a la Graph API de WhatsApp (destino y
# contenido incluidos). Solo para depurar un 400: dejalo vacio en produccion.
WHATSAPP_DEBUG_LOG=

# Feature 109 — WEBHOOK de entrada (chat del mensajero <-> cliente). Secretos DISTINTOS de
# los del envio (el webhook puede operar sin credencial de envio y viceversa):
#  - WHATSAPP_WEBHOOK_VERIFY_TOKEN: token del handshake GET (`hub.verify_token`); se compara
#    con el que Meta envia al verificar la suscripcion. Cadena arbitraria que tu eliges.
#  - WHATSAPP_APP_SECRET: App Secret de la app de Meta; con el se valida el HMAC-SHA256 del
#    cuerpo crudo del POST (`X-Hub-Signature-256`). Se encuentra en el panel de la app de Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SINPE del negocio (numero y titular) que las plantillas insertan como {{sinpe}} / {{sinpe_nombre}}
NEXT_PUBLIC_SINPE_NUMERO=
NEXT_PUBLIC_SINPE_NOMBRE=

# --- Feature 136: PDF consolidado de etiquetas de la carga por API ---
# Ver lib/config/etiquetas.ts. Las tres son OPCIONALES: sin valor se usa el default.
#  - ETIQUETAS_BUCKET: bucket PRIVADO de Supabase Storage donde se guarda el PDF del
#    lote. Default "etiquetas-guia". Nunca debe ser publico: el PDF se entrega por URL
#    firmada.
#  - ETIQUETAS_SIGNED_URL_TTL_SECONDS: vigencia (segundos) de esa URL firmada.
#    Default 3600 (1 h); se acota a 86400 (24 h) por mucho que se suba.
#  - ETIQUETAS_MAX_POR_PDF: tope de etiquetas en un mismo PDF. Default 300 (techo duro
#    1000). Por encima, la carga responde 200 con `etiquetasPdf: { error }` y conserva
#    los num_guia, en vez de arriesgar un OOM/timeout que los haria perder.
ETIQUETAS_BUCKET=
ETIQUETAS_SIGNED_URL_TTL_SECONDS=
ETIQUETAS_MAX_POR_PDF=

# --- Feature 177: URL firmada de los endpoints /generate de la API de consulta ---
#  - ETIQUETAS_API_SIGNED_URL_TTL_SECONDS: vigencia (segundos) de la URL firmada que
#    devuelven POST /api/ordenes/api-key/orden/{id}/generate y .../carga/{cargaId}/generate.
#    OPCIONAL. Default 300 (5 min); se acota a 86400 (24 h). Es una clave APARTE de
#    ETIQUETAS_SIGNED_URL_TTL_SECONDS para no cambiar el contrato de la carga por API.
ETIQUETAS_API_SIGNED_URL_TTL_SECONDS=

# --- Feature 178: purga diaria de los PDF de cargas antiguas ---
# Ver lib\config\purga-pdf.ts. Las dos son OPCIONALES: sin valor se usa el default.
# El secreto del cron NO es nuevo: se reutiliza CRON_SECRET.
#  - PURGA_PDF_RETENCION_DIAS: dias que se conservan los PDF de una carga (el
#    consolidado del lote y los individuales de sus ordenes) antes de borrarlos del
#    bucket de etiquetas. Default 7. Minimo 0, SIN tope superior; ausente, vacia, no
#    entera o negativa cae al default.
#    OJO: `0` es un valor VALIDO, no un "desactivado": con 0 el corte es el instante de
#    la corrida y se purga TAMBIEN lo creado el mismo dia. No es irreversible: los
#    endpoints /generate de la API de consulta (feature 177) regeneran el PDF bajo
#    demanda; lo que se pierde es la URL firmada vigente, que caduca igualmente.
#  - PURGA_PDF_MAX_CARGAS_POR_CORRIDA: tope de cargas procesadas en una misma corrida,
#    para no agotar el tiempo de ejecucion de la funcion. Default 200; cero, negativo o
#    invalido cae al default (un tope de 0 no purgaria nunca). Lo que exceda el tope
#    queda pendiente y lo retoma la corrida del dia siguiente.
PURGA_PDF_RETENCION_DIAS=
PURGA_PDF_MAX_CARGAS_POR_CORRIDA=

# --- Feature 265: optimizacion de ruta del mensajero ---
# Solo las DOS variables que esta feature decide. El resto de la familia RUTA_* /
# GOOGLE_ROUTE_OPT_* no se documenta aqui todavia: ver lib/config/route-optimization.ts.
#
#  - RUTA_ORIGEN_MAX_KM: distancia MAXIMA, en km, entre el punto de partida resuelto y el
#    centroide de las paradas. Por encima, ese origen se descarta y se usa el centroide, en
#    vez de pagar una llamada al proveedor que solo puede fallar. Default 200.
#    🧭 PROVISIONAL: no esta calibrado con datos de produccion (2026-08-22, no habia paradas
#    con las que medirlo). Ausente, vacia o invalida cae al default sin lanzar.
RUTA_ORIGEN_MAX_KM=

#  - RUTA_DEBUG_LOG: enciende la traza de diagnostico `optimizer***:` del optimizador.
#    APAGADA por defecto desde la feature 265; se enciende con `1` (o `true`) y cualquier
#    otro valor —incluido `0`— la deja apagada.
#    ⚠️ ENCENDIDA IMPRIME COORDENADAS DE ENTREGA de los destinatarios en el log del
#    despliegue: es dato personal saliendo de la base hacia un tercero. Enciendela solo para
#    diagnosticar, por entorno, y apagala al terminar.
RUTA_DEBUG_LOG=

# --- Log de las consultas SQL (solo desarrollo) ---
# Ver lib\db\prisma-client.ts. OPCIONAL; sin valor no se imprime nada.
#  - PRISMA_LOG_QUERIES=1 (o `true`/`sql`): imprime cada sentencia y su duracion.
#  - PRISMA_LOG_QUERIES=params: imprime ADEMAS los parametros.
#    Es un nivel APARTE a proposito: la sentencia es una plantilla y no dice nada de
#    nadie, pero los parametros llevan datos reales (un `where` del buscador arrastra
#    telefono y nombre del destinatario), asi que hay que pedirlos por su nombre.
#  - `0`, `false`, `off` y la variable vacia lo dejan apagado.
# En NODE_ENV=production se IGNORA siempre: encender un log por consulta ahi debe costar
# un despliegue, no una variable cambiada en caliente.
PRISMA_LOG_QUERIES=
