generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TipoIdentificacion {
  id    String @id @default(uuid())
  value String @unique // seed: "cedula", "ruc", "pasaporte"

  usuarios Usuario[]

  @@map("tipo_identificacion")
}

model Rol {
  id    String   @id @default(uuid())
  value RolValue @unique // seed: "maestro", "admin", "mensajero", "Admin Tienda", "adminSatelite"

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("rol")
}

enum RolValue {
  maestro
  admin
  mensajero
  adminTienda   @map("Admin Tienda")
  adminSatelite // feature 19: label literal en la DB 'adminSatelite' (slug camelCase, SIN @map)
  apiKey // feature 81 [D1]: cuenta dedicada a una API key. SIN filas en `rol_permiso` (fallo seguro: la key no puede nada hasta que el humano conceda permisos explicitos)

  @@map("rol_value")
}

model Permiso {
  id        String   @id @default(uuid())
  nombre    String
  method    String // verbo HTTP (texto libre, ver design.md "Alternativas descartadas")
  route     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles RolPermiso[]

  @@unique([method, route]) // R6
  @@map("permiso")
}

// Tabla pivote explicita de la relacion N:M rol <-> permiso.
model RolPermiso {
  rolId     String   @map("rol_id")
  permisoId String   @map("permiso_id")
  createdAt DateTime @default(now()) @map("created_at")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId]) // R8: pareja unica
  @@index([permisoId])
  @@map("rol_permiso")
}

enum EstadoUsuario {
  pendiente // recien creado, sin verificar
  activo
  inactivo
  bloqueado // por seguridad / bloqueo por fallos

  @@map("estado_usuario")
}

model Usuario {
  id                   String        @id @default(uuid())
  nombre               String
  primerApellido       String?       @map("primer_apellido") // feature 21: identidad; requerido en postulacion via servicio, nullable en DB
  segundoApellido      String?       @map("segundo_apellido") // feature 21: opcional
  email                String        @unique
  telefono             String
  passwordHash         String        @map("password_hash")
  estado               EstadoUsuario @default(pendiente)
  cedula               String        @unique
  tipoIdentificacionId String        @map("tipo_identificacion_id")
  rolId                String        @map("rol_id")
  vehiculoId           String?       @map("vehiculo_id") // feature 21: solo mensajeros; FK -> vehiculos
  placa                String? // feature 21: placa del vehiculo del mensajero, normalizada uppercase/trim
  fulfillment          Boolean       @default(false) // feature 27: tienda con fulfillment (rol adminTienda); default false
  zonaId               String?       @map("zona_id") // feature 24/R6: nullable; solo mensajero/adminSatelite lo llevan
  ordenEnGestionId     String?       @map("orden_en_gestion_id") // feature 36/R19-R21: orden activa 1-a-1 en gestion; NULL = ninguna
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tipoIdentificacion                  TipoIdentificacion        @relation(fields: [tipoIdentificacionId], references: [id])
  rol                                 Rol                       @relation(fields: [rolId], references: [id])
  vehiculo                            Vehiculo?                 @relation(fields: [vehiculoId], references: [id]) // feature 21
  zona                                Zona?                     @relation(fields: [zonaId], references: [id]) // feature 24/R6/R8: ON DELETE RESTRICT
  ordenEnGestion                      Orden?                    @relation("UsuarioOrdenEnGestion", fields: [ordenEnGestionId], references: [id], onDelete: SetNull) // feature 36/R19-R21
  loginAttempts                       LoginAttempt[]
  trustedDevices                      TrustedDevice[]
  otpChallenges                       EmailOtpChallenge[]
  documentos                          MensajeroDocumento[] // feature 21
  ordenesTienda                       Orden[]                   @relation("OrdenTienda")
  ordenesAsignadas                    Orden[]                   @relation("OrdenMensajeroAsignado") // feature 17: mensajero ASIGNADO (decision del maestro)
  gestionesRealizadas                 GestionOrden[]            @relation("GestionMensajero") // feature 36: gestiones que este mensajero registro
  gestionesAnuladas                   GestionOrden[]            @relation("GestionAnuladaPor") // feature 67/R11: gestiones que este usuario DESHIZO (rastro de la anulacion)
  gestionesPagosEditados              GestionOrden[]            @relation("GestionPagosEditadosPor") // gestiones cuyo desglose de pago CORRIGIO este usuario
  tarifasTienda                       Tarifa[]                  @relation("TarifaTienda") // tarifas cuya tienda es este usuario (adminTienda)
  cierresRealizados                   CierreDia[]               @relation("CierreMensajero") // feature 37: cierres del dia solicitados por este mensajero
  cierresResueltos                    CierreDia[]               @relation("CierreResueltoPor") // feature 38: cierres que este admin aprobo/rechazo
  cierresBodegaSolicitados            CierreBodega[]            @relation("CierreBodegaSolicitadoPor") // feature 40: cierres de bodega solicitados por este adminSatelite
  cierresBodegaResueltos              CierreBodega[]            @relation("CierreBodegaResueltoPor") // feature 40: cierres de bodega que este maestro aprobo/rechazo
  walletMovimientosRegistrados        WalletMovimiento[]        @relation("WalletMovimientoRegistrador") // feature 42/R2/R15: movimientos manuales que este usuario (maestro) registro
  walletTiendaMovimientos             WalletTiendaMovimiento[]  @relation("WalletTiendaMovimientoTienda") // feature 43/R1/R2: movimientos del ledger de ESTA tienda (rol adminTienda)
  walletTiendaMovimientosRegistrados  WalletTiendaMovimiento[]  @relation("WalletTiendaMovimientoRegistrador") // feature 43/R2: movimientos manuales del ledger de tienda que este usuario registro
  pagoMensajeroMovimientos            PagoMensajeroMovimiento[] @relation("PagoMensajeroMovimientoMensajero") // feature 44/R1/R2: movimientos del libro del pago a ESTE mensajero (rol mensajero)
  pagoMensajeroMovimientosRegistrados PagoMensajeroMovimiento[] @relation("PagoMensajeroMovimientoRegistrador") // feature 44/R2: movimientos manuales del libro del pago que este usuario registro
  historialEstadosActuados            OrdenHistorialEstado[]    @relation("HistorialActor") // feature 49/R21: transiciones de estado que este usuario (actor) origino
  cierreDetallesTienda                CierreDetail[]            @relation("CierreDetailTienda") // feature 69/R6: snapshots que congelaron a esta tienda como destinataria
  apiKey                              ApiKey?                   @relation("ApiKeyUsuario") // feature 81/[D6]: la key dedicada a ESTA cuenta sintetica (1:1)
  apiKeysCreadas                      ApiKey[]                  @relation("ApiKeyCreadaPor") // feature 81/R21: keys que este usuario (maestro) genero
  rutaOptimizada                      RutaOptimizada?           @relation("RutaOptimizadaMensajero") // feature 92/R26: ruta optimizada vigente de ESTE mensajero (1:1)
  plantillasCreadas                   PlantillaMensaje[]        @relation("PlantillaMensajeCreador") // feature 107/R8: plantillas de mensaje que este usuario (maestro) creo
  webhookSuscripcion                  WebhookSuscripcion?       @relation("WebhookSuscripcionOwner") // feature 99/R1: suscripcion de webhook de ESTE owner (usuario dedicado de la API key); 1:1
  ordenMensajeroMetas                 OrdenMensajeroMeta[]      @relation("OrdenMensajeroMetaMensajero") // feature 115: marcas privadas ("gestionar mas tarde") de ESTE mensajero sobre sus ordenes
  chatConversaciones                  ChatConversacion[]        @relation("ChatConversacionMensajero") // feature 120/R13/R16: hilos de chat asignados a ESTE mensajero
  notificacionesRecibidas             Notificacion[]            @relation("NotificacionDestinatario") // feature 146/R1: notificaciones dirigidas a ESTE usuario (D4)
  notificacionesDeSuTienda            Notificacion[]            @relation("NotificacionTienda") // feature 146/F1.4-1: notificaciones ACOTADAS a esta tienda (el adminTienda ES la tienda)
  notificacionLecturas                NotificacionLectura[] // feature 146/R2/R3: lectura/descarte de ESTE usuario, aislado de los demas del mismo rol
  cargasRealizadas                    Carga[]                   @relation("CargaUsuario") // feature 141/R2: lotes de carga masiva que ESTE usuario realizo (adminTienda o usuario dedicado de la API key)
  incidentesReportados                OrdenIncidente[]          @relation("IncidenteReportadoPor") // feature 158/R39/R51: incidentes que este admin REPORTO (y que por tanto NO puede aprobar)
  incidentesResueltos                 OrdenIncidente[]          @relation("IncidenteResueltoPor") // feature 158/R52/R54: incidentes que este admin aprobo/rechazo
  analyticsDailyComoTienda            AnalyticsDaily[]          @relation("AnalyticsDailyTienda") // feature 123/R31: filas del rollup diario cuya TIENDA (de la orden) es este usuario
  analyticsDailyComoMensajero         AnalyticsDaily[]          @relation("AnalyticsDailyMensajero") // feature 123/R32: filas del rollup diario de este mensajero (el cubo sin_asignar NO cuelga de aqui: es NULL)
  liquidacionPagosComoMensajero       LiquidacionPago[]         @relation("LiquidacionPagoMensajero") // feature 172/R21: pagos (liquidaciones) recibidos por ESTE mensajero
  liquidacionPagosComoTienda          LiquidacionPago[]         @relation("LiquidacionPagoTienda") // feature 172/R29: pagos recibidos por ESTA tienda (contra su saldo acumulado)
  liquidacionPagosRegistrados         LiquidacionPago[]         @relation("LiquidacionPagoRegistrador") // feature 172/R7: pagos que este usuario (maestro/admin) registro
  liquidacionAnulacionesRealizadas    LiquidacionAnulacion[]    @relation("LiquidacionAnulacionActor") // feature 172/R73: anulaciones de pago que este usuario realizo
  liquidacionRepartosComoMensajero    LiquidacionReparto[]      @relation("LiquidacionRepartoMensajero") // feature 205/R29: repartos (un importe troceado entre sus cierres) recibidos por ESTE mensajero
  liquidacionRepartosRegistrados      LiquidacionReparto[]      @relation("LiquidacionRepartoRegistrador") // feature 205/R29: repartos que este usuario (maestro/admin) registro
  rankingSnapshotFilas                RankingSnapshotFila[]     @relation("RankingSnapshotFilaMensajero") // feature 196/R17: filas del ranking CONGELADO de este mensajero; la FK es RESTRICT (borrar el usuario con historia falla)
  ordenNotasEscritas                  OrdenNota[]               @relation("OrdenNotaAutor") // feature 227: notas del hilo que ESTE usuario publico; la FK es RESTRICT (la autoria es evidencia y no se pierde al dar de baja al usuario)
  postulacionesRecursoAtendidas       PostulacionRecurso[]      @relation("PostulacionRecursoAtendidaPor") // feature 253: postulaciones de vehiculo/bodega que ESTE admin marco atendidas; la FK es RESTRICT (quien atendio es evidencia)
  diaRepartoCambiosRealizados         OrdenDiaRepartoCambio[]   @relation("OrdenDiaRepartoCambioActor") // feature 262/R20: correcciones del dia de reparto que ESTE usuario hizo; la FK es RESTRICT (quien corrigio es evidencia y no se pierde al dar de baja al usuario)
  habilitacionesApiPedidas            OrdenHabilitacionApi[]    @relation("OrdenHabilitacionApiActor") // feature 266/R21: habilitaciones que ESTE usuario dedicado de API key pidio por el canal integrador; la FK es RESTRICT (la autoria es evidencia y no se pierde al dar de baja al usuario)

  @@index([tipoIdentificacionId])
  @@index([rolId])
  @@index([vehiculoId]) // feature 21
  @@index([zonaId]) // feature 24/R6
  @@index([ordenEnGestionId]) // feature 36
  @@map("usuario")
}

// Feature 107: estado de una plantilla de mensaje. Enum Postgres nativo (patron
// RolValue). Cuatro valores EXACTOS (R23). `pending` (estado inicial,
// Decision humana 1) y `refused` quedan RESERVADOS en el enum aunque este alcance NO
// los transiciona desde el front; el front SOLO emite el destino `inactivo` (R24/R25).
enum PlantillaEstado {
  activo
  inactivo
  pending
  refused
  // 2026-08-26 — GUARDADO SIN APROBACION: la plantilla existe aqui pero NUNCA se envio a Meta.
  // Es el estado con el que nacen todas desde hoy (`crear` ya no propaga; propagar es un acto
  // explicito del maestro, "Enviar para aprobacion"). NO es lo mismo que `pending`: aquel
  // significa "Meta la esta revisando", que es un hecho comprobable contra Meta; este significa
  // "aqui no ha salido de casa". Fundirlos dejaba sin respuesta la pregunta que decide si una
  // plantilla se puede llegar a usar. Ver `20260826120000_plantilla_estado_saved_not_aprobation`.
  saved_not_aprobation

  @@map("plantilla_estado")
}

// Feature 107: plantilla de mensaje con cuerpo que admite campos variables `{{clave}}`.
// Configuracion MUTABLE (lleva updatedAt). SOFT DELETE via `deletedAt` (Decision humana
// 3; R27/R28): los listados filtran `deletedAt IS NULL`. El conjunto de variables usadas
// por el cuerpo se persiste como ARRAY de claves (Decision humana 4; R15), text[] nativo.
model PlantillaMensaje {
  id             String          @id @default(uuid())
  nombre         String          @unique // R10: identificador unico
  cuerpo         String // texto con placeholders {{clave}}
  // `@default([])` NO es cosmetico: la migracion `20260722130000_plantilla_mensaje` creo la
  // columna `text[] NOT NULL DEFAULT '{}'` como REQUISITO escrito (R12/R15/R27: "nunca null").
  // Sin declararlo aqui, todo `migrate dev` proponia `DROP DEFAULT` y habria roto ese requisito.
  variables      String[]        @default([]) // R15: claves detectadas en el cuerpo (text[]), sin duplicados, sincronizadas con `cuerpo`
  /// Snapshot `clave -> nombre legible` tomado del catalogo (`CAMPOS_PLANTILLA`) en el
  /// ultimo guardado. Es PRESENTACION: ningun camino de envio lo lee. `{}` = fila anterior
  /// a la feature 282 (se deriva del catalogo al pintar, R21), NUNCA null.
  variablesNombres Json          @default("{}") @map("variables_nombres")
  // El DEFAULT sigue siendo `pending` y NO se mueve a `saved_not_aprobation`: Postgres prohibe
  // USAR un valor de enum en la misma transaccion en que se anade, asi que el `SET DEFAULT`
  // habria abortado la migracion. Quien fija el estado inicial es el service (que es donde
  // vive la politica) pasandolo explicito en el `create`; el default de columna no lo decide
  // nadie hoy porque ninguna escritura lo omite.
  estado         PlantillaEstado @default(pending) // R12 (Decision humana 1)
  /// Marca la plantilla que se envia automaticamente al cliente cuando el paquete es recogido.
  /// Como mucho UNA vigente puede tenerlo en `true`, y quien lo garantiza es la BASE con un
  /// UNIQUE PARCIAL —`plantilla_mensaje_welcome_message_key`, `WHERE welcome_message = true AND
  /// deleted_at IS NULL`— que Prisma no sabe expresar y por eso va a mano en
  /// `20260826200000_plantilla_welcome_message` (mismo caso que `jobs.dedupeKey`). NO lleva
  /// `@unique` aqui: eso pediria un indice TOTAL y solo dejaria una fila en `false` en toda la
  /// tabla. Toda lectura de la bienvenida filtra `deletedAt IS NULL`: una borrada conserva su
  /// `true` historico pero queda fuera del indice y del negocio.
  welcomeMessage Boolean         @default(false) @map("welcome_message")
  // Integracion WhatsApp: enlace al Message Template de Meta. NULL = todavia no propagada a
  // Meta (o Meta no la ha devuelto en la sincronizacion). El envio usa `nombre` + `templateIdioma`
  // (Meta manda por name+language, no por id); `templateId` es la referencia/traza a Meta y el
  // marcador de "enviable" (no NULL + estado activo).
  templateId     String?         @map("template_id")
  templateIdioma String?         @map("template_idioma") // code de idioma del template en Meta (p. ej. "es", "es_CO")
  createdBy      String?         @map("created_by") // FK -> usuario (maestro actor); SET NULL al borrar el usuario
  deletedAt      DateTime?       @map("deleted_at") // R27: soft delete; NULL = vigente
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  creador Usuario? @relation("PlantillaMensajeCreador", fields: [createdBy], references: [id], onDelete: SetNull)

  chatMensajes ChatMensaje[] @relation("ChatMensajePlantilla") // feature 109: salientes de tipo plantilla que referencian esta plantilla

  @@index([createdAt]) // R6: orden determinista del listado
  @@index([estado]) // filtro por estado
  @@index([deletedAt]) // R28: filtro de vigentes (deletedAt IS NULL)
  @@map("plantilla_mensaje")
}

// Feature 109 (design §1.1): direccion de un mensaje del chat. Enum Postgres nativo
// (patron RolValue/PlantillaEstado). `entrante` = del cliente (llega por el webhook);
// `saliente` = del mensajero (se envia por la Graph API).
enum ChatMensajeDireccion {
  entrante
  saliente

  @@map("chat_mensaje_direccion")
}

// Feature 109 (design §1.1): tipo de un mensaje del chat. `texto` (cuerpo libre),
// `plantilla` (Message Template de Meta), `otro` (multimedia entrante no expandido en v1).
enum ChatMensajeTipo {
  texto
  plantilla
  otro
  ubicacion // Feature 121: mensaje entrante `type=location` con coordenadas lat/lng

  @@map("chat_mensaje_tipo")
}

// Feature 109 (design §1.1): estado de entrega de un mensaje SALIENTE (R7/R14). Solo
// aplica a salientes (nullable en entrantes). `queued` = pendiente de reintento por la
// cola de jobs; el resto lo reporta Meta via el webhook de statuses.
enum ChatMensajeEstado {
  queued
  sent
  delivered
  read
  failed

  @@map("chat_mensaje_estado")
}

// Feature 109 (design §1.2, R13): hilo de chat 1:1 entre el mensajero y el cliente
// destinatario de una orden, identificado por el numero E.164 del cliente. Un hilo por
// (orden, numero) (ver D4). `ultimoEntranteAt` es la fuente de la ventana de 24 h
// (R18/R19). RLS habilitada sin policies (solo service role): la autorizacion de negocio
// (scope por mensajero, R16) vive en el service, no en la DB.
model ChatConversacion {
  id               String    @id @default(uuid())
  telefonoE164     String    @map("telefono_e164") // numero del cliente normalizado E.164 (sin `+`, formato del cliente de envio)
  ordenId          String    @map("orden_id") // FK -> orden; ON DELETE RESTRICT (no huerfanos)
  mensajeroId      String    @map("mensajero_id") // FK -> usuario (mensajero asignado del hilo); ON DELETE RESTRICT
  ultimoEntranteAt DateTime? @map("ultimo_entrante_at") // marca del ultimo mensaje ENTRANTE; NULL = sin entrantes (fuera de ventana)
  // Hasta donde LEYO el mensajero este hilo. NULL = nunca lo abrio -> todo entrante cuenta como
  // no leido. El contador del chat es `entrantes con ocurrido_at > mensajero_leido_at`, asi que
  // guardar la MARCA (no un contador) hace la lectura idempotente y sin condiciones de carrera.
  mensajeroLeidoAt DateTime? @map("mensajero_leido_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  orden     Orden         @relation(fields: [ordenId], references: [id], onDelete: Restrict)
  mensajero Usuario       @relation("ChatConversacionMensajero", fields: [mensajeroId], references: [id], onDelete: Restrict)
  mensajes  ChatMensaje[]

  @@unique([ordenId, telefonoE164]) // D4: un hilo por orden+numero
  @@index([mensajeroId]) // R16: scope por mensajero
  @@index([telefonoE164]) // R25: resolucion del entrante desde el numero
  @@map("chat_conversacion")
}

// Feature 109 (design §1.3, R14): un mensaje del hilo. Fila casi inmutable (sin
// updatedAt/deletedAt): lo unico que muta es `estado` de un saliente al llegar su status
// de Meta (R7). `waMessageId` es UNICO (indice parcial en la migracion) para el dedupe
// (R8) y para localizar el saliente al llegar un status (R7). RLS habilitada sin policies.
model ChatMensaje {
  id             String               @id @default(uuid())
  conversacionId String               @map("conversacion_id") // FK -> chat_conversacion; ON DELETE CASCADE
  direccion      ChatMensajeDireccion
  tipo           ChatMensajeTipo
  cuerpo         String? // texto plano; NULL para tipos sin cuerpo
  plantillaId    String?              @map("plantilla_id") // solo salientes de tipo plantilla; ON DELETE SET NULL
  waMessageId    String?              @map("wa_message_id") // id de Meta; UNICO (parcial) para dedupe (R8)
  estado         ChatMensajeEstado? // solo salientes (R7)
  latitud        Float?               @map("latitud") // Feature 121: solo entrantes tipo `ubicacion`; NULL en el resto
  longitud       Float?               @map("longitud") // Feature 121: solo entrantes tipo `ubicacion`; NULL en el resto
  // Motivo del fallo que Meta reporta en el status `failed` (`errors[0]`). Solo se pueblan
  // en salientes fallidos; NULL en todo lo demas. Sin ellos un `failed` es mudo y obliga a
  // entrar al panel de Meta para saber por que no se entrego.
  errorCodigo    Int?                 @map("error_codigo") // p. ej. 131026 (indeliverable), 130429 (cuota)
  errorTitulo    String?              @map("error_titulo")
  errorDetalle   String?              @map("error_detalle") // texto de Meta SOBRE EL ERROR, nunca el destino
  ocurridoAt     DateTime             @map("ocurrido_at") // timestamp del evento (de Meta en entrantes)
  createdAt      DateTime             @default(now()) @map("created_at")

  conversacion ChatConversacion  @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  plantilla    PlantillaMensaje? @relation("ChatMensajePlantilla", fields: [plantillaId], references: [id], onDelete: SetNull)

  @@index([conversacionId, ocurridoAt]) // R22: historial ordenado
  // El indice REAL es PARCIAL (`WHERE error_codigo IS NOT NULL`) y va a mano en
  // `20260728230000_chat_mensaje_error_meta`; Prisma no expresa el predicado, asi que aqui se
  // declara el btree equivalente. El `map:` es OBLIGATORIO: sin el, Prisma propone renombrarlo a
  // su nombre por defecto y ese rename dejaria mudo al `DROP INDEX IF EXISTS
  // "chat_mensaje_error_codigo_idx"` del `down.sql` de esa migracion.
  @@index([errorCodigo, ocurridoAt(sort: Desc)], map: "chat_mensaje_error_codigo_idx") // diagnostico: fallos recientes por codigo
  @@map("chat_mensaje")
}

// Feature 21: documentos de postulacion del mensajero. 1:N (5 tipos por usuario).
// El binario vive en Supabase Storage (bucket privado); aqui solo el path/metadatos.
model MensajeroDocumento {
  id          String                 @id @default(uuid())
  usuarioId   String                 @map("usuario_id")
  tipo        MensajeroDocumentoTipo
  storagePath String                 @map("storage_path") // path en el bucket privado, NO URL publica (R18)
  contentType String                 @map("content_type") // image/jpeg | image/png | image/webp
  createdAt   DateTime               @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo]) // R16: un documento por tipo por usuario
  @@index([usuarioId])
  @@map("mensajero_documento")
}

enum MensajeroDocumentoTipo {
  cedula_anverso
  cedula_reverso
  propiedad_anverso
  propiedad_reverso
  foto_rostro

  @@map("mensajero_documento_tipo")
}

model LoginAttempt {
  id         String   @id @default(uuid())
  usuarioId  String?  @map("usuario_id") // null si el email no resolvio a usuario
  emailUsado String   @map("email_usado")
  exitoso    Boolean
  ipAddress  String   @map("ip_address")
  userAgent  String   @map("user_agent")
  riskScore  Int      @map("risk_score")
  riskReason String   @map("risk_reason") // resumen de senales usadas
  createdAt  DateTime @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempt")
}

model TrustedDevice {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  deviceHash String   @map("device_hash") // hash de fingerprint (UA + atributos), nunca PII cruda
  ipAddress  String   @map("ip_address")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, deviceHash])
  @@index([usuarioId])
  @@map("trusted_device")
}

// Challenge OTP por email para el paso adicional de RBA (R17-R20).
model EmailOtpChallenge {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  codeHash   String    @map("code_hash") // hash del codigo OTP, nunca el codigo en claro
  deviceHash String    @map("device_hash") // dispositivo a confiar si el OTP se supera (R19)
  ipAddress  String    @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
  @@map("email_otp_challenge")
}

// Catalogo de estatus de orden (tabla, no enum Postgres; R1). Seed idempotente
// por `value` (8 valores, ORDER_STATUS_SEED), patron rol/tipo_identificacion.
model OrderStatus {
  id    String @id @default(uuid())
  value String @unique // seed (20, ver ORDER_STATUS_SEED; el conteo decia 15, corregido en
  //   la feature 153). Feature 135 renombro 6 values: p.ej. devolviendo_a_tienda,
  //   en_ruta_bodega_central, en_bodega_central, por_recoger, devuelta_a_tienda. Feature 153
  //   renombro uno mas a `en_reparto` (id/FK preservados por UPDATE de catalogo, sin ALTER TYPE).
  //   Feature 154 apendio dos values (18 -> 20): por_recolectar_en_tienda e incidente
  //   (INSERT idempotente, `20260729120000_order_status_v2_por_recolectar_incidente`).

  ordenes Orden[]

  historialComoOrigen  OrdenHistorialEstado[] @relation("HistorialOrigen") // feature 49: transiciones que SALEN de este estado
  historialComoDestino OrdenHistorialEstado[] @relation("HistorialDestino") // feature 49: transiciones que ENTRAN a este estado

  analyticsDaily AnalyticsDaily[] // feature 123/R33/R36: filas del rollup diario congeladas en este estatus al corte del dia

  cierresSinGestionOrigen CierreSinGestion[] // feature 264/R4: barridos del corte que SALIERON de este estatus

  @@map("order_status")
}

// Geografia jerarquica (feature 6 la creo vacia). Feature 24: la zona pasa a ser un
// catalogo global con pagos al mensajero y flag `es_gam`. Feature 24/R4: la zona ya
// NO cuelga de la provincia; la asignacion vive en `distrito.zona_id` (escalar) mas
// la relacion N:M `ZonaDistrito`. La columna `provincia.zona_id` fue ELIMINADA en la
// DB por la migracion 20260711120000_zonas_catalogo_global_pagos y nunca re-creada;
// feature 55 (F1.4-C) reconcilia el schema removiendo los simbolos huerfanos
// (`Provincia.zonaId`/`Provincia.zona`/`Zona.provincias`). La carga masiva (feature
// 15) deriva `orden.zona_id` del DISTRITO de la orden (`distrito.zona_id`).
model Zona {
  id            String  @id @default(uuid())
  nombre        String  @unique // feature 24: nombre unico (indice zona_nombre_key); feature 54 restaura el @unique perdido en el refactor
  cobroVehiculo Boolean @default(false) @map("cobro_vehiculo") // feature 24: cobro extra por vehiculo en esta zona
  esCentral     Boolean @default(false) @map("es_central") // feature 54: flag de zona central (renombrado del viejo es_gam); a lo sumo una via indice unico parcial

  ordenes              Orden[]
  tarifaZonaMensajeros TarifaZonaMensajero[]
  tarifas              Tarifa[]              @relation("TarifaZona") // tarifas ACOTADAS a esta zona (zona_id nullable)
  distritos            ZonaDistrito[] // feature 24: relacion N:M con distrito
  usuarios             Usuario[] // feature 54: lado opuesto de Usuario.zona (mensajero/adminSatelite)
  cierresDestino       CierreDia[] // feature 37: cierres cuyo destino_zona_id apunta a esta zona
  cierresBodega        CierreBodega[] // feature 40: cierres de bodega de esta zona satelite
  cierreDetalles       CierreDetail[] // feature 69/R6: snapshots que congelaron esta zona
  notificaciones       Notificacion[] // feature 146/F1.4-1: notificaciones ACOTADAS a esta zona (alcance del adminSatelite)
  analyticsDaily       AnalyticsDaily[] // feature 123/R31: filas del rollup diario cuya zona (DE LA ORDEN) es esta

  @@map("zona")
}

model Provincia {
  id     String @id @default(uuid())
  nombre String
  // feature 55 (F1.4-C): `provincia.zona_id` fue ELIMINADO en la DB (la zona ya no
  // cuelga de la provincia; la asignacion vive en distrito.zona_id + N:M ZonaDistrito).

  cantones Canton[]
  ordenes  Orden[]

  @@map("provincia")
}

model Canton {
  id          String @id @default(uuid())
  nombre      String
  provinciaId String @map("provincia_id")

  provincia Provincia  @relation(fields: [provinciaId], references: [id])
  distritos Distrito[]
  ordenes   Orden[]

  @@index([provinciaId])
  @@map("canton")
}

model Distrito {
  id           String   @id @default(uuid())
  nombre       String
  cantonId     String   @map("canton_id")
  // Distrito que no se cobra/despacha como el resto de su zona. OPCIONAL a proposito: `false` =
  // se decidio que no es especial (lo que recibe toda fila que no diga nada, por el default);
  // `null` = nadie lo decidio todavia. Al leerla NO vale `NOT zonaEspecial`: con null eso no es
  // false. Ver la migracion 20260824180000_distrito_zona_especial.
  zonaEspecial Boolean? @default(false) @map("zona_especial")

  canton  Canton         @relation(fields: [cantonId], references: [id])
  ordenes Orden[]
  zonas   ZonaDistrito[] // feature 24: relacion N:M con zona (unica fuente de verdad; la columna escalar zona_id se elimino en 20260713000000)

  @@index([cantonId])
  @@map("distrito")
}

// Feature 24 (redefinida): tabla puente N:M zona <-> distrito. Par (zona, distrito)
// unico. ON DELETE CASCADE en ambas FKs (ver migracion zona_distrito_nm).
model ZonaDistrito {
  id         String @id @default(uuid())
  zonaId     String @map("zona_id")
  distritoId String @map("distrito_id")

  zona     Zona     @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  distrito Distrito @relation(fields: [distritoId], references: [id], onDelete: Cascade)

  @@unique([zonaId, distritoId])
  @@index([zonaId])
  @@index([distritoId])
  @@map("zona_distrito")
}

// Orden de negocio (R7-R14a). Borrado logico via deleted_at (soft delete).
model Orden {
  id                     String    @id @default(uuid())
  numGuia                Int?      @unique @map("num_guia") // feature 17/R1: nullable, sin default; asignado en "Generar guia" via nextval(orden_num_guia_seq)
  numRemision            String    @map("num_remision") // R9/R14: lo provee el usuario. SIN @unique global: la unicidad es POR TIENDA y solo entre ordenes VIVAS (indice PARCIAL a mano, ver el bloque de la feature 294 abajo)
  estatusId              String    @map("estatus_id") // R10: FK not null
  destinatario           String
  telefonoDest           String    @map("telefono_dest")
  tiendaId               String    @map("tienda_id") // R11: FK -> usuario, not null
  zonaId                 String    @map("zona_id") // R12: NOT NULL
  provinciaId            String    @map("provincia_id") // R12: NOT NULL
  cantonId               String    @map("canton_id") // R12: NOT NULL
  distritoId             String?   @map("distrito_id") // R12: nullable (unico FK nullable)
  producto               String
  peso                   Decimal?  @db.Decimal(10, 3) // feature 15/R4: nullable (carga masiva sin peso)
  notas                  String? // R14a: texto nullable
  direccion              String? // feature 15/R1: nuevo, carga masiva
  montoCobrar            Decimal?  @map("monto_cobrar") @db.Decimal(12, 2) // feature 15/R1
  mensajeroAsignadoId    String?   @map("mensajero_asignado_id") // feature 17/R7: mensajero ASIGNADO (decision del maestro); feature 159: unica fuente de verdad del mensajero de una orden
  asignadoAt             DateTime? @map("asignado_at") // feature 76/R23/R24: instante de la ultima (re)asignacion de mensajero (NULL = nunca asignado / historicas). OJO: desde la 246/D7 ya NO es la fuente unica del denominador del ranking — solo la RAMA DE RESPALDO, para las ordenes sin `fecha_reparto`
  // Feature 246 (D1+D2, firmadas el 2026-08-20) — DIA DE REPARTO: la fecha calendario de Costa Rica
  // PARA LA QUE se hizo la asignacion. `@db.Date` (no `timestamp`): es una fecha, no un instante, y
  // se compara contra la medianoche UTC de la fecha CR (`startOfDayCR`, convencion 46). Una FECHA
  // ABSOLUTA y no una marca «para mañana» porque una fecha VENCE SOLA —el corte la deja de proteger
  // por el mero paso del tiempo— mientras que una marca necesita quien la apague, y el dia que ese
  // apagado falle la orden no se barre NUNCA: el defecto exacto que pago la 235 tres lineas mas
  // abajo. NULL significa UNA sola cosa: «no esta reservada para un dia que aun no ha llegado»
  // (R20) — orden anterior a esta feature, o sin mensajero. Sin default y sin backfill (R19).
  fechaReparto           DateTime? @map("fecha_reparto") @db.Date
  cobraComision          Boolean   @default(true) @map("cobra_comision") // feature 42/R26: la orden lleva cobro de comision COD (default true = retro-compatible); la 42 la LEE (no la captura editable, deuda A5)
  prioridad              Boolean   @default(false) @map("prioridad") // feature 101/R1: flag de reasignacion prioritaria (ON al liberar por SLA 99, OFF al reasignar mensajero desde bodega); default false = sin backfill (R11)
  // Feature 235 (T6.1, R40, 2026-08-19): aqui vivia la columna booleana de la SOLICITUD DE AYUDA.
  // Se RETIRA y la sustituye un estatus propio (`ayuda_tienda`), porque una marca persistida tiene
  // tantos sitios de limpieza como transiciones tenga el estado que acompana y ninguno rompe el
  // build cuando se olvida: ya produjo la fuga permanente de /novedades y una segunda puerta en la
  // ventana de escritura del hilo. La guardia `ayuda-columna-retirada` impide que vuelva.
  intentosContacto       Int       @default(0) @map("intentos_contacto") // conteo de intentos de contacto que la TIENDA registra sobre la orden desde /novedades; default 0 = sin backfill. Es CUMULATIVO y sobrevive a que la solicitud de ayuda se retire: es historial de gestion de la tienda, no estado de la solicitud
  liberadaReprogramadaAt DateTime? @map("liberada_reprogramada_at") // feature 46/R13/R18: instante de liberacion programada (NULL = nunca liberada por reprogramacion); auditoria + fuente del aviso derivado
  // Feature 91 (design §1.1, R1): resultado de la geocodificacion de `direccion`. TODAS
  // nullable: una orden sin geocodificar las tiene vacias. `geocode_precision` y
  // `geocode_status` son String? y NO enums nativos a proposito: son vocabulario OPACO del
  // proveedor (OK / ZERO_RESULTS / ROOFTOP / APPROXIMATE / ...), ampliable por Google sin
  // avisar; un enum obligaria a un ALTER TYPE por cada valor nuevo. Sin indice: no hay
  // consumidor todavia (design §1.1).
  latitud                Decimal?  @db.Decimal(10, 7)
  longitud               Decimal?  @db.Decimal(10, 7)
  geocodedAt             DateTime? @map("geocoded_at")
  geocodePrecision       String?   @map("geocode_precision")
  geocodeStatus          String?   @map("geocode_status")
  // Feature 141 (R4/R5/D1/D7): lote de carga masiva del que nacio esta orden. NULL = orden
  // sin lote (alta manual o historica anterior a la feature; sin backfill, R11).
  // `downloadUrl` = URL del PDF INDIVIDUAL de ESTA orden (via API key, modo `individual`,
  // R48); NULL en modo `consolidate`, en la via sesion (R40) y sin etiqueta imprimible (R49).
  cargaId                String?   @map("carga_id")
  downloadUrl            String?   @map("download_url")
  // Feature 177 (R36/R37, design §2.2): RUTA del objeto dentro del bucket de etiquetas del
  // PDF individual de esta orden. Columna APARTE de `downloadUrl` a proposito: aquella
  // guarda una URL FIRMADA que caduca, asi que no sirve para saber si el PDF existe.
  // NOT NULL <=> el PDF existe en Storage => solo re-firmar; NULL => generar y subir.
  // `downloadUrl` no se lee ni se escribe en esta feature (R26/R38).
  downloadStoragePath    String?   @map("download_storage_path")
  /// Feature 169 (design §2.5) — columna GENERADA ALWAYS ... STORED en la base: concatena
  /// los campos buscables ya normalizados (guia, remision, telefono con y sin
  /// separadores, destinatario y —desde `20260808120000_orden_busqueda_producto`—
  /// producto). NUNCA se escribe desde la aplicacion — Postgres rechaza
  /// cualquier INSERT/UPDATE sobre ella— y el cliente la OMITE globalmente
  /// (`lib/db/prisma-client.ts`) para que no llegue a ningun DTO ni descarga (R28).
  /// Se declara aqui para (a) poder filtrar con Prisma y (b) que schema.prisma no diverja
  /// del SQL aplicado: si no estuviera, la siguiente migracion que alguien generase
  /// propondria un DROP COLUMN fantasma. Prisma no tiene representacion de columnas
  /// generadas, asi que la ve como un `text` nullable normal: por eso `String?`.
  ///
  /// `@default(dbgenerated())` NO es decorativo y se llego a el MIDIENDO (T1.5): sin el,
  /// Prisma lee la expresion GENERATED como si fuera un DEFAULT de columna y cada
  /// `migrate dev` futuro propone `ALTER COLUMN "busqueda_texto" DROP DEFAULT` — una
  /// sentencia que, aplicada, no puede aplicarse (no hay default que quitar) y que solo
  /// existe porque el modelo callaba. Con el, el diff sale VACIO.
  busquedaTexto          String?   @default(dbgenerated()) @map("busqueda_texto")
  deletedAt              DateTime? @map("deleted_at") // soft delete
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  estatus           OrderStatus @relation(fields: [estatusId], references: [id])
  tienda            Usuario     @relation("OrdenTienda", fields: [tiendaId], references: [id])
  zona              Zona        @relation(fields: [zonaId], references: [id])
  provincia         Provincia   @relation(fields: [provinciaId], references: [id])
  canton            Canton      @relation(fields: [cantonId], references: [id])
  distrito          Distrito?   @relation(fields: [distritoId], references: [id])
  mensajeroAsignado Usuario?    @relation("OrdenMensajeroAsignado", fields: [mensajeroAsignadoId], references: [id], onDelete: SetNull) // feature 17/R7
  carga             Carga?      @relation("OrdenCarga", fields: [cargaId], references: [id], onDelete: Restrict) // feature 141/R4: un lote con ordenes no se puede borrar

  gestiones             GestionOrden[] // feature 36: gestiones registradas sobre esta orden
  mensajerosGestionando Usuario[]               @relation("UsuarioOrdenEnGestion") // feature 36: lado inverso del puntero de bloqueo 1-a-1
  historialEstados      OrdenHistorialEstado[] // feature 49: linea de tiempo append-only de transiciones (R1/R5)
  cierreDetalles        CierreDetail[] // feature 69/R1: snapshots congelados de esta orden (uno por cierre en que aparecio)
  cierresSinGestion     CierreSinGestion[] // feature 264/R1: cierres en cuyo corte esta orden fue barrida a `sin_gestionar`
  rutaParadas           RutaOptimizadaParada[] // feature 92/R26: posicion de esta orden en la ruta optimizada de su mensajero
  mensajeroMetas        OrdenMensajeroMeta[]    @relation("OrdenMensajeroMetaOrden") // feature 115: marcas privadas por mensajero sobre esta orden
  chatConversaciones    ChatConversacion[] // feature 120/R13: hilos de chat colgados de esta orden
  incidentesAdmin       OrdenIncidente[] // feature 158/R38: incidentes reportados por un ADMIN sobre esta orden (a lo sumo UNO vivo, indice parcial R47)
  // NO se llama `notas`: ese nombre ya lo ocupa la nota de la TIENDA (`orden.notas`, R14a),
  // que esta feature NO toca (R25). Son dos cosas distintas y el nombre lo dice.
  notasHilo             OrdenNota[]             @relation("OrdenNotaOrden") // feature 227/R30: hilo de notas tienda<->mensajero de esta orden; la FK es CASCADE (borrar la orden se lleva su hilo)
  diaRepartoCambios     OrdenDiaRepartoCambio[] @relation("OrdenDiaRepartoCambioOrden") // feature 262/R20-R23: rastro append-only de las correcciones del dia de reparto de esta orden
  habilitacionesApi     OrdenHabilitacionApi[]  @relation("OrdenHabilitacionApiOrden") // feature 266/R23-R24: bitacora append-only de las habilitaciones pedidas por el canal por API key sobre esta orden; la FK es CASCADE (borrar la orden se lleva su bitacora)

  // UNICIDAD DE `num_remision`: POR TIENDA, NO GLOBAL (migracion 20260825160000).
  //
  // Hasta hoy `num_remision` era `@unique` GLOBAL. Ese numero NO lo genera Ordenex: lo trae la
  // tienda desde su propio sistema (R9/R14), y dos tiendas distintas no se coordinan entre si
  // para numerar sus remisiones. Con el UNIQUE global, la PRIMERA tienda que cargaba "1001" le
  // quemaba ese numero a TODAS las demas: la segunda veia su fila clasificada como `duplicada`
  // por un dato que ni siquiera es suyo, y ademas podia INFERIR que alguien mas ya lo uso (fuga
  // entre inquilinos). La identidad real de una remision es el par (tienda, numero).
  //
  // `tiendaId` va PRIMERO a proposito: el btree resultante sirve como prefijo a todo lo que ya
  // filtra por tienda, y `@@index([tiendaId])` se mantiene solo porque otras rutas lo usan sin
  // remision (el planner puede servirlas con este, pero no se retira en la misma migracion que
  // cambia la constraint: un cambio a la vez).
  //
  // FEATURE 294 (2026-08-27) — LA RESTRICCION YA NO SE DECLARA AQUI, Y NO ES UN OLVIDO.
  //
  // El indice sigue existiendo, con el mismo nombre `orden_tienda_id_num_remision_key`, pero
  // desde `20260827160000_orden_num_remision_unico_parcial` es **PARCIAL**:
  //
  //   CREATE UNIQUE INDEX "orden_tienda_id_num_remision_key"
  //     ON "orden"("tienda_id", "num_remision") WHERE "deleted_at" IS NULL;
  //
  // POR QUE PARCIAL. Hasta esa migracion, una orden BORRADA seguia ocupando su numero, pero
  // `findExistingRemisiones` validaba el duplicado con `deleted_at IS NULL`: la fila pasaba la
  // validacion y despues `createMany({ skipDuplicates })` la descartaba SIN error. Medido en
  // produccion con una tienda bloqueada (ficha 294): tres ordenes "cargadas" que no existian, y
  // ni siquiera una fila de `carga`. El predicado hace que la base diga lo mismo que el codigo
  // ya comprobaba: UNA remision VIVA por tienda.
  //
  // POR QUE NO ESTA EN EL MODELO, con lo MEDIDO (2026-08-27, base local ya migrada). Prisma
  // **no expresa indices parciales**, y con el `@@unique` puesto:
  //   * `migrate diff --from-config-datasource --to-schema` sale vacio igual — la
  //     introspeccion no lee el predicado, asi que el riesgo NO es que proponga recrearlo;
  //   * `migrate diff --from-empty --to-schema` (el render del datamodel, o sea `db push`) SI
  //     escribe el indice **sin** el `WHERE`;
  //   * y el cliente generado ofrece `tiendaId_numRemision` en `OrdenWhereUniqueInput`, o sea
  //     un `findUnique`/`upsert` por un par que la base ya no garantiza unico (puede haber N
  //     borradas con ese par). Esa es la razon de peso: el ORM invitando al mismo fallo mudo.
  // Mismo patron que `zona_es_gam_unico` (20260711120000), `jobs_dedupe_key_key`
  // (20260717120000) y los unicos parciales de la 293. Lo vigila
  // `tests/unit/db/orden-num-remision-parcial.test.ts`.
  //
  // `@@index([tiendaId])` se mantiene: el parcial ya no sirve de prefijo a las consultas que
  // filtran por tienda SIN mirar `deleted_at`.
  @@index([tiendaId])
  @@index([estatusId])
  @@index([createdAt])
  @@index([mensajeroAsignadoId]) // feature 17/R7
  // Feature 76/R1 + FEATURE 246 (D7) — EL INDICE DEL DENOMINADOR DEL RANKING, AMPLIADO A TRES.
  //
  // Era `(mensajeroAsignadoId, asignadoAt)`. El `EXPLAIN` de produccion (M8) mostro que la consulta
  // de HOY se sirve con un `Index Only Scan` sobre el —el mejor plan posible, sin tocar el heap— y
  // que el `OR` del denominador nuevo lo ROMPIA, porque `fechaReparto` no estaba dentro. Un indice
  // suelto por `fechaReparto` NO lo arregla: lo empeora (hace atractivo un `BitmapOr` que degrada a
  // `Bitmap Heap Scan`). Con la fecha como TERCERA COLUMNA CLAVE, el plan vuelve a ser `Index Only
  // Scan` y el PREFIJO de dos columnas sigue sirviendo a quien lo usaba (`TableroDiaRepository`,
  // la 76) — medido, no supuesto. El numero de indices de `orden` NO sube: se sustituye uno.
  //
  // Lo que ningun indice arregla y se declara como coste de D7: con el `OR`, el `Index Cond` se
  // reduce a `mensajeroAsignadoId IS NOT NULL` y se pierde el acotado por rango de `asignadoAt`
  // (un btree no expresa una disyuncion entre dos columnas como un rango). Sigue sin tocar el heap,
  // pero recorre el indice entero. Ver `design.md` §2.1.
  @@index([mensajeroAsignadoId, asignadoAt, fechaReparto], map: "orden_mensajero_asignado_at_fecha_reparto_idx")
  // Feature 144/B5: filtros de zona y geografia del listado (`IN (...)` en ruta caliente:
  // findMany + count por cada cambio de filtro). `createdAt` ya esta indexado arriba.
  @@index([zonaId])
  @@index([provinciaId])
  @@index([cantonId])
  @@index([distritoId])
  @@index([cargaId]) // feature 141/R4: "ordenes de este lote"
  // Feature 169: indice GIN de trigramas del buscador. `map:` reproduce el nombre exacto
  // que la migracion escribio a mano (si no, Prisma propondria un RENAME INDEX, misma
  // clase de drift que documenta schema-drift-saneamiento.test.ts). El opclass va SIN
  // cualificar (`gin_trgm_ops`) porque eso es lo que Prisma lee de `pg_opclass`, que
  // guarda nombre y esquema por separado: cualificarlo aqui reintroduce drift. El SQL
  // aplicado SI lo cualifica (`extensions.gin_trgm_ops`), que es lo que importa para que
  // la creacion no dependa del `search_path`.
  @@index([busquedaTexto(ops: raw("gin_trgm_ops"))], type: Gin, map: "orden_busqueda_texto_trgm_idx")
  @@map("orden")
}

// Feature 141 — LOTE de carga masiva. Una fila por carga masiva efectiva (>=1 orden
// persistida), tanto por sesion (UI /ordenes, XLSX en chunks) como por API key. El alta
// manual de UNA orden NO crea lote (R37). Sin `status` (D3) y sin `batch_url` (D2). RLS
// habilitada sin policies: la autorizacion vive en el service (patron orden_mensajero_meta /
// plantilla_mensaje). `id` lo genera SIEMPRE el SERVIDOR dentro de la tx (R15/D8): el cliente
// nunca lo propone. `name` es el UNICO campo definido por el usuario (D9).
model Carga {
  id                  String   @id @default(uuid())
  fechaCarga          DateTime @default(now()) @map("fecha_carga")
  usuarioCarga        String   @map("usuario_carga") // FK -> usuario: quien realizo la carga (R2)
  name                String? // R8: nombre OPCIONAL del lote definido por el usuario; NULL = sin nombre
  downloadUrl         String?  @map("download_url") // R47: URL del PDF CONSOLIDADO del lote (modo consolidate); NULL en la via sesion (R40)
  // Feature 177 (R36/R37, design §2.2): RUTA del objeto del PDF CONSOLIDADO del lote en el
  // bucket de etiquetas. Misma semantica que en `Orden`: NOT NULL <=> existe => re-firmar.
  downloadStoragePath String?  @map("download_storage_path")
  totalFiles          Int      @default(0) @map("total_files") // R7/R29/R32: tamano TOTAL del lote, nunca el del chunk/batch
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation("CargaUsuario", fields: [usuarioCarga], references: [id], onDelete: Restrict)
  ordenes Orden[] @relation("OrdenCarga")

  @@unique([usuarioCarga, name]) // R9/R10: unicidad del nombre POR USUARIO (los NULL conviven)
  @@index([usuarioCarga])
  @@index([fechaCarga])
  @@map("carga")
}

// Feature 115 — meta PRIVADA por (mensajero, orden). `marcar_luego` (115) = "gestionar
// mas tarde", solo informativa (no cambia estatus ni ruta). UNIQUE(usuario_id, orden_id):
// una fila por pareja -> idempotencia del toggle (upsert). Ambas FK ON DELETE
// CASCADE: la meta es dato derivado, se va con el mensajero o la orden. RLS habilitada sin
// policies (patron api_key/plantilla_mensaje); la autorizacion de negocio vive en el service.
//
// Feature 227 (R23): aqui vivia `nota text NULL`, la nota PRIVADA del mensajero (feature
// 116). La columna se RETIRO con la migracion `*_orden_mensajero_meta_drop_nota` y su
// contenido se perdio de forma DEFINITIVA y DELIBERADA (decision humana del 2026-08-14,
// P1: se escribio bajo una promesa literal de privacidad, asi que copiarla al hilo
// compartido habria sido una fuga retroactiva). La conversacion entre tienda y mensajero
// vive ahora en `OrdenNota`. `marcar_luego`, el UNIQUE, las FK y la RLS NO se tocaron (R24).
model OrdenMensajeroMeta {
  id          String   @id @default(uuid())
  usuarioId   String   @map("usuario_id")
  ordenId     String   @map("orden_id")
  marcarLuego Boolean  @default(false) @map("marcar_luego") // feature 115
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation("OrdenMensajeroMetaMensajero", fields: [usuarioId], references: [id], onDelete: Cascade)
  orden   Orden   @relation("OrdenMensajeroMetaOrden", fields: [ordenId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, ordenId]) // R1/R7: una fila por (mensajero, orden)
  @@index([usuarioId]) // R17: leer todas las metas del mensajero al listar
  @@index([ordenId])
  @@map("orden_mensajero_meta")
}

// Feature 227 (design §1.1) — HILO de notas por orden entre la tienda (adminTienda dueno)
// y el mensajero ASIGNADO. Tabla NUEVA y no una reutilizacion de `orden_mensajero_meta`:
// aquella declara UNIQUE(usuario_id, orden_id) —una fila por pareja, de la que depende la
// idempotencia del toggle `marcar_luego` (feature 115/R7)— y un hilo necesita N filas por
// orden.
//
// SIN `updated_at` a proposito (R2): el cuerpo de una nota publicada NO se edita. Lo unico
// que muta en una fila es `deleted_at`, una vez y en un solo sentido (borrado LOGICO, R31:
// la fila borrada sigue probando que ALGUIEN escribio algo y cuando, que es la mitad del
// valor del hilo en una disputa tienda<->mensajero).
//
// `rol_autor` es COLUMNA y no un JOIN a `usuario.rol` (R4): el rol de un usuario puede
// cambiar y el hilo debe decir con que sombrero se escribio cada nota, no reescribir la
// historia.
//
// FK a `orden` ON DELETE CASCADE (R30: sin filas huerfanas); FK a `usuario` ON DELETE
// RESTRICT: la autoria es evidencia y no se pierde al dar de baja un usuario. RLS
// habilitada SIN policies (patron orden_mensajero_meta/plantilla_mensaje): toda la
// autorizacion de negocio (rol, tienda, asignacion, ventana de escritura) vive en el
// service (R26).
model OrdenNota {
  id        String    @id @default(uuid())
  ordenId   String    @map("orden_id")
  autorId   String    @map("autor_id")
  rolAutor  RolValue  @map("rol_autor") // R4: congelado en el instante de publicar
  cuerpo    String // NOT NULL; recorte y tope de 200 caracteres en el borde (R6/R7)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at") // R31: borrado LOGICO; NULL = vigente

  orden Orden   @relation("OrdenNotaOrden", fields: [ordenId], references: [id], onDelete: Cascade)
  autor Usuario @relation("OrdenNotaAutor", fields: [autorId], references: [id], onDelete: Restrict)

  @@index([ordenId, createdAt]) // R3/R28: hilo ordenado en UNA sola consulta (forma del indice de ChatMensaje)
  @@index([autorId]) // segunda FK indexada (patron orden_mensajero_meta)
  @@map("orden_nota")
}

// Feature 266 (T1.2, design §2.2): BITACORA de las habilitaciones pedidas por el canal por API
// key, comun a las DOS ramas del endpoint (R23). Fila APPEND-ONLY (R24): SIN updatedAt ni
// deletedAt, y sin ningun metodo de actualizacion o borrado en su repositorio — una segunda
// habilitacion de la misma orden con otra nota es un HECHO NUEVO, no una correccion. Mismo
// criterio que OrdenHistorialEstado.
//
// ⚠️ NACE SIN LECTOR y se ACEPTA (D4, firmada 2026-08-23): es auditoria, ninguna superficie la
// consulta, y exponerla es ficha aparte. Declarado en voz alta por el precedente de la 270.
//
// RLS habilitada sin policies (solo service role), patron OrdenNota/OrdenHistorialEstado/
// GestionOrden: la unica puerta —la orden tiene que ser del owner de la key— vive en el service.
model OrdenHabilitacionApi {
  id               String   @id @default(uuid())
  ordenId          String   @map("orden_id")
  /// El usuario dedicado de la API key (`actor.usuarioId`), que es TAMBIEN el `tiendaId` de sus ordenes (R3).
  actorUsuarioId   String   @map("actor_usuario_id")
  /// Obligatoria: recorte y tope de 200 caracteres en el borde (R7), el mismo de `OrdenNota.cuerpo`.
  nota             String
  /// ESCRITO y no derivado del par de estados: `true` = rama A (volvio a `en_reparto`), `false` = rama B (solo log).
  cambioDeEstado   Boolean  @map("cambio_de_estado")
  /// SNAPSHOT del `order_status.value` en el que la orden quedo. TEXT y no FK: si un value se renombra, la bitacora debe seguir diciendo lo que dijo.
  estadoResultante String   @map("estado_resultante")
  createdAt        DateTime @default(now()) @map("created_at")

  orden Orden   @relation("OrdenHabilitacionApiOrden", fields: [ordenId], references: [id], onDelete: Cascade)
  actor Usuario @relation("OrdenHabilitacionApiActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)

  @@index([ordenId, createdAt]) // todas las habilitaciones de una orden, ordenadas, en UNA consulta
  @@index([actorUsuarioId]) // segunda FK indexada (patron orden_nota)
  @@map("orden_habilitacion_api")
}

// Feature 36 (R5, decision F1.4-c): metodo de pago del recaudo al cliente en una
// ENTREGA. Enum Postgres nativo (patron RolValue/VehiculoValue), fuente unica de
// verdad reflejada en lib/types/metodo-pago.ts. OJO 'SINPE' en mayusculas (medio de
// pago de Costa Rica). Feature 118: corregido el typo historico del valor via
// ALTER TYPE ... RENAME VALUE (migracion _metodo_pago_rename_simpe_to_sinpe).
enum MetodoPagoValue {
  efectivo
  SINPE
  transferencia

  @@map("metodo_pago_value")
}

// Feature 36 (R6, decision F1.4-d): discriminador del resultado de una gestion.
enum GestionResultado {
  entregada
  reprogramada
  devuelta
  rechazada
  incidente // feature 158 (R1): paquete danado/perdido/robado. TERMINAL, se indemniza.

  @@map("gestion_resultado")
}

// Feature 158 (R9, decision Q-B del humano del 2026-07-30): causa TIPIFICADA de un
// incidente — lista CERRADA de 3 valores, sin "Otro" y sin reservar futuros (anadir una
// 4.ª causa el dia que se pida es un `ALTER TYPE ... ADD VALUE`, aditivo y barato).
//
// Los valores van en ESPANOL aunque el enum hermano `gestion_causa_devolucion` (73) los
// tenga en INGLES: decision CONSCIENTE del humano cerrada en la puerta F1.4 de la 158
// (design §0.3), a favor de la coherencia con los enums a los que este ACOMPANA
// (`gestion_resultado` y el catalogo `order_status`, los dos en espanol). NO es deuda
// tecnica ni un descuido — no abrir tickets de "consistencia" por esto, en NINGUNA de las
// dos direcciones (ni castellanizar la 73, ni traducir esta al ingles).
enum GestionCausaIncidente {
  danado // paquete danado (hay paquete que fotografiar)
  perdido // paquete extraviado
  robado // paquete sustraido

  @@map("gestion_causa_incidente")
}

// Feature 73 (R1, decision F1.4-d): causa TIPIFICADA de una devolucion — lista CERRADA de 3
// valores, sin "Otro" y sin reservar futuros (anadir una 4.ª causa el dia que se pida es un
// `ALTER TYPE ... ADD VALUE`, aditivo y barato). Los valores van en INGLES aunque el enum
// hermano `gestion_resultado` los tenga en espanol: decision CONSCIENTE del humano aceptada
// en la gate (F1.4-g), NO es deuda tecnica ni un descuido — no abrir tickets de
// "consistencia" por esto. El front traduce (R3, `causa-devolucion-options.ts`).
enum GestionCausaDevolucion {
  not_found // Cliente no localizado
  wrong_number // Numero de celular errado
  wrong_address // Direccion errada

  @@map("gestion_causa_devolucion")
}

// Feature 193 (R5, design §2): por que una gestion NO trae la ubicacion del mensajero —
// lista CERRADA de 4 valores, todos FALLOS TECNICOS.
//
// ⛔ LA DENEGACION DEL PERMISO NO ES UN VALOR DE ESTE ENUM, Y ESA AUSENCIA ES EL MECANISMO
// DE R12, no un olvido. Decision humana del 2026-08-10: denegar la ubicacion BLOQUEA la
// gestion. Al no existir el valor, una gestion denegada no se puede representar y el rechazo
// es ESTRUCTURAL: no depende de que alguien se acuerde de comprobarlo en el borde. Si algun
// dia se decide aceptarla, anadir el valor es el cambio consciente que obliga a revisar R19.
//
// El fallo tecnico SI pasa (R18) porque no hay nada que la persona pueda hacer: sin senal en
// una bodega, el mensajero quedaria trabado sin salida. La denegacion, en cambio, la revierte
// ella misma desde los ajustes del navegador.
enum GestionUbicacionAusencia {
  timeout // la captura agoto el tiempo maximo
  no_disponible // el dispositivo no pudo fijar posicion (sin senal)
  no_soportado // el navegador no expone geolocalizacion
  contexto_inseguro // sin HTTPS: la API no esta disponible

  @@map("gestion_ubicacion_ausencia")
}

// Feature 36 (R6-R8, decision F1.4-d): UN registro por gestion de orden, con un
// discriminador `resultado` y campos NULLABLE segun resultado. La evidencia se
// guarda como `storage_path` de un bucket PRIVADO (nunca URL publica, R8); se
// firma al mostrar. RLS habilitada sin policies (solo service role, patron
// mensajero_documento/orden). Una orden puede acumular varias gestiones a lo
// largo de reintentos (features 46/47): NO se fuerza @@unique(ordenId).
model GestionOrden {
  id                   String                    @id @default(uuid())
  ordenId              String                    @map("orden_id") // FK -> orden
  mensajeroId          String                    @map("mensajero_id") // FK -> usuario (el actor)
  resultado            GestionResultado
  montoRecibido        Decimal?                  @map("monto_recibido") @db.Decimal(12, 2) // ENTREGADA — TOTAL snapshot (feature 212/R5): SOBREVIVE al desglose
  // DEPRECADO por la feature 212 (R5/R19/R31): la fuente de verdad del recaudo pasa a ser
  // `pagos` (0..N lineas metodo+monto). Esta columna se CONSERVA por retro-compat mientras
  // la 213 (captura y presentacion) no aterrice: se escribe con el metodo de la UNICA linea
  // si hay exactamente una, y con NULL si hay cero o dos o mas (R19). Su retiro se decide en
  // la 213/214, NO aqui.
  metodoPago           MetodoPagoValue?          @map("metodo_pago") // ENTREGADA (DEPRECADO, ver 213/214)
  evidenciaStoragePath String?                   @map("evidencia_storage_path") // ENTREGADA/RECHAZO: path bucket privado, NO URL
  evidenciaContentType String?                   @map("evidencia_content_type") // image/jpeg|png|webp
  motivo               String? // REPROGRAMAR/DEVOLUCION/RECHAZO
  fechaReprogramacion  DateTime?                 @map("fecha_reprogramacion") @db.Date // REPROGRAMAR
  // Feature 73/R11 (F1.4-a): DEVOLUCION. NULLABLE como el resto de campos por rama: NULL =
  // gestion no-`devuelta`, o `devuelta` anterior a la feature 73 (el historico NO se
  // backfillea, R16). La obligatoriedad vive en el BORDE (zod, R6), sin CHECK en la base
  // (F1.4-b), igual que monto_recibido/metodo_pago/evidencia de la 36.
  // OJO (F1.4-c): esta columna nace de SOLO ESCRITURA por decision APROBADA del humano —
  // nadie la lee en este ciclo. Que no tenga consumidores NO es codigo muerto ni un olvido:
  // es el estado esperado. Mostrarla/agruparla es follow-up (ver requirements.md §F1.4-c).
  causaDevolucion      GestionCausaDevolucion?   @map("causa_devolucion") // DEVOLUCION
  // Feature 158/R9 (Q-B): causa tipificada del INCIDENTE. NULLABLE como el resto de campos
  // por rama: NULL = gestion no-`incidente`. La obligatoriedad vive en el BORDE (zod, R9),
  // sin CHECK en la base, igual que `causa_devolucion` (73/F1.4-b).
  causaIncidente       GestionCausaIncidente?    @map("causa_incidente") // INCIDENTE
  // Feature 158/R19-R22 (Q-C): monto de la indemnizacion CAPTURADO POR EL ADMIN al aprobar
  // el cierre. NULL = gestion no-`incidente`, o `incidente` cuyo cierre aun no se aprobo.
  // Mismo patron snapshot-escrito-despues que `pago_mensajero` (39) e
  // `ingreso_bodega_rechazo` (56). NO vive en `cierre_detail`: esa tabla es un snapshot
  // INMUTABLE escrito solo al SOLICITAR (design §3.3 / §9.1).
  indemnizacion        Decimal?                  @map("indemnizacion") @db.Decimal(12, 2)
  cierreId             String?                   @map("cierre_id") // feature 37/R13: nullable; NULL = gestion del dia aun no cerrada
  pagoMensajero        Decimal?                  @map("pago_mensajero") @db.Decimal(12, 2) // feature 39/R12: snapshot del pago al mensajero; NULL mientras no se cierra
  ingresoBodegaRechazo Decimal?                  @map("ingreso_bodega_rechazo") @db.Decimal(12, 2) // feature 56/R11: snapshot del ingreso de bodega por rechazo; NULL mientras no se cierra
  // Feature 193 (R1/R2/R4): DONDE estaba el mensajero al registrar la gestion, sea cual sea
  // el resultado. NULLABLE como el resto de campos por rama, y por dos motivos mas:
  // (a) las gestiones anteriores a esta feature quedan en NULL y NO se backfillean (R3) —no
  // hay coordenada cierta que inventar—; (b) una gestion con fallo tecnico de captura se
  // guarda sin coords y con `ubicacionAusencia` (R18). La obligatoriedad vive en el BORDE
  // (zod, R8-R13), SIN CHECK en la base: mismo patron que monto_recibido/metodo_pago (36),
  // causa_devolucion (73/F1.4-b) y causa_incidente (158).
  //
  // Decimal(10,7) —no Float— es el tipo de la geolocalizacion PROPIA en este repo:
  // geocode_cache.latitud y ruta_optimizada.origen_lat. La 121 uso Float para las coords de
  // WhatsApp, pero eso es un payload AJENO que se copia tal cual; aqui 7 decimales (~1 cm)
  // sin error de representacion binaria, en un dato que puede acabar en una disputa laboral.
  //
  // OJO: nacen de SOLO ESCRITURA por decision humana (R7) — ningun repositorio de lectura las
  // proyecta en este ciclo, y hay una guardia que lo atornilla. Que no tengan consumidores NO
  // es codigo muerto: es el estado esperado (mismo patron declarado para causa_devolucion).
  ubicacionLat         Decimal?                  @map("ubicacion_lat") @db.Decimal(10, 7)
  ubicacionLng         Decimal?                  @map("ubicacion_lng") @db.Decimal(10, 7)
  // R6: las tres columnas admiten DOS formas validas, (lat,lng,NULL) o (NULL,NULL,motivo).
  // Media coordenada no es una ubicacion.
  ubicacionAusencia    GestionUbicacionAusencia? @map("ubicacion_ausencia")
  // Feature 238 (R17/R20/R21): instante en que BODEGA confirmo tener el PAQUETE delante, escrito
  // DENTRO de la transaccion de aprobacion del cierre y solo sobre las gestiones cuyo paquete
  // vuelve (`devuelta`/`rechazada`/`reprogramada`). NULL = gestion que no vuelve a bodega, o
  // gestion de un cierre aprobado ANTES de esta feature (el historico NO se backfillea, R20).
  // Mismo patron snapshot-escrito-despues que `indemnizacion` (158), `pago_mensajero` (39) e
  // `ingreso_bodega_rechazo` (56).
  //
  // NO ES UN RELOJ (R21): coincide con `cierre_dia.resuelto_at` de la misma transaccion y NADA
  // deriva de aqui plazos, vencimientos ni importes. Nace SIN LECTORES a proposito y hay una
  // guardia que lo mantiene asi (`confirmacion-sin-lectores.guardia.test.ts`).
  confirmadaFisicaAt   DateTime?                 @map("confirmada_fisica_at")
  anuladaAt            DateTime?                 @map("anulada_at") // feature 67/R11: instante de la anulacion; NULL = gestion VIGENTE (patron cierre_id IS NULL de la 37)
  anuladaPor           String?                   @map("anulada_por") // feature 67/R11: FK -> usuario que la deshizo (espejo de cierre_dia.resuelto_por)
  // Pedido humano (2026-08-19): rastro de la CORRECCION del desglose de pago por un
  // admin/maestro desde el detalle de un cierre ABIERTO. NULL = el reparto sigue siendo el que
  // registro el mensajero (el estado de todas las filas anteriores). Mismo patron que el par
  // `anulada_at`/`anulada_por` de arriba: quien declaro el reparto fue el mensajero y ese
  // reparto es la `E` del `min(P, E)` con el que se le paga (44), asi que reescribirlo sin
  // decir quien ni cuando convierte una correccion en una discrepancia sin autor.
  pagosEditadosAt      DateTime?                 @map("pagos_editados_at")
  pagosEditadosPor     String?                   @map("pagos_editados_por")
  createdAt            DateTime                  @default(now()) @map("created_at")

  orden                   Orden                   @relation(fields: [ordenId], references: [id])
  mensajero               Usuario                 @relation("GestionMensajero", fields: [mensajeroId], references: [id])
  cierre                  CierreDia?              @relation(fields: [cierreId], references: [id]) // feature 37/R13: cierre que agrupa esta gestion
  // Feature 67/R11: quien deshizo la gestion. ON DELETE SET NULL como el actor del historial
  // (49/R21): borrar al usuario no borra el rastro de la anulacion.
  anuladaPorUsuario       Usuario?                @relation("GestionAnuladaPor", fields: [anuladaPor], references: [id], onDelete: SetNull)
  // SetNull como el actor de la anulacion (67) y el del historial (49): borrar al usuario no
  // borra el rastro de que la correccion ocurrio.
  pagosEditadosPorUsuario Usuario?                @relation("GestionPagosEditadosPor", fields: [pagosEditadosPor], references: [id], onDelete: SetNull)
  historialEstados        OrdenHistorialEstado[] // feature 49: transiciones de estado causadas por esta gestion (familia gestion)
  // Feature 119 (R1): evidencias 1..N de esta gestion (la portada = indice 0 se conserva
  // ademas denormalizada en evidencia_storage_path/_content_type por retro-compat, R12).
  evidencias              GestionOrdenEvidencia[]
  // Feature 212 (R1): desglose del recaudo al cliente, 0..N lineas (metodo, monto).
  // `monto_recibido` se conserva como TOTAL snapshot (R5).
  pagos                   GestionOrdenPago[]

  @@index([ordenId]) // R7
  @@index([mensajeroId]) // R7
  @@index([cierreId]) // feature 37/R3: listar gestiones sin cierre (cierre_id IS NULL)
  @@index([anuladaPor]) // feature 67: FK del actor de la anulacion
  @@index([pagosEditadosPor]) // FK del actor de la correccion del desglose
  // Feature 126/R25 (T0-Q1 = B): la ruta caliente INTRADIA (cubos del dia en curso, D6/D13)
  // filtra por `created_at` SIN `orden_id` ni `mensajero_id` por delante, y ninguno de los
  // cuatro indices de arriba la cubre. Se DECLARA aqui, y no solo en el `.sql`: si el
  // datamodel no lo declara, el siguiente `prisma migrate dev` propone BORRARLO. Columna
  // unica a proposito — `anulada_at` detras de un predicado de RANGO no filtraria, y el
  // parcial `(created_at) WHERE anulada_at IS NULL` no es expresable en Prisma (misma
  // limitacion que documenta el bloque de abajo).
  @@index([createdAt], map: "gestion_orden_created_at_idx")
  // Feature 67 (F1.4-d): el indice PARCIAL de la ruta caliente
  // `(mensajero_id) WHERE cierre_id IS NULL AND anulada_at IS NULL` (/cierre-dia + corte
  // diario) NO se expresa aqui: Prisma no soporta indices parciales -> vive en el SQL de la
  // migracion `*_gestion_orden_anulacion` (patron orden_liberada_reprogramada_at_idx).
  @@map("gestion_orden")
}

// Feature 119 (R1/R2/R4): evidencias 1..N de una gestion. Reemplaza la foto UNICA de
// gestion_orden.evidencia_storage_path/_content_type como fuente de verdad del CONJUNTO;
// el path unico se conserva como PORTADA (indice 0) por retro-compat (design §2), via
// dual-write en la misma transaccion. RLS habilitada sin policies (solo service role,
// patron gestion_orden).
model GestionOrdenEvidencia {
  id          String   @id @default(uuid())
  gestionId   String   @map("gestion_id")
  storagePath String   @map("storage_path") // path bucket privado, NO URL
  contentType String   @map("content_type") // image/jpeg|png|webp
  indice      Int // 0-based, orden de captura; 0 = portada
  createdAt   DateTime @default(now()) @map("created_at")

  gestion GestionOrden @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  @@unique([gestionId, indice]) // R2: no dos filas con el mismo indice por gestion
  @@index([gestionId]) // lectura de las evidencias de una gestion
  @@map("gestion_orden_evidencia")
}

// Feature 212 (R1-R4): DESGLOSE del recaudo al cliente de UNA entrega. 0..N lineas
// (metodo, monto). `gestion_orden.monto_recibido` SOBREVIVE como TOTAL snapshot
// (money-critical, patron 39/56); la invariante SUM(monto) = monto_recibido vive en el
// BORDE (zod + revalidacion Decimal en el service), SIN CHECK en la base (patron 36/F1.4-b).
// RLS habilitada sin policies (solo service role, patron gestion_orden/gestion_orden_evidencia).
model GestionOrdenPago {
  id        String          @id @default(uuid())
  gestionId String          @map("gestion_id")
  metodo    MetodoPagoValue // enum NATIVO conservado, NO tabla-catalogo
  monto     Decimal         @db.Decimal(12, 2) // misma escala que monto_recibido
  createdAt DateTime        @default(now()) @map("created_at")

  gestion GestionOrden @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  @@unique([gestionId, metodo]) // D2/R2: un metodo, como mucho una vez, con su monto ya sumado
  @@index([gestionId]) // R1: lectura de las lineas de una gestion
  @@map("gestion_orden_pago")
}

// Feature 158 (R38/R39, camino del ADMIN) — incidente reportado por un ADMIN sobre una orden que
// NO esta en manos de un mensajero (bodega o transito interno).
//
// ⚠️ NO es —y NO puede ser— una fila de `gestion_orden`, y esto NO es preferencia de estilo
// (design §9.7/§12.1): `gestion_orden.mensajero_id` es NOT NULL, asi que el admin tendria que
// escribirse ahi, y `CorteDiarioRepository.findMensajerosConActividadSinCierre` consulta
// `{ cierreId: null, anuladaAt: null }` con `distinct: ["mensajeroId"]` SIN filtrar rol ni
// resultado -> el corte diario le crearia al ADMIN un `cierre_dia` `vencido` BLOQUEANTE que el
// NO puede resolver, porque `CierreDiaService` esta acotado por rol al `mensajero`. Es un bug
// reproducible y money-adjacent. NO "simplificar" esto fundiendolo con `gestion_orden`.
//
// REUSA `CierreEstado` (37) como TERCERA aplicacion del patron de aprobacion (38 -> `cierre_dia`,
// 40 -> `cierre_bodega`), igual que la 40 reuso el enum en su decision F1.4-b. El valor `vencido`
// NO aplica aqui, exactamente como no aplica en `cierre_bodega`. Y REUSA
// `GestionCausaIncidente`: la causa es la MISMA lista cerrada de 3 valores del camino del
// mensajero (R45 remite a R9).
//
// Indice unico PARCIAL `(orden_id) WHERE estado <> 'rechazado'` (R47) + RLS habilitada sin
// policies van a mano en el SQL de la migracion (Prisma no los expresa), patron `cierre_bodega`.
model OrdenIncidente {
  id            String                @id @default(uuid())
  ordenId       String                @map("orden_id")
  causa         GestionCausaIncidente // MISMO enum que el camino del mensajero (R45 = R9)
  motivo        String // R45: texto libre OBLIGATORIO siempre (Q-B), aparte de la causa
  estado        CierreEstado          @default(solicitado) // R43: nace `solicitado` (reuso 37)
  indemnizacion Decimal?              @db.Decimal(12, 2) // R50: NULL hasta que se apruebe
  reportadoPor  String                @map("reportado_por") // R51: el autor NO puede aprobarlo
  resueltoPor   String?               @map("resuelto_por") // R52/R54: el aprobador; NULL mientras `solicitado`
  resueltoAt    DateTime?             @map("resuelto_at")
  motivoRechazo String?               @map("motivo_rechazo") // R54: obligatorio SOLO al rechazar
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  orden               Orden                     @relation(fields: [ordenId], references: [id])
  reportadoPorUsuario Usuario                   @relation("IncidenteReportadoPor", fields: [reportadoPor], references: [id])
  resueltoPorUsuario  Usuario?                  @relation("IncidenteResueltoPor", fields: [resueltoPor], references: [id], onDelete: SetNull)
  evidencias          OrdenIncidenteEvidencia[]

  @@index([ordenId])
  @@index([estado]) // R49: la cola de pendientes (patron cierre_dia/cierre_bodega)
  @@index([reportadoPor])
  @@index([resueltoPor])
  @@map("orden_incidente")
}

// Feature 158 (R46): evidencias 1..N del incidente del admin. Espejo EXACTO de
// `GestionOrdenEvidencia` (119). Tabla PROPIA y no una FK nullable sobre la de gestion
// (design §9.9): esa tiene `gestion_id` NOT NULL y `@@unique([gestionId, indice])`, que son el
// invariante de la 119, y convertirla en enlace polimorfico no tiene precedente en el repo.
// `storage_path` es el path de un bucket PRIVADO, NUNCA una URL: se firma al mostrar (R46).
// RLS habilitada sin policies (solo service role, patron gestion_orden_evidencia).
model OrdenIncidenteEvidencia {
  id          String   @id @default(uuid())
  incidenteId String   @map("incidente_id")
  storagePath String   @map("storage_path") // path bucket privado, NO URL
  contentType String   @map("content_type") // image/jpeg|png|webp
  indice      Int // 0-based, orden de captura; 0 = portada
  createdAt   DateTime @default(now()) @map("created_at")

  incidente OrdenIncidente @relation(fields: [incidenteId], references: [id], onDelete: Cascade)

  @@unique([incidenteId, indice]) // no dos filas con el mismo indice por incidente
  @@index([incidenteId])
  @@map("orden_incidente_evidencia")
}

// Feature 37 (R13/R18, decision F1.4-d): estado del cierre del dia del mensajero.
// La 37 SOLO crea en `solicitado`; `aprobado`/`rechazado` se reservan para la
// feature 38 (patron "reservar valores del enum"). Fuente unica de verdad en
// lib/types/cierre.ts (CIERRE_ESTADO_SEED).
enum CierreEstado {
  solicitado
  aprobado
  rechazado
  vencido // feature 41 (R2): lo crea el corte diario; bloqueante y resoluble como solicitado

  @@map("cierre_estado")
}

// Feature 37 (R15, decision F1.4-e): destino derivado del cierre segun la zona del
// mensajero. `bodega_central` si la zona es la central (findCentralZonaId);
// `bodega_satelite` en caso contrario.
enum CierreDestinoTipo {
  bodega_central
  bodega_satelite

  @@map("cierre_destino_tipo")
}

// Feature 37 (R13-R16/R18/R19, decision F1.4-a,e,f): UN registro por solicitud de
// cierre del dia de un mensajero. Los totales por metodo de pago + general se
// SNAPSHOTEAN al crear (R14, money-critical); el detalle se deriva de las
// gestion_orden vinculadas (cierre_id). Destino derivado server-side al solicitar
// (para la feature 38). RLS habilitada sin policies (solo service role, patron
// gestion_orden/orden).
model CierreDia {
  id                         String            @id @default(uuid())
  mensajeroId                String            @map("mensajero_id") // FK -> usuario (el actor)
  estado                     CierreEstado      @default(solicitado)
  destinoTipo                CierreDestinoTipo @map("destino_tipo") // central/satelite derivado al solicitar
  destinoZonaId              String            @map("destino_zona_id") // zona del mensajero (central o satelite)
  totalEfectivo              Decimal           @default(0) @map("total_efectivo") @db.Decimal(12, 2) // snapshot R14
  totalSimpe                 Decimal           @default(0) @map("total_simpe") @db.Decimal(12, 2) // snapshot R14
  totalTransferencia         Decimal           @default(0) @map("total_transferencia") @db.Decimal(12, 2) // snapshot R14
  totalGeneral               Decimal           @default(0) @map("total_general") @db.Decimal(12, 2) // snapshot R14
  totalPagoMensajero         Decimal           @default(0) @map("total_pago_mensajero") @db.Decimal(12, 2) // feature 39/R13: snapshot total del pago al mensajero
  totalIngresoBodegaRechazos Decimal           @default(0) @map("total_ingreso_bodega_rechazos") @db.Decimal(12, 2) // feature 56/R12: snapshot total del ingreso de bodega por rechazos
  solicitadoAt               DateTime          @default(now()) @map("solicitado_at")
  resueltoPor                String?           @map("resuelto_por") // feature 38/R14: FK -> usuario (admin actor); NULL mientras solicitado
  resueltoAt                 DateTime?         @map("resuelto_at") // feature 38/R14: marca de tiempo de la resolucion
  motivoRechazo              String?           @map("motivo_rechazo") // feature 38/R11: obligatorio SOLO al rechazar; NULL en aprobado/solicitado
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  cierreBodegaId String? @map("cierre_bodega_id") // feature 40: nullable; NULL = cierre_dia aun no consolidado en bodega

  // Feature 264 (R27/R28/R29) — «NINGUNA» Y «NO LO SABEMOS» SON COSAS DISTINTAS.
  // `true` = las ordenes sin gestionar de este cierre SI se registraron, sea cuantas sea
  // (incluido cero: «registrado y ninguna» es una lectura correcta). `false` = este cierre es
  // ANTERIOR al registro y su lista es IRRECUPERABLE — la aprobacion ya borro el unico rastro
  // que habia. Sin esta columna, un cierre viejo se pintaria sin seccion y diria «no hubo
  // ninguna», que es tranquilizador y FALSO. El `DEFAULT true` marca a los cierres nuevos sin
  // escribir una linea en el camino caliente del corte (lo pone Postgres); la migracion baja a
  // `false` exactamente los que no se pueden reconstruir (`estado` fuera de los tres abiertos).
  sinGestionRegistrado Boolean @default(true) @map("sin_gestion_registrado")

  mensajero          Usuario            @relation("CierreMensajero", fields: [mensajeroId], references: [id])
  destinoZona        Zona               @relation(fields: [destinoZonaId], references: [id])
  resueltoPorUsuario Usuario?           @relation("CierreResueltoPor", fields: [resueltoPor], references: [id]) // feature 38/R14
  cierreBodega       CierreBodega?      @relation(fields: [cierreBodegaId], references: [id], onDelete: SetNull) // feature 40
  gestiones          GestionOrden[] // gestiones incluidas en este cierre (cierre_id)
  detalle            CierreDetail[] // feature 69/R1: snapshot congelado por orden de este cierre
  sinGestion         CierreSinGestion[] // feature 264/R1: las ordenes que el corte barrio a `sin_gestionar` al crear este cierre
  liquidacionPagos   LiquidacionPago[] // feature 172/R21/R22: pagos al mensajero registrados CONTRA este cierre

  @@index([mensajeroId])
  @@index([destinoTipo, destinoZonaId]) // feature 38: filtra por rol+zona destino
  @@index([estado])
  @@index([resueltoPor]) // feature 38/R14: auditoria de quien resolvio
  @@index([cierreBodegaId]) // feature 40: listar consolidables (cierre_bodega_id IS NULL)
  @@index([mensajeroId, estado]) // feature 41 (R12/R23): bloqueo derivado del mensajero (ruta caliente de asignacion)
  @@map("cierre_dia")
}

// Feature 40 (R8-R10/R16-R22, decision F1.4-a,b,e,g,k): cierre de NIVEL BODEGA. El
// adminSatelite consolida los cierre_dia `aprobado` de su zona y solicita el cierre a
// la bodega central; el maestro lo aprueba/rechaza. Reusa el enum CierreEstado (37).
// Totales agregados SNAPSHOT (money-critical, R10). Auditoria del maestro (patron 38,
// R20). Indice unico parcial (zona_id) WHERE estado='solicitado' + RLS habilitada sin
// policies van a mano en el SQL de la migracion (Prisma no los expresa).
model CierreBodega {
  id                         String       @id @default(uuid())
  zonaId                     String       @map("zona_id") // zona satelite que cierra
  solicitadoPor              String       @map("solicitado_por") // adminSatelite actor (FK usuario)
  estado                     CierreEstado @default(solicitado) // reuso enum feature 37 (F1.4-b)
  totalEfectivo              Decimal      @default(0) @map("total_efectivo") @db.Decimal(12, 2) // snapshot agregado R10
  totalSimpe                 Decimal      @default(0) @map("total_simpe") @db.Decimal(12, 2) // snapshot agregado R10
  totalTransferencia         Decimal      @default(0) @map("total_transferencia") @db.Decimal(12, 2) // snapshot agregado R10
  totalGeneral               Decimal      @default(0) @map("total_general") @db.Decimal(12, 2) // snapshot agregado R10
  totalPagoMensajero         Decimal      @default(0) @map("total_pago_mensajero") @db.Decimal(12, 2) // feature 39/R19: snapshot agregado del pago a mensajeros
  totalIngresoBodegaRechazos Decimal      @default(0) @map("total_ingreso_bodega_rechazos") @db.Decimal(12, 2) // feature 56/R18: snapshot agregado del ingreso de bodega por rechazos
  solicitadoAt               DateTime     @default(now()) @map("solicitado_at")
  resueltoPor                String?      @map("resuelto_por") // maestro actor; NULL mientras solicitado (R20)
  resueltoAt                 DateTime?    @map("resuelto_at") // marca de tiempo de la resolucion (R20)
  motivoRechazo              String?      @map("motivo_rechazo") // obligatorio SOLO al rechazar (R17); NULL si aprobado/solicitado
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  zona                 Zona        @relation(fields: [zonaId], references: [id])
  solicitadoPorUsuario Usuario     @relation("CierreBodegaSolicitadoPor", fields: [solicitadoPor], references: [id])
  resueltoPorUsuario   Usuario?    @relation("CierreBodegaResueltoPor", fields: [resueltoPor], references: [id])
  cierresDia           CierreDia[] // los cierre_dia incluidos (cierre_bodega_id)

  @@index([zonaId])
  @@index([estado])
  @@index([solicitadoPor])
  @@index([resueltoPor])
  @@map("cierre_bodega")
}

// Tarifa: tarifas de flete/comision, tabla multi-fila con `nombre` para
// distinguirlas (feature 18, D1). Cada fila se acota por el par (tienda, zona) y
// las DOS dimensiones son opcionales (feature 273); ver el @@unique de mas abajo.
// Borrado FISICO: `deleted_at` la retiro la migracion tarifa_zona_is_default.
// Sin columna de estado: la migracion drop_tarifa_status (feature 274) solto
// `status` y su enum al cerrar la deuda (g) de la feature 69, porque nunca entro
// en el WHERE del camino de liquidacion y la cascada (tienda, zona) la sustituye.
// Una tarifa que no debe aplicarse se BORRA; no hay fila presente-pero-ignorada.
model Tarifa {
  id                     String   @id @default(uuid())
  valorFlete             Decimal  @map("valor_flete") @db.Decimal(12, 2) // R2 (monto)
  valorFleteDevuelto     Decimal  @map("valor_flete_devuelto") @db.Decimal(12, 2) // R2 (monto)
  valorFleteGam          Decimal  @map("valor_flete_gam") @db.Decimal(12, 2) // R2/R4 (GAM -> gam)
  valorFleteDevueltoGam  Decimal  @map("valor_flete_devuelto_gam") @db.Decimal(12, 2) // R2/R4
  // OPCIONAL desde `20260826180000_tarifa_fulfillment_opcional`: el formulario de ZONA ya no
  // pide este campo (una tarifa de zona no describe el servicio de bodega de una tienda), asi
  // que la fila puede nacer sin monto. NULL y 0 significan LO MISMO aguas abajo -"esta tarifa
  // no lleva fulfillment"-, y por eso los lectores normalizan NULL a 0 en la frontera
  // (`TarifaRepository.toDTO`, `TarifaVigenteRepository`, `OrdenRepository.toTarifaDTO`) en vez
  // de propagar la ausencia: a diferencia de `tarifaEspecial`, aqui "sin pacto" y "cero" no son
  // dos hechos distintos. El predicado sigue siendo el monto (`tieneFulfillment`, > 0).
  fulfillment            Decimal? @db.Decimal(12, 2) // R2/D3 (monto); NULL = sin fulfillment
  comisionCod            Decimal  @map("comision_cod") @db.Decimal(5, 2) // R3/D3 (porcentaje 0..100)
  ivaFlete               Decimal  @map("iva_flete") @db.Decimal(5, 2) // R3/D2 (porcentaje 0..100)
  ivaComisionCod         Decimal  @map("iva_comision_cod") @db.Decimal(5, 2) // R3/D2 (porcentaje 0..100)
  // Cobro pactado aparte, fuera de la tabla de precios normal. NULLABLE a proposito:
  // NULL = "sin tarifa especial pactada" (que NO es lo mismo que 0, un cobro especial
  // de cero). Unica columna opcional de la tabla; ver la migracion tarifa_especial.
  tarifaEspecial         Decimal? @map("tarifa_especial") @db.Decimal(12, 2)
  // Hermana de la anterior para la DEVOLUCION (migracion tarifa_especial_zona_especial).
  // Independiente de ella: se puede pactar el flete de entrega y dejar la devolucion en la
  // tarifa normal, y al reves. NULL = sin pacto para la devolucion (que NO es 0).
  tarifaEspecialDevuelta Decimal? @map("tarifa_especial_devuelta") @db.Decimal(12, 2)
  // OPCIONAL: NULL = tarifa NO acotada a una tienda (aplica a cualquiera). Cuando
  // trae valor es FK -> usuario (la cuenta duena; el service exige un rol tarifable:
  // adminTienda o apiKey).
  tiendaId               String?  @map("tienda_id")
  // OPCIONAL: NULL = tarifa NO acotada a una zona (aplica a la tienda entera).
  // Desde la feature 274 la resolucion es una CASCADA sobre el par (tienda, zona):
  // 1) tienda+zona, 2) tienda con zona NULL, 3) zona con tienda NULL. La tienda ya
  // no es la unica dimension: una fila con `tienda_id` NULL y `zona_id` con valor
  // cobra a cualquier tienda de esa zona. El par (NULL, NULL) NO es un cuarto
  // nivel y el service lo rechaza al crear/actualizar.
  zonaId                 String?  @map("zona_id")
  // Tarifa a la que se cae cuando ninguna acotada por zona aplica. Nace en false:
  // marcarla es un acto explicito. Las filas historicas se backfillearon a true.
  isDefault              Boolean  @default(false) @map("is_default")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // ON DELETE CASCADE en las DOS FKs (migracion tarifa_fk_cascade): borrar la tienda o la
  // zona borra sus tarifas. Antes eran RESTRICT y una zona con tarifas era INBORRABLE; la
  // tarifa no es un dato con vida propia -describe el precio de ese par-, asi que sobrevivir
  // a su tienda/zona la dejaria colgando de una FK muerta. La traza historica NO se pierde:
  // `cierre_detail.tarifa_id` sigue siendo RESTRICT a proposito, de modo que una tarifa YA
  // LIQUIDADA bloquea la cascada entera y el borrado falla en vez de borrar la auditoria.
  tienda         Usuario?       @relation("TarifaTienda", fields: [tiendaId], references: [id], onDelete: Cascade)
  zona           Zona?          @relation("TarifaZona", fields: [zonaId], references: [id], onDelete: Cascade)
  cierreDetalles CierreDetail[] // feature 69/R8: cierres que liquidaron contra ESTA fila de tarifa (hace auditable la deuda (g))

  // Una sola tarifa por par (zona, tienda), con las dos dimensiones opcionales. El indice
  // en SQL usa NULLS NOT DISTINCT (PG15+) para que dos NULL cuenten como el MISMO par:
  // sin eso no habria como impedir dos «tarifas generales de la tienda X» ni dos globales,
  // que son justo los casos que el NULL habilita. Prisma no expresa NULLS NOT DISTINCT: se
  // declara aqui por el nombre del indice y el `where` compuesto, y se CREA a mano en la
  // migracion tarifa_zona_is_default. Mismo caso que TarifaZonaMensajero.
  //
  // El unico es TOTAL, y puede serlo porque esta tabla BORRA EN FISICO (esa misma migracion
  // retiro `deleted_at`): una tarifa borrada no ocupa su par.
  @@unique([zonaId, tiendaId])
  @@index([createdAt])
  @@index([tiendaId])
  @@index([zonaId])
  @@map("tarifas")
}

// TarifaZonaMensajero: tarifa de comision por zona pagada al mensajero
// (feature 24). vehiculo_id nullable (tarifa general de la zona si no aplica
// por tipo de vehiculo); zona_id obligatoria.
model TarifaZonaMensajero {
  id             String  @id @default(uuid())
  cobroEntregado Decimal @map("cobro_entregado") @db.Decimal(12, 2)
  cobroRechazado Decimal @map("cobro_rechazado") @db.Decimal(12, 2)
  vehiculoId     String? @map("vehiculo_id")
  zonaId         String  @map("zona_id")

  vehiculo Vehiculo? @relation(fields: [vehiculoId], references: [id])
  zona     Zona      @relation(fields: [zonaId], references: [id])

  // feature 24: una sola tarifa por (zona, vehiculo). El indice en SQL usa
  // NULLS NOT DISTINCT (PG15+), de modo que a lo sumo exista UNA tarifa por
  // defecto (vehiculo_id NULL) por zona, haciendo determinista la resolucion
  // "sin vehiculo -> tarifa por defecto de la zona". Prisma no expresa
  // NULLS NOT DISTINCT: ver la migracion tarifa_zona_mensajero_zona_vehiculo_unique.
  @@unique([zonaId, vehiculoId])
  @@index([vehiculoId])
  @@index([zonaId])
  @@map("tarifa_zona_mensajero")
}

// Catalogo de tipos de vehiculo (feature 50). Backed por enum Postgres
// vehiculo_value. OJO: columna "name" (NO "value" como rol/order_status/tipo_id).
// El id (uuid PK) queda listo para el FK usuario.vehiculo_id de la feature 21
// (NO se implementa ese FK aqui). Solo-lectura sembrado (P1=A), sin escritura.
model Vehiculo {
  id   String @id @default(uuid())
  // TEXT desde `20260824160000_vehiculo_name_texto`: el catalogo dejo de ser
  // solo-lectura y un enum seria un techo duro (una migracion por cada tipo nuevo).
  // El @unique impide dos tipos con el mismo nombre; el plegado/recorte lo hace el
  // servicio, NO la base (ver la migracion).
  name String @unique

  usuarios             Usuario[] // feature 21: mensajeros que declararon este vehiculo
  tarifaZonaMensajeros TarifaZonaMensajero[] // feature 24

  @@map("vehiculos")
}

enum VehiculoValue {
  moto
  carro
  camion

  @@map("vehiculo_value")
}

// Feature 42 (design §1.1): tipo del movimiento de la wallet. El signo del balance lo
// da `tipo`; el `monto` es SIEMPRE positivo. Enum Postgres nativo (patron RolValue).
enum WalletMovimientoTipo {
  ingreso
  egreso

  @@map("wallet_movimiento_tipo")
}

// Feature 42 (design §1.1): categoria (concepto) del movimiento. La 42 SOLO EMITE
// categorias `ingreso_*` (los 6 conceptos de Ordenex + `ingreso_ajuste` manual). Las
// `egreso_*` quedan RESERVADAS para 43/44/45 (patron "reservar valores del enum" de la
// feature 37), disponibles sin nueva migracion de enum.
enum WalletMovimientoCategoria {
  ingreso_flete // entregada: valorFlete[Gam]
  ingreso_flete_devolucion // devuelta/rechazada: valorFleteDevuelto[Gam] (A1)
  ingreso_comision_cod // entregada + orden.cobraComision (Q1)
  ingreso_iva_flete // ivaFlete% sobre flete
  ingreso_iva_flete_devolucion // ivaFlete% sobre flete de devolucion (A1)
  ingreso_iva_comision_cod // ivaComisionCod% sobre comision (solo si hubo comision)
  ingreso_ajuste // manual (F1.4-Q6)
  egreso_pago_tienda // reservado feature 43
  egreso_pago_mensajero // reservado feature 44
  egreso_gasto // feature 42: reservado; queda SIN USO en la 45 (Postgres no permite DROP VALUE)
  egreso_sueldo // feature 45: sueldo (registro manual)
  egreso_ajuste // manual (F1.4-Q6)
  egreso_gasto_fijo // feature 45: gasto fijo (lo EMITE el cron mensual, no el form manual)
  egreso_gasto_variable // feature 45: gasto variable (registro manual)
  egreso_indemnizacion // feature 158/R2: indemnizacion por incidente (la EMITE la aprobacion del cierre)
  // Feature 173 (design §2.1) — los DOS conceptos de TESORERIA: dinero de TERCEROS que solo
  // PASA por la caja. Su naturaleza la declara `NATURALEZA_POR_CATEGORIA`
  // (lib/utils/caja-tesoreria.ts), no una columna: la clasificacion es de la CATEGORIA.
  ingreso_cod_recaudado // R11: el contra-entrega recaudado ENTRA al aprobar el cierre del dia
  ingreso_reverso_pago_tienda // R24: la anulacion de un pago a tienda DEVUELVE el dinero a la caja

  @@map("wallet_movimiento_categoria")
}

// Feature 42 (design §1.1): tipo de origen polimorfico. `cierre_dia` = ingreso por
// cierre aprobado (42); `manual` = ajuste del maestro (origen_id NULL). El resto queda
// RESERVADO para 43/44/45.
enum WalletOrigenTipo {
  cierre_dia
  gestion_orden
  manual
  pago_tienda
  pago_mensajero
  gasto
  orden_incidente // feature 158/R37: egreso de indemnizacion aprobado sobre un incidente del ADMIN
  // Feature 293 (design §3.4, R20): origen del EGRESO DE CAJA del premio del ranking y de su
  // reverso. Apunta a `ranking_snapshot_fila.id` —la fila del podio— y NO al cierre: el unico de
  // la caja es `(origen_tipo, origen_id, categoria)` SIN mensajero, y el feed del cierre YA
  // escribio `(cierre_dia, cierreId, egreso_pago_mensajero)` al aprobar, asi que reusar esa clave
  // mandaria el egreso del premio a `ON CONFLICT DO NOTHING`: dinero fuera de la caja sin
  // registro y sin error. Se usa SOLO en las dos filas de la caja del premio.
  ranking_snapshot_fila

  @@map("wallet_origen_tipo")
}

// Feature 42 (design §1.2): LIBRO append-only de movimientos de la wallet (caja
// PRINCIPAL de Ordenex). Fila INMUTABLE (R1/R3): SIN updatedAt/deletedAt, sin soft
// delete; una correccion se hace con un movimiento de ajuste compensatorio, nunca
// alterando el original. El balance se DERIVA (SUM ingreso - SUM egreso), no se almacena
// (R16). Idempotencia por indice unico parcial (origen_tipo, origen_id, categoria) WHERE
// origen_id IS NOT NULL — va a mano en la migracion (Prisma no expresa indice parcial).
// RLS habilitada sin policies (solo service role, patron gestion_orden/cierre_dia).
model WalletMovimiento {
  id              String                    @id @default(uuid())
  tipo            WalletMovimientoTipo
  categoria       WalletMovimientoCategoria
  monto           Decimal                   @db.Decimal(12, 2) // > 0 (siempre positivo; el signo lo da `tipo`)
  origenTipo      WalletOrigenTipo          @map("origen_tipo")
  origenId        String?                   @map("origen_id") // NULL solo para origen_tipo = manual
  descripcion     String? // obligatoria en manual (validacion en service/zod)
  registradoPor   String?                   @map("registrado_por") // FK usuario (actor) en manual; NULL en automaticos
  fechaMovimiento DateTime                  @default(now()) @map("fecha_movimiento")
  createdAt       DateTime                  @default(now()) @map("created_at")
  // SIN updatedAt / deletedAt: la fila es INMUTABLE (R3). No hay soft-delete.

  registrador Usuario? @relation("WalletMovimientoRegistrador", fields: [registradoPor], references: [id])

  @@index([fechaMovimiento]) // R24: listado del libro por fecha (desc)
  @@index([tipo, categoria]) // R24: filtros por tipo/categoria
  @@index([origenTipo, origenId]) // R24: buscar movimientos de un origen
  @@map("wallet_movimiento")
}

// Feature 43 (design §1.1): tipo del movimiento del ledger POR TIENDA. `credito` = a favor
// de la tienda (COD recaudado); `debito` = descuento de Ordenex (flete/comision/IVAs) o pago
// a la tienda. El signo del saldo lo da `tipo`; `monto` es SIEMPRE positivo. Enum Postgres
// nativo (patron WalletMovimientoTipo).
enum WalletTiendaMovimientoTipo {
  credito
  debito

  @@map("wallet_tienda_movimiento_tipo")
}

// Feature 43 (design §1.1): categoria (concepto) del movimiento por tienda. Los 6 debitos
// son ESPEJO 1:1 de los 6 conceptos de ingreso de la 42 (R8). `cod_recaudado` es el credito
// (Q2). `pago_tienda` queda RESERVADO para el follow-up de pago/liquidacion (F1.4-Q4).
// `ajuste_credito`/`ajuste_debito` = correccion compensatoria inmutable (R3/R29).
enum WalletTiendaMovimientoCategoria {
  // credito (a favor de la tienda)
  cod_recaudado
  // debitos (espejo 1:1 de los 6 conceptos de ingreso de la 42, R8)
  flete
  flete_devolucion
  comision_cod
  iva_flete
  iva_flete_devolucion
  iva_comision_cod
  // pago/liquidacion (F1.4-Q4; RESERVADO aunque el pago sea follow-up)
  pago_tienda
  // ajustes manuales (inmutables, correccion compensatoria R3/R29)
  ajuste_credito
  ajuste_debito

  @@map("wallet_tienda_movimiento_categoria")
}

// Feature 43 (design §1.2): LEDGER append-only del saldo POR TIENDA (cuanto le debe ENTREGAR
// Ordenex a cada tienda). Fila INMUTABLE (R1/R3): SIN updatedAt/deletedAt; una correccion es
// un movimiento de ajuste compensatorio, nunca alterando el original. El saldo se DERIVA
// (SUM credito - SUM debito), no se almacena (R16). Idempotencia por indice unico parcial
// (origen_tipo, origen_id, tienda_id, categoria) WHERE origen_id IS NOT NULL — va a mano en
// la migracion (Prisma no expresa indice parcial). RLS habilitada sin policies (solo service
// role, patron wallet_movimiento/cierre_dia), acotado por tienda en el WHERE (R19/R24).
model WalletTiendaMovimiento {
  id              String                          @id @default(uuid())
  tiendaId        String                          @map("tienda_id") // FK -> usuario (rol adminTienda)
  tipo            WalletTiendaMovimientoTipo
  categoria       WalletTiendaMovimientoCategoria
  monto           Decimal                         @db.Decimal(12, 2) // > 0 (el signo lo da `tipo`)
  origenTipo      WalletOrigenTipo                @map("origen_tipo") // cierre_dia | pago_tienda | manual
  origenId        String?                         @map("origen_id") // NULL solo en manual
  descripcion     String?
  registradoPor   String?                         @map("registrado_por") // FK usuario (actor) en manual; NULL en automaticos
  fechaMovimiento DateTime                        @default(now()) @map("fecha_movimiento")
  createdAt       DateTime                        @default(now()) @map("created_at")
  // SIN updatedAt / deletedAt: la fila es INMUTABLE (R3). No hay soft-delete.

  tienda      Usuario  @relation("WalletTiendaMovimientoTienda", fields: [tiendaId], references: [id])
  registrador Usuario? @relation("WalletTiendaMovimientoRegistrador", fields: [registradoPor], references: [id])

  @@index([tiendaId, fechaMovimiento]) // R26: saldo/listado por tienda por fecha (desc)
  @@index([tiendaId, categoria]) // R26: filtro por concepto por tienda
  @@index([origenTipo, origenId]) // R26: movimientos de un origen (cierre)
  @@map("wallet_tienda_movimiento")
}

// Feature 44 (design §1.1): tipo del movimiento del LIBRO del pago al mensajero. `devengo` =
// Ordenex le debe al mensajero (aumenta la cuenta por pagar); `pago` = Ordenex ya le entrego
// (tomado del efectivo recaudado, o una liquidacion posterior; reduce la cuenta por pagar). El
// signo del saldo lo da `tipo`; `monto` es SIEMPRE positivo. Enum Postgres nativo (patron
// WalletMovimientoTipo).
enum PagoMensajeroMovimientoTipo {
  devengo
  pago

  @@map("pago_mensajero_movimiento_tipo")
}

// Feature 44 (design §1.1): categoria (concepto) del movimiento del pago al mensajero.
// `pago_devengado` = cierre_dia.total_pago_mensajero (snapshot 39). `pago_efectivo` = min(P,E):
// parte tomada del efectivo recaudado AL APROBAR ("lo ya pagado"). `liquidacion` queda RESERVADO
// para el follow-up de saldar la cuenta por pagar (F1.4-Qf; sin migracion futura).
// `ajuste_devengo`/`ajuste_pago` = correccion compensatoria inmutable (R3).
enum PagoMensajeroMovimientoCategoria {
  // devengo (Ordenex le debe al mensajero)
  pago_devengado
  // pago (lo ya entregado)
  pago_efectivo
  // liquidacion posterior de la cuenta por pagar (F1.4-Qf; RESERVADO)
  liquidacion
  // ajustes manuales (inmutables, correccion compensatoria R3)
  ajuste_devengo
  ajuste_pago
  // Feature 293 (design §3.1, R14): PREMIO DEL PODIO del ranking. Categoria PROPIA y no
  // `ajuste_devengo`, porque aquel se rotula «Ajuste (devengo)» y ahi ya viven los
  // contraasientos de la anulacion de liquidaciones: mezclarlos hace imposible responder «que
  // parte de esta cuenta es premio» (decision (d) del humano). Vive en la rama `devengo` del
  // CHECK tipo<->categoria: el premio SUBE la cuenta por pagar.
  premio_ranking

  @@map("pago_mensajero_movimiento_categoria")
}

// Feature 44 (design §1.2): LIBRO append-only del pago POR MENSAJERO (lo que Ordenex le debe y
// lo que ya le pago). Fila INMUTABLE (R1/R3): SIN updatedAt/deletedAt; una correccion es un
// movimiento de ajuste compensatorio, nunca alterando el original. La cuenta por pagar se DERIVA
// (SUM devengo - SUM pago), no se almacena (R14/R16). Idempotencia por indice unico parcial
// (origen_tipo, origen_id, mensajero_id, categoria) WHERE origen_id IS NOT NULL — va a mano en la
// migracion (Prisma no expresa indice parcial). Reutiliza el enum wallet_origen_tipo de la 42
// (cierre_dia | pago_mensajero | manual). RLS habilitada sin policies (solo service role, patron
// wallet_movimiento/cierre_dia), acotado por mensajero en el WHERE (R20/R24).
model PagoMensajeroMovimiento {
  id              String                           @id @default(uuid())
  mensajeroId     String                           @map("mensajero_id") // FK -> usuario (rol mensajero)
  tipo            PagoMensajeroMovimientoTipo
  categoria       PagoMensajeroMovimientoCategoria
  monto           Decimal                          @db.Decimal(12, 2) // > 0 (el signo lo da `tipo`)
  origenTipo      WalletOrigenTipo                 @map("origen_tipo") // cierre_dia | pago_mensajero | manual
  origenId        String?                          @map("origen_id") // NULL solo en manual
  descripcion     String?
  registradoPor   String?                          @map("registrado_por") // FK usuario (actor) en manual; NULL en automaticos
  fechaMovimiento DateTime                         @default(now()) @map("fecha_movimiento")
  createdAt       DateTime                         @default(now()) @map("created_at")
  // Feature 293 (design §3.3, R17): FECHA CALENDARIO CR DEL PODIO del que nace el premio
  // (medianoche UTC, convencion `@db.Date` del repo). NULL en todo lo que no es premio ni
  // reverso de premio.
  //
  // ⚠️ LOS DOS UNICOS PARCIALES Y LOS DOS CHECK QUE LA GOBIERNAN VIVEN SOLO EN LA MIGRACION
  // (`20260827120000_premio_ranking_devengo`), porque Prisma no expresa ni indices parciales ni
  // CHECK:
  //   - `pago_mensajero_movimiento_premio_dia_uq`      (mensajero_id, premio_dia) WHERE categoria = 'premio_ranking'
  //   - `pago_mensajero_movimiento_premio_reverso_uq`  (mensajero_id, premio_dia) WHERE categoria = 'ajuste_pago' AND premio_dia IS NOT NULL
  //   - `pago_mensajero_movimiento_premio_dia_check`   y el tipo<->categoria de la 172
  // El primero ES la guarda no negociable de R17. Un `migrate dev --create-only` futuro puede
  // proponer un `DROP INDEX` fantasma de cualquiera de los dos (no los ve en el datamodel): eso
  // NUNCA se resuelve borrando el indice — se borra la linea que el diff propone.
  premioDia       DateTime?                        @map("premio_dia") @db.Date
  // SIN updatedAt / deletedAt: la fila es INMUTABLE (R3). No hay soft-delete.

  mensajero   Usuario  @relation("PagoMensajeroMovimientoMensajero", fields: [mensajeroId], references: [id])
  registrador Usuario? @relation("PagoMensajeroMovimientoRegistrador", fields: [registradoPor], references: [id])

  @@index([mensajeroId, fechaMovimiento]) // R26: saldo/listado por mensajero por fecha (desc)
  @@index([origenTipo, origenId]) // R26: movimientos de un origen (cierre)
  @@map("pago_mensajero_movimiento")
}

// Feature 172 (design §1/§2.1) — el PAGO como DOCUMENTO propio. Los dos libros
// (wallet_tienda_movimiento / pago_mensajero_movimiento) siguen derivando el saldo; lo que
// esta tabla anade es la pieza que no existia: monto, metodo, referencia, nota, fecha REAL,
// actor e instante de REGISTRO (R7). De cada fila nace EXACTAMENTE un movimiento en el libro
// del beneficiario, enlazado por `origen_tipo` = pago_tienda|pago_mensajero + `origen_id` =
// este id (R38), que es lo que hereda gratis la idempotencia del indice unico parcial que los
// dos libros ya tienen.
//
// Fila INMUTABLE, igual que los libros: SIN updatedAt/deletedAt. Anular NO la toca (§2.2/R41).
//
// Dos FK nullables + CHECK XOR en vez de un discriminador (§2.1): `mensajero_id` y `tienda_id`
// apuntan las dos a `usuario`, asi que un `beneficiario_tipo` + id generico daria MENOS
// integridad referencial y un enum nuevo que mantener. Precedente en el repo:
// `notificacion_destinatario_xor`. Los 3 CHECK (beneficiario XOR, cierre sii mensajero,
// monto > 0) van a mano en la migracion: Prisma no expresa CHECK.
//
// `metodo` REUTILIZA el enum `metodo_pago_value` de la 36: no se crea ningun tipo ni se anade
// ningun valor a un enum existente, asi que NO hay que tocar ningun down.sql previo.
//
// `fecha_pago` es @db.Date (convencion del repo para fechas calendario: medianoche UTC del
// dia) y `created_at` es el instante de registro. Existen siempre y pueden diferir (R9).
//
// RLS habilitada SIN policies (solo service role, patron wallet_tienda_movimiento /
// pago_mensajero_movimiento / cierre_dia), R63.
//
// ────────────────────────────────────────────────────────────────────────────────────────
// FEATURE 205 — NO SE LE AÑADE NINGUNA RESTRICCION UNICA A ESTA TABLA. NUNCA. Y no es
// estetica: `LiquidacionPagoRepository.esChoqueDeClave` (`:80-84`) trata un P2002 SIN pista
// como choque de `clave_idempotencia`, y ese razonamiento se apoya POR ESCRITO en que
// «liquidacion_pago solo tiene dos restricciones unicas» (la PK sobre un uuid recien
// generado y esta). Bajo el driver adapter de Prisma 7 el `meta.target` de un P2002 llega
// VACIO —la cicatriz de `_shared/prisma-unique.ts`—, asi que un choque de CUALQUIER unico
// nuevo llegaria sin pista y se leeria como «clave repetida»: el servicio releeria por la
// clave, no la encontraria y responderia `no_encontrado`. Un pago legitimo rechazado con el
// mensaje equivocado, imposible de diagnosticar desde el sintoma.
// Por eso `reparto_id` lleva SOLO indice (design §1.2) y el `UNIQUE` de la idempotencia del
// reparto vive en `liquidacion_reparto`, que es otra tabla y otro `create`.
// ────────────────────────────────────────────────────────────────────────────────────────
model LiquidacionPago {
  id                String          @id @default(uuid())
  claveIdempotencia String          @unique @map("clave_idempotencia") // §4.1: uuid del cliente; el UNIQUE es la barrera contra el doble pago (R44)
  mensajeroId       String?         @map("mensajero_id") // FK -> usuario (rol mensajero); XOR con tienda_id
  tiendaId          String?         @map("tienda_id") // FK -> usuario (rol adminTienda); XOR con mensajero_id
  cierreId          String?         @map("cierre_id") // FK -> cierre_dia; NOT NULL sii el beneficiario es un mensajero (R21)
  monto             Decimal         @db.Decimal(12, 2) // > 0 (CHECK); el signo lo da la categoria del movimiento
  metodo            MetodoPagoValue // enum EXISTENTE de la feature 36 (R8)
  referencia        String? // obligatoria si metodo != efectivo; se exige en el borde (R12)
  nota              String?
  fechaPago         DateTime        @map("fecha_pago") @db.Date // fecha REAL del pago (R9/R37)
  registradoPor     String          @map("registrado_por") // FK -> usuario (actor); NOT NULL: un pago siempre lo registra alguien (R7)
  repartoId         String?         @map("reparto_id") // feature 205/R29: FK -> liquidacion_reparto; NULL = pago suelto contra UN cierre. Solo INDICE, jamas UNIQUE (ver nota abajo)
  createdAt         DateTime        @default(now()) @map("created_at") // instante de REGISTRO (R9)
  // SIN updatedAt / deletedAt: fila INMUTABLE, igual que los libros. La anulacion NO la toca.

  anulacion   LiquidacionAnulacion? // 0 o 1 (R75); su existencia ES el estado "anulado" (derivado, §2.2)
  mensajero   Usuario?              @relation("LiquidacionPagoMensajero", fields: [mensajeroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tienda      Usuario?              @relation("LiquidacionPagoTienda", fields: [tiendaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cierre      CierreDia?            @relation(fields: [cierreId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registrador Usuario               @relation("LiquidacionPagoRegistrador", fields: [registradoPor], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reparto     LiquidacionReparto?   @relation(fields: [repartoId], references: [id], onDelete: Restrict, onUpdate: Cascade) // feature 205

  @@index([mensajeroId, fechaPago])
  @@index([tiendaId, fechaPago])
  @@index([cierreId]) // pendiente por cierre (§5) y lista de comprobantes del cierre
  @@index([repartoId]) // feature 205/R28: reconstruir el resultado de UN reparto (`WHERE reparto_id = ...`)
  @@map("liquidacion_pago")
}

// Feature 172 (design §2.2, [P4]) — la ANULACION de un pago, como documento aparte. No son
// columnas `anulado_at`/`anulado_por` en el pago (alternativa H, descartada): eso volveria
// mutable el documento (contra R41) y dejaria el estado "anulado" en dos sitios —la marca y
// el contraasiento— que pueden desincronizarse. Aqui el estado se DERIVA de que exista esta
// fila, y no hay nada que sincronizar.
//
// El `@unique` de `pago_id` es la restriccion DE DATOS que exige R75: un segundo intento de
// anular choca contra el indice, no contra un `if`. Fila tambien INMUTABLE: no se anula una
// anulacion (R82). RLS habilitada sin policies (R63).
model LiquidacionAnulacion {
  id         String   @id @default(uuid())
  pagoId     String   @unique @map("pago_id") // UNIQUE = un pago se anula UNA vez (R75)
  motivo     String // no vacio; se exige en el borde (R72)
  anuladoPor String   @map("anulado_por") // FK -> usuario (actor de la anulacion, R73)
  createdAt  DateTime @default(now()) @map("created_at") // instante de la anulacion (R73)
  // SIN updatedAt / deletedAt: tambien INMUTABLE. No se anula una anulacion (R82).

  pago     LiquidacionPago @relation(fields: [pagoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  anulador Usuario         @relation("LiquidacionAnulacionActor", fields: [anuladoPor], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("liquidacion_anulacion")
}

// Feature 205 (design §1.1, D-D) — el ACTO de repartir UN importe entre los cierres pendientes
// de un mensajero. Una fila por reparto; los N `liquidacion_pago` que nacen de el cuelgan por
// `reparto_id`.
//
// POR QUE EXISTE LA TABLA y no se deriva la clave por cierre (§5.2, alternativa descartada):
// con `<clave>:<cierreId>` un reintento que recalcula el FIFO empieza en OTRO cierre, la clave
// derivada no colisiona con nada y SE PAGA DOS VECES. Evitarlo exigiria un `SELECT` previo por
// prefijo, es decir el TOCTOU que R29 prohibe. Aqui la barrera es de DATOS: el `UNIQUE` de
// `clave_idempotencia`, sobre una fila que se inserta la PRIMERA dentro de la transaccion, antes
// de mover un centimo.
//
// Fila INMUTABLE: sin `updated_at` ni `deleted_at`, igual que `liquidacion_pago` y
// `liquidacion_anulacion`. No existe metodo que la edite ni que la borre (R52); deshacer un
// reparto es anular sus pagos uno a uno (§10.5).
//
// `monto_total` es lo que la persona COMPROMETIO. La suma de sus pagos es igual por
// construccion y NO se guarda duplicada: derivarla es una suma sobre `liquidacion_pago`.
// El CHECK `monto_total > 0` va a mano en la migracion (Prisma no expresa CHECK).
//
// FKs `ON DELETE RESTRICT`: el rastro de quien cobro y quien registro no se pierde borrando un
// usuario. RLS habilitada SIN policies (solo service role), R49.
model LiquidacionReparto {
  id                String   @id @default(uuid())
  claveIdempotencia String   @unique @map("clave_idempotencia") // R29: la barrera contra el doble reparto; misma semantica que la del pago
  mensajeroId       String   @map("mensajero_id") // FK -> usuario (rol mensajero): el BENEFICIARIO del acto
  montoTotal        Decimal  @map("monto_total") @db.Decimal(12, 2) // > 0 (CHECK en la migracion); lo comprometido en UNA captura
  registradoPor     String   @map("registrado_por") // FK -> usuario (actor); NOT NULL: un pago siempre lo registra alguien
  createdAt         DateTime @default(now()) @map("created_at") // instante del registro
  // SIN updatedAt / deletedAt: fila INMUTABLE (R52).

  mensajero   Usuario           @relation("LiquidacionRepartoMensajero", fields: [mensajeroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registrador Usuario           @relation("LiquidacionRepartoRegistrador", fields: [registradoPor], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pagos       LiquidacionPago[] // las N imputaciones de este reparto (R28: `WHERE reparto_id = ...`)

  @@index([mensajeroId, createdAt(sort: Desc)]) // auditar los repartos de un mensajero, del mas reciente al mas viejo
  @@map("liquidacion_reparto")
}

// Feature 84: unidad de la periodicidad de una plantilla de gasto fijo. Con `periodicidadCantidad`
// expresa el pedido del humano y cualquier otro ciclo: diaria = 1 dias; semanal = 1 semanas;
// quincenal = 2 semanas; mensual = 1 meses; y tambien cada-3-dias, cada-6-meses, etc.
enum PeriodicidadUnidad {
  dias
  semanas
  meses
}

// Feature 45 (design §1.2): plantilla recurrente de GASTO FIJO. CONFIGURACION mutable (NO es
// el libro wallet_movimiento, que es inmutable): SI lleva updatedAt y se edita/activa/
// desactiva. NO se borra (R25): la desactivacion (activa=false) detiene la generacion futura
// y preserva el rastro de que genero cada egreso. El cron DIARIO
// (`/api/cron/generar-gastos-fijos`, `0 6 * * *`) lee las ACTIVAS, filtra las que aplican HOY
// segun su periodicidad (`lib/utils/periodicidad.ts`) y emite un egreso `egreso_gasto_fijo` en
// la caja principal por cada una. RLS habilitada sin policies (solo service role, patron
// wallet_movimiento/wallet_tienda_movimiento, R20).
//
// Feature 84 — periodicidad ARBITRARIA (antes: SIEMPRE mensual dia 1, clavada). Modelo
// unidad + cantidad + fecha de cobro: `fechaCobro` es el PRIMER cobro y el ANCLA del ciclo
// (antes de esa fecha no se cobra nada); los siguientes caen cada `periodicidadCantidad` x
// `periodicidadUnidad` a partir de ella. En `meses` el dia se CLAMPEA al ultimo dia del mes
// (ancla 31 -> 28/feb, 30/abr), nunca se saltea el mes.
//
// IDEMPOTENCIA (ojo, aca se puede duplicar plata): la clave `origen_id` es
// `<plantillaId>:<periodo>` bajo el indice unico parcial (origen_tipo, origen_id, categoria).
// Para `meses` el periodo SIGUE siendo `YYYY-MM` — mismo formato que pre-84, para que la clave
// no cambie en el deploy y no haya doble cobro. Para `dias`/`semanas` es `YYYY-MM-DD`.
// Ver `lib/utils/periodicidad.ts#periodoDe`.
//
// La periodicidad vive SOLO aca (plantilla -> `egreso_gasto_fijo`). Un `egreso_gasto_variable`
// es un movimiento suelto sin plantilla: por construccion, un variable no puede ser periodico.
model GastoFijoPlantilla {
  id                   String             @id @default(uuid())
  concepto             String // nombre/concepto del gasto fijo (obligatorio, no vacio)
  monto                Decimal            @db.Decimal(12, 2) // > 0
  activa               Boolean            @default(true)
  periodicidadUnidad   PeriodicidadUnidad @default(meses) @map("periodicidad_unidad")
  periodicidadCantidad Int                @default(1) @map("periodicidad_cantidad") // CHECK >= 1 en la migracion
  fechaCobro           DateTime           @map("fecha_cobro") @db.Date // ancla: fecha del PRIMER cobro
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([activa]) // cron: WHERE activa = true (R27)
  @@map("gasto_fijo_plantilla")
}

// Feature 76 (R8/R21/design §4.3): tabla de PREMIOS del ranking diario. Exactamente 3
// posiciones (1,2,3), cada una con un monto OPCIONAL en colones. `monto` NULLABLE =
// "sin premio asignado" (R9, decision F1.4-d): NUNCA es cero ni error. Monto-only (sin
// columna `etiqueta`). El ganador NO se guarda: el ocupante del podio se calcula on-read
// (R14/R15) cruzando el ranking con estas filas por posicion. Migracion aditiva con RLS.
model PremioRanking {
  id          String   @id @default(cuid())
  posicion    Int      @unique // 1, 2 o 3 (CHECK en la migracion); UNIQUE garantiza R8
  monto       Decimal? @db.Decimal(12, 2) // NULLABLE = sin premio asignado (R9)
  descripcion String?  @map("descripcion") // feature 76 (cambio de alcance 2026-07-16): rotulo libre opcional por posicion, INDEPENDIENTE del monto (NULLABLE = sin descripcion)
  createdAt   DateTime @default(now()) @map("created_at")
  // `@default(now())` declara el default que la migracion `20260716130000_premio_ranking` ya
  // creo en la columna. No es decorativo: la SEMILLA de esa misma migracion inserta las 3
  // posiciones SIN nombrar `updated_at`, asi que el default es lo que hace valido ese INSERT.
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("premio_ranking")
}

// Feature 49 (design §1.2, R23): tipo de ORIGEN de una transicion de estado — clasifica
// cual de los 12 call-sites de escritura de `orden.estatus_id` la produjo. Enum Postgres
// nativo (patron WalletMovimientoCategoria/GestionResultado), fuente unica de verdad
// reflejada en lib/types/orden-historial.ts.
enum OrdenHistorialOrigenTipo {
  carga_masiva // feature 15/27: estado inicial en createMany
  creacion_manual // feature 6: OrdenService.crear (create individual)
  generacion_guia // feature 17/30: generarGuiaLote
  asignacion_bodega // feature 17: asignarBodegaLote
  ruteo_satelite // feature 30: rutearBodegaSateliteLote
  recepcion_satelite // feature 33: recibirEnSatelite
  asignacion_satelite // feature 34: asignarSateliteLote
  recoleccion // feature 36: recogerLote
  gestion // feature 36: crearGestionYTransicionar
  liberacion_reprogramada // feature 46: liberarOrden (cron)
  ajuste_estado // feature 6: OrdenService.actualizar (CRUD generico)
  deshacer_gestion // feature 67 (F1.4-b): CierreDiaRepository.anularGestionYDevolverAGestion
  carga_api // feature 88 (D7): estado inicial en createManyOrdenesConGuia (canal integrador)
  liberacion_devuelta_sla // feature 99: cron SLA, devuelta -> en_bodega_central/en_bodega_satelite (reintento)
  escalado_devuelta_sla // feature 99: cron SLA, devuelta -> rechazada (escalado; enlaza gestion sintetica)
  reprogramacion_tienda // feature 100: adminTienda reprograma devuelta -> reprogramada (gestion sintetica reprogramada)
  recuperacion_manual // feature 100: bodega recupera devuelta -> en_bodega_central/en_bodega_satelite (accion manual, actor admin)
  cancelacion_api // feature 106: tienda cancela via API key en_bodega_central/en_ruta_bodega_central -> devolviendo_a_tienda (marcador motivo="cancelada por tienda")
  corte_sin_gestionar // feature 109: corte diario transiciona en_reparto -> sin_gestionar (actor null/cron)
  liberacion_sin_gestionar // feature 109: al APROBAR el cierre, sin_gestionar -> en_bodega_central/en_bodega_satelite (actor admin)
  recepcion_bodega_central // feature 138: recepcion fisica en la bodega central, en_ruta_bodega_central -> en_bodega_central (actor maestro/admin)
  devolucion_rechazada // feature 139: al APROBAR el cierre, rechazada -> por_devolver (satelite) / por_devolver_a_tienda (central) (actor admin)
  recoleccion_tienda // feature 154: el mensajero recolecta en la tienda, por_recolectar_en_tienda -> en_ruta_bodega_central (#43; lo ejecutara la 157)
  incidente // feature 154: familia propia del resultado `incidente` de la gestion. DECLARADA SIN PRODUCTOR hasta la 158 (la arista #44 en_reparto -> incidente viaja via `gestion`, decision Q4)
  deshacer_asignacion // feature 149: reversion de asignacion/ruteo antes de la recogida (por_recoger -> en_bodega_central/en_bodega_satelite; en_ruta_bodega_satelite -> en_bodega_central)
  asignacion_recoleccion // feature 157 (ampliacion): el maestro decide quien va a la tienda (por_recolectar_en_tienda -> recolectando)
  anclaje_devolucion // feature 239 (P8): ANCLAJE de la devolucion — al APROBAR el cierre, devolucion_por_confirmar -> devuelta (actor admin). Enlaza la gestion ancla. NO es visita real (no cuenta intentos)
  solicitud_ayuda_tienda // feature 235 (P2): LA IDA de la ayuda — en_reparto -> ayuda_tienda (actor = el mensajero asignado). NO es visita real (no cuenta intentos). No enlaza gestion
  rescate_ayuda_tienda // feature 235 (P2): LA VUELTA — ayuda_tienda -> en_reparto, por el punto UNICO de rescate (mensajero «Recuperar» o tienda «Habilitar»). NO es visita real. Es la familia por la que la politica de webhooks NO emite (P4)
  gestion_tienda_ayuda // feature 237 (R5): EL DESENLACE — ayuda_tienda -> reprogramada | rechazada, registrado por el adminTienda dueño. Enlaza gestion. SI es visita real (R6): cuenta UN intento, al reves que las dos de la 235
  rechazo_tienda // feature 240 (D8/R6): EL RECHAZO MANUAL — devuelta -> rechazada, decidido por el adminTienda dueño. Enlaza gestion sintetica. NO es visita real (R19): la orden ya tiene contada su `devuelta`, como `reprogramacion_tienda`
  habilitacion_api // feature 266 (D5/R16): LA HABILITACION POR API KEY — ayuda_tienda -> en_reparto, pedida por el integrador en lote. Familia propia y NO `rescate_ayuda_tienda` (design §7, A3): `actor_usuario_id` no distingue las vias, porque el usuario dedicado de la key ES la tienda. NO es visita real (R26): nadie fue a ninguna puerta. No enlaza gestion. NO exceptuada de webhook (R27): la rama A emite `en_reparto`
  rechazo_tope_intentos // feature 276 (R22, Q5): EL TOPE DE INTENTOS — al APROBAR el cierre, sin_gestionar -> rechazada sobre una orden que ya agoto sus intentos (actor admin). Enlaza gestion sintetica. NO es visita real: contarla subiria su propio contador y cobraria de mas

  @@map("orden_historial_origen_tipo")
}

// Feature 49 (design §1.1/§1.3): HISTORIAL append-only de las transiciones de estado de
// una orden (linea de tiempo). Fila INMUTABLE (R2): SIN updatedAt/deletedAt, sin soft
// delete; una correccion se representa con una NUEVA transicion, jamas alterando una fila
// previa. `estatusOrigenId` NULL = creacion (R1/R20); `actorUsuarioId` NULL = sistema/cron
// (R21). RLS habilitada sin policies (solo service role, patron gestion_orden/cierre_dia/
// wallet_movimiento, R3). La orden usa soft-delete, no borrado fisico, asi que el historial
// nunca queda huerfano.
model OrdenHistorialEstado {
  id               String                   @id @default(uuid())
  ordenId          String                   @map("orden_id")
  estatusOrigenId  String?                  @map("estatus_origen_id") // NULL = creacion (R1/R20)
  estatusDestinoId String                   @map("estatus_destino_id")
  actorUsuarioId   String?                  @map("actor_usuario_id") // NULL = sistema/cron (R21)
  origenTipo       OrdenHistorialOrigenTipo @map("origen_tipo") // clasificacion (R23)
  motivo           String? // de la gestion (R22); vacio en las demas transiciones
  gestionOrdenId   String?                  @map("gestion_orden_id") // enlaza la gestion que causo la transicion (familia gestion)
  createdAt        DateTime                 @default(now()) @map("created_at") // instante de la transicion (R1)
  // SIN updated_at / deleted_at: fila INMUTABLE (R2).

  orden          Orden         @relation(fields: [ordenId], references: [id])
  estatusOrigen  OrderStatus?  @relation("HistorialOrigen", fields: [estatusOrigenId], references: [id])
  estatusDestino OrderStatus   @relation("HistorialDestino", fields: [estatusDestinoId], references: [id])
  actor          Usuario?      @relation("HistorialActor", fields: [actorUsuarioId], references: [id], onDelete: SetNull)
  // Feature 67 (F1.4-i): ON DELETE **Restrict** EXPLICITO (no el default `SetNull` de una
  // relacion opcional). Este enlace sostiene el derivador de intentos (47/49), que dispara
  // `rechazada` -> cobroRechazado (56, dinero): un SET NULL silencioso lo corromperia sin
  // error. Declarado en el MODELO (no solo en SQL) para no reintroducir el drift que la
  // migracion 20260714123909 vino a eliminar. Las gestiones NO se borran: se ANULAN (67/R11).
  gestion        GestionOrden? @relation(fields: [gestionOrdenId], references: [id], onDelete: Restrict)

  @@index([ordenId, createdAt]) // R5: linea de tiempo de UNA orden
  @@index([ordenId, estatusDestinoId]) // R24: conteo de intentos (destinos `devuelta`)
  // Feature 167 (R32) — «Recolectadas hoy» del mensajero: `actor_usuario_id` = actor,
  // `origen_tipo` = 'recoleccion_tienda', `created_at` en la ventana del dia CR. Los dos indices
  // de arriba empiezan por `orden_id` y esta consulta NO filtra por orden: sin este indice seria
  // un seq scan sobre una tabla append-only que crece con CADA transicion del sistema, en una
  // pantalla que el mensajero abre decenas de veces al dia desde el movil.
  // Orden de columnas: igualdad -> igualdad -> rango, el unico que un btree recorre sin filtro
  // residual. `map:` EXPLICITO porque el nombre por defecto de Prisma
  // (`orden_historial_estado_actor_usuario_id_origen_tipo_created_at_idx`, 66 caracteres) excede
  // el limite de 63 de Postgres y quedaria truncado de forma no evidente.
  @@index([actorUsuarioId, origenTipo, createdAt], map: "orden_historial_actor_origen_created_idx")
  @@map("orden_historial_estado")
}

// Feature 69 (R1/R2/R6/R7/R8/R10/R11, design §2.1/§2.2): SNAPSHOT congelado del detalle de
// cada orden incluida en un cierre del dia. Grano (cierre_id, orden_id): a lo sumo UNA fila
// por orden y cierre, aunque la orden acumule varias gestiones vigentes en el mismo cierre
// (R2). Fila INMUTABLE (patron orden_historial_estado): SIN updated_at/deleted_at, sin soft
// delete — ninguna operacion posterior a la creacion del cierre la modifica (R10).
//
// El PORQUE: los feeds de wallet (42/43) leian `orden`/`zona`/`tarifas` VIVAS dentro de la tx
// de APROBACION. Editar `monto_cobrar` o la tarifa entre SOLICITAR y APROBAR descuadraba en
// silencio los `total_*` snapshot del cierre (37/R14) contra los movimientos emitidos. Aqui el
// cierre deja de PREGUNTAR y pasa a RECORDAR: se congela al crear el cierre (R3, misma tx).
//
// Se congelan las ENTRADAS de la formula, no los conceptos derivados (decision (b), design
// §7.1): los conceptos dependen del `resultado` de la GESTION, no de la orden, y exigirian el
// grano gestion. Con las entradas + `derivarIngresoOrden` (sin cambios, R21) la fila es
// re-derivable y auditable.
//
// `es_central` y los 5 nombres son COLUMNAS aunque exista el FK: `zona.es_central` y los
// nombres son MUTABLES; guardar solo el FK dejaria abierto el mismo vector (cambiar la zona
// central re-etiquetaria cierres viejos).
//
// Dinero DECIMAL(12,2), porcentajes DECIMAL(5,2); money-safe: nunca number/parseFloat (R11).
// RLS habilitada sin policies va en el SQL de la migracion (Prisma no la expresa, R25).
model CierreDetail {
  id       String @id @default(uuid())
  cierreId String @map("cierre_id")
  ordenId  String @map("orden_id")

  // --- money-critical (R6): las entradas de la formula de derivacion ---
  montoCobrar    Decimal? @map("monto_cobrar") @db.Decimal(12, 2) // `orden.monto_cobrar` (ya nullable en origen)
  cobraComision  Boolean  @map("cobra_comision") // `orden.cobra_comision`
  zonaId         String   @map("zona_id") // `orden.zona_id`
  tiendaId       String   @map("tienda_id") // `orden.tienda_id`: a quien se acredita (43), CONGELADO
  esCentral      Boolean  @map("es_central") // `zona.es_central` EN ESE INSTANTE (elige columna GAM, R21)
  // `distrito.zona_especial IS TRUE` EN ESE INSTANTE: es lo que decide si el flete sale del
  // pacto especial o de la columna normal. NOT NULL a proposito (a diferencia del origen, que
  // es tri-valuado): al congelar, "¿se cobro como especial?" ya no admite "nadie lo decidio".
  esZonaEspecial Boolean  @default(false) @map("es_zona_especial")

  // --- tarifa congelada (R8): todas o ninguna. NULL = la tienda no tenia tarifa vigente al
  // solicitar (gap R9, decision (c)): conceptos 0.00, NO bloquea el cierre. `tarifa_id` deja
  // rastro de QUE FILA se uso (contrapartida auditable de la deuda (g), design §6.1).
  tarifaId                    String?  @map("tarifa_id")
  tarifaValorFlete            Decimal? @map("tarifa_valor_flete") @db.Decimal(12, 2) // monto
  tarifaValorFleteGam         Decimal? @map("tarifa_valor_flete_gam") @db.Decimal(12, 2) // monto
  tarifaValorFleteDevuelto    Decimal? @map("tarifa_valor_flete_devuelto") @db.Decimal(12, 2) // monto
  tarifaValorFleteDevueltoGam Decimal? @map("tarifa_valor_flete_devuelto_gam") @db.Decimal(12, 2) // monto
  tarifaComisionCod           Decimal? @map("tarifa_comision_cod") @db.Decimal(5, 2) // porcentaje 0..100
  tarifaIvaFlete              Decimal? @map("tarifa_iva_flete") @db.Decimal(5, 2) // porcentaje 0..100
  tarifaIvaComisionCod        Decimal? @map("tarifa_iva_comision_cod") @db.Decimal(5, 2) // porcentaje 0..100
  // Monto FIJO de fulfillment de la tarifa (2026-08-19). NO entra en `derivarIngresoOrden` ni
  // en las wallets: se congela para poder MOSTRARLO en el detalle y en las descargas del cierre
  // con el mismo valor que tenia al solicitar. Es NULL en las filas anteriores a esta columna
  // (no hay backfill posible: la tarifa de entonces pudo cambiar), y eso se ve como celda vacia.
  tarifaFulfillment           Decimal? @map("tarifa_fulfillment") @db.Decimal(12, 2) // monto
  // Las DOS entradas nuevas de la formula (migracion tarifa_especial_zona_especial): el pacto
  // especial de entrega y el de devolucion, congelados como sus siete hermanas de arriba.
  tarifaEspecial              Decimal? @map("tarifa_especial") @db.Decimal(12, 2) // monto
  tarifaEspecialDevuelta      Decimal? @map("tarifa_especial_devuelta") @db.Decimal(12, 2) // monto

  // --- descriptivos (R7): lo que el admin ve del cierre (38), congelado ---
  numGuia         Int?    @map("num_guia") // SIN @unique: es copia, no identidad
  numRemision     String  @map("num_remision")
  destinatario    String
  direccion       String? // `orden.direccion` (nullable en origen)
  producto        String
  tiendaNombre    String  @map("tienda_nombre")
  zonaNombre      String  @map("zona_nombre")
  provinciaNombre String  @map("provincia_nombre")
  cantonNombre    String  @map("canton_nombre")
  distritoNombre  String? @map("distrito_nombre") // el distrito es el unico FK nullable de la orden

  createdAt DateTime @default(now()) @map("created_at")
  // SIN updated_at / deleted_at: fila INMUTABLE (R10).

  cierre CierreDia @relation(fields: [cierreId], references: [id])
  orden  Orden     @relation(fields: [ordenId], references: [id])
  zona   Zona      @relation(fields: [zonaId], references: [id])
  tienda Usuario   @relation("CierreDetailTienda", fields: [tiendaId], references: [id])
  // `onDelete: Restrict` NO es el default de Prisma para una relacion OPCIONAL (seria SetNull):
  // se declara porque la migracion `20260715140000_cierre_detail` creo la FK con ON DELETE
  // RESTRICT, igual que sus cuatro hermanas. La fila es INMUTABLE (R10) y `tarifa_id` es la
  // contrapartida auditable de la tarifa congelada: un SET NULL borraria esa traza en silencio
  // al borrar una tarifa. Sin esta linea, todo `migrate dev` proponia drop+add de la FK.
  tarifa Tarifa?   @relation(fields: [tarifaId], references: [id], onDelete: Restrict)

  @@unique([cierreId, ordenId]) // R2: el grano. Es tambien el indice de la ruta caliente (los feeds filtran por cierre_id)
  @@index([ordenId]) // trazar en que cierres aparecio una orden
  @@map("cierre_detail")
}

// Feature 264 (R1/R2/R4/R5/R7/R9/R10/R11): el VINCULO PERSISTIDO entre un cierre y cada orden
// que el corte diario barrio a `sin_gestionar` al crearlo.
//
// EL PORQUE (structural, no cosmetico): el detalle de un cierre se construye ENTERO sobre las
// gestiones (`gestion_orden.cierre_id` + `cierre_detail`), y una orden barrida por el corte NO
// TIENE GESTION. Hasta hoy la unica relacion cierre <-> orden barrida era un predicado VIVO
// (`orden.mensajero_asignado_id = cierre.mensajero_id AND estatus = sin_gestionar`) que la
// APROBACION destruye: libera la orden a bodega y le borra `mensajero_asignado_id`. Es decir, el
// cierre que se audita —el aprobado, el que ya movio dinero— mostraba CERO ordenes barridas y lo
// mostraba igual que un cierre que de verdad no barrio ninguna.
//
// NI UNA COLUMNA DE DINERO, y no es una promesa de la capa de arriba: es que no hay nada que
// sumar. Estas ordenes no tienen gestion, luego no tienen `pago_mensajero`, ni recaudo, ni
// tarifa. Si algun dia aparece aqui un `Decimal`, es un bug de diseño (lo vigila
// `tests/unit/guards/cierre-sin-gestion-sin-dinero.guardia.test.ts`).
//
// Grano `(cierre_id, orden_id)` y NO una columna en `orden`: una orden puede ser barrida,
// liberada, reasignada y barrida otra vez en OTRO cierre; una columna sobrescribiria el vinculo
// anterior. Misma razon por la que `cierre_detail` es tabla y no columnas.
model CierreSinGestion {
  id       String @id @default(uuid())
  cierreId String @map("cierre_id")
  ordenId  String @map("orden_id")

  // --- descriptivos CONGELADOS al barrer (R11). Copia, no identidad. ---
  // Precedente exacto de la feature 69/T18: el detalle de un cierre ya creado se leia navegando
  // `gestion_orden.orden.*` y el admin veia los valores de HOY, no los del cierre que revisa. No
  // hay motivo para repetir ese error en la mitad NUEVA de la misma pantalla.
  numGuia      Int?   @map("num_guia") // SIN @unique: es copia, no identidad
  numRemision  String @map("num_remision")
  destinatario String
  producto     String
  tiendaNombre String @map("tienda_nombre")
  zonaNombre   String @map("zona_nombre") // contexto de auditoria del barrido; hoy no se pinta

  // R4: el estatus REAL del que salio esta orden (`en_reparto` | `ayuda_tienda`), tomado de la
  // vuelta del bucle que la barrio y NUNCA supuesto — es literalmente la razon por la que ese
  // bucle tiene dos vueltas (feature 235/R27). NULL = no consta (R32/R33): la fila OMITE la pieza
  // en pantalla, no pinta un guion.
  estatusOrigenId String? @map("estatus_origen_id")

  createdAt DateTime @default(now()) @map("created_at")
  // SIN updated_at / deleted_at: fila INMUTABLE, como `cierre_detail` (69/R10).

  cierre        CierreDia    @relation(fields: [cierreId], references: [id])
  orden         Orden        @relation(fields: [ordenId], references: [id])
  // `onDelete: Restrict` NO es el default de Prisma para una relacion OPCIONAL (seria SetNull):
  // se declara porque la migracion crea la FK con ON DELETE RESTRICT, igual que sus dos hermanas.
  // Sin esta linea, todo `migrate dev` propondria drop+add de la FK.
  estatusOrigen OrderStatus? @relation(fields: [estatusOrigenId], references: [id], onDelete: Restrict)

  @@unique([cierreId, ordenId]) // el grano, y el indice de la ruta caliente (se filtra por cierre_id)
  @@index([ordenId]) // trazar en que cierres se barrio una orden
  @@map("cierre_sin_gestion")
}

// Feature 81 (design §2): una API key emitida por un maestro. La key en claro NUNCA
// se persiste: solo su hash SHA-256 [D7] (R16) y un `key_prefix` no secreto (R17)
// para poder identificarla visualmente sin revelarla. 1:1 con su usuario dedicado
// [D6]: `usuario_id` UNIQUE. Sin `revoked_at`/`expires_at`/`last_used_at`: fuera de
// alcance (81b), se añaden aditivamente cuando el humano los pida.
// Ciclo de vida de una API key (rotar/activar/desactivar). El estado de la key es
// PROPIO de la fila `api_key`, NO se reusa el estado del usuario dedicado: activar o
// desactivar una key no debe tocar la cuenta (ni al reves). `activa` autoriza la carga
// (feature 88/R7), `inactiva` la revoca sin borrar la fila (ni el hash ni el rastro).
enum EstadoApiKey {
  activa
  inactiva

  @@map("estado_api_key")
}

model ApiKey {
  id            String       @id @default(uuid())
  identificador String // input crudo (recortado) para mostrar. No unico [D8]
  slug          String // normalizado; base del email/cedula sinteticos (R5)
  keyPrefix     String       @map("key_prefix") // `ordx_` + 7 chars, en claro (R17)
  keyHash       String       @unique @map("key_hash") // SHA-256 hex del secreto completo (R16/R25)
  estado        EstadoApiKey @default(activa) @map("estado") // ciclo de vida propio de la key (activar/desactivar)
  usuarioId     String       @unique @map("usuario_id") // [D6] 1:1 con la cuenta dedicada (R21)
  createdById   String       @map("created_by_id") // actor que la genero (R21)
  createdAt     DateTime     @default(now()) @map("created_at") // R21
  // Default declarado para que coincida con `20260716150000_api_key`, que creo la columna
  // como `NOT NULL DEFAULT CURRENT_TIMESTAMP` (espejo de `created_at`).
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")

  usuario   Usuario @relation("ApiKeyUsuario", fields: [usuarioId], references: [id])
  createdBy Usuario @relation("ApiKeyCreadaPor", fields: [createdById], references: [id])

  @@index([createdById])
  @@map("api_key")
}

// Feature 99 (design §1.1, R1/R2) — suscripcion de webhook por OWNER (el usuario dueno de
// las ordenes; para integradores, el usuario dedicado de la API key). El identificador del
// suscriptor NO se inventa: es `owner_usuario_id` (unico -> a lo sumo UNA suscripcion por
// owner, R1; el re-registro es un upsert por esa clave, R6). `secret` guarda el CIPHERTEXT
// del secreto de firma (AES-256-GCM, design §1.3/§3.1, D2/R32): NUNCA texto plano. RLS
// habilitada SIN policies (R2), patron api_key / jobs / geocode_cache: la tabla guarda un
// secreto y solo es accesible desde el rol de servicio. El vinculo con las ordenes ya
// existe (`orden.tienda_id = owner_usuario_id`), no se crea uno nuevo.
model WebhookSuscripcion {
  id             String   @id @default(uuid())
  ownerUsuarioId String   @unique @map("owner_usuario_id") // R1: 1 por owner; R6: upsert por esta clave
  url            String // callback https absoluta (validada en el borde, R5)
  secret         String // CIPHERTEXT del secreto de firma HMAC (design §1.3, D2/R32) — nunca en claro
  activa         Boolean  @default(true) // R8: baja = activa=false
  createdAt      DateTime @default(now()) @map("created_at")
  // Default declarado para que coincida con `20260721130000_webhook_suscripcion`.
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  owner Usuario @relation("WebhookSuscripcionOwner", fields: [ownerUsuarioId], references: [id], onDelete: Restrict)

  @@map("webhook_suscripcion")
}

// Feature 90 (design §1.1): tipo de un background job. Enum NATIVO de Postgres con
// `@@map`, ampliable por `ALTER TYPE ... ADD VALUE` en las features 91/92 (geocodificacion,
// webhooks). En v1 solo existe el job recurrente de liberacion de reprogramadas (feature 46).
enum JobTipo {
  liberar_reprogramadas // 91/92 anaden valores aditivamente
  geocodificacion // feature 91: geocodifica la direccion de UNA orden (payload { ordenId })
  optimizacion_ruta // feature 92: reoptimiza la ruta de UN mensajero (payload { mensajeroId })
  webhook_estado // feature 99: entrega firmada del cambio de estado de UNA orden a su integrador (payload { ordenId, estatusDestinoId, ocurridoAt })
  whatsapp_template_sync // integracion WhatsApp: reintenta contra Meta una op de plantilla (create/update/delete) que fallo en linea (payload { plantillaId, operacion })
  whatsapp_chat_envio // feature 109/D1: reintenta el envio saliente de un mensaje de chat que devolvio `transitorio` (payload { mensajeChatId })
  analitica_rollup_diario // feature 124/D4: agrega el rollup diario de la fecha CR que acaba de cerrar (D-1); RECURRENTE a las 00:30 CR, payload vacio {}
  analitica_invalidacion_cache // feature 128/D3: invalida por tag la cache de la analitica operativa tras un recomputo del backfill (125); PUNTUAL, encolado por el script, payload { desde, hasta }
  whatsapp_bienvenida // mensaje de bienvenida: envia la plantilla marcada al recoger el paquete (por_recoger -> en_reparto, familia `recoleccion`); PUNTUAL, encolado por el choke point de estado, payload { ordenId, mensajeroId, ocurridoAt }

  @@map("job_tipo")
}

// Feature 90 (design §1.1): estado del ciclo de vida de un job en la cola. Enum NATIVO
// de Postgres con `@@map`. `pending` (encolado, vencido o no), `processing` (reclamado por
// un worker), `done` (ejecutado con exito), `failed` (dead-letter tras agotar intentos).
enum JobEstado {
  pending
  processing
  done
  failed

  @@map("job_estado")
}

// Feature 90 (design §1.2): una fila de la cola de background jobs (patron
// transactional-outbox + worker sobre Postgres). El drenador `procesar-jobs` reclama
// lotes vencidos con `FOR UPDATE SKIP LOCKED`, ejecuta el handler por tipo y aplica
// complete / backoff / dead-letter. Los indices REALES son PARCIALES (seleccion de
// pendientes vencidos y unicidad de `dedupe_key` no nulo) y la RLS sin policies van a
// mano en la migracion (Prisma no expresa ni indices parciales ni RLS). RLS habilitada
// sin policies (solo service role), patron api_key / wallet_movimiento / premio_ranking.
model Job {
  id          String    @id @default(uuid())
  tipo        JobTipo
  payload     Json      @default("{}") @db.JsonB
  estado      JobEstado @default(pending)
  intentos    Int       @default(0)
  maxIntentos Int       @map("max_intentos")
  runAfter    DateTime  @default(now()) @map("run_after")
  lockedAt    DateTime? @map("locked_at")
  lastError   String?   @map("last_error")
  dedupeKey   String?   @unique @map("dedupe_key") // el indice REAL es unico PARCIAL (WHERE dedupe_key IS NOT NULL)
  createdAt   DateTime  @default(now()) @map("created_at")
  // Default declarado para que coincida con `20260717120000_jobs_cola`.
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("jobs")
}

// Feature 91 (design §1.2, R2/R28): cache de direcciones YA resueltas, indexada por la
// HUELLA de la direccion normalizada (nunca la direccion en claro: es dato personal).
// Evita re-pagar al proveedor por direcciones repetidas y abarata los reintentos de la
// cola. Solo se cachean resultados SATISFACTORIOS: un ZERO_RESULTS vive en la orden
// (`geocode_status`), no aqui. Retencion PERMANENTE, sin TTL (gate F1.4-Q7): la
// invalidacion es implicita, una direccion distinta produce una huella distinta.
// RLS habilitada sin policies (solo service role), patron jobs / api_key: guarda
// coordenadas y no es accesible desde el cliente.
model GeocodeCache {
  id            String   @id @default(uuid())
  direccionHash String   @unique @map("direccion_hash")
  latitud       Decimal  @db.Decimal(10, 7)
  longitud      Decimal  @db.Decimal(10, 7)
  precision     String
  payloadCrudo  Json?    @map("payload_crudo") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("geocode_cache")
}

// Feature 92 (design §1.1, R27/R30): estado de la ruta optimizada de un mensajero. Enum
// NATIVO (patron JobEstado): vocabulario PROPIO y cerrado. `desactualizada` significa que
// la ultima llamada al proveedor fallo y se CONSERVA el orden anterior (R27): la secuencia
// previa NUNCA se borra ni se cae en silencio a `createdAt desc`.
enum RutaEstado {
  vigente
  desactualizada

  @@map("ruta_estado")
}

// Feature 92 (design §1.1, R23/R26/R27): cabecera de la ruta optimizada de UN mensajero
// (una fila por mensajero, `mensajeroId` unico). Guarda el origen desde el que se calculo
// la ruta con su fuente (gps | ultima_conocida | centroide) y la huella del conjunto de
// paradas + origen, que es la guarda de coste R36 (mismo conjunto -> no se vuelve a pagar).
// `ultimoError` guarda un mensaje AGREGADO: NUNCA credencial, token, direccion ni
// coordenadas (R14). RLS habilitada sin policies (solo service role, va en la migracion):
// guarda geolocalizacion de una persona y no es accesible desde el cliente.
model RutaOptimizada {
  id                String     @id @default(uuid())
  mensajeroId       String     @unique @map("mensajero_id")
  estado            RutaEstado @default(vigente)
  calculadaAt       DateTime?  @map("calculada_at") // NULL = nunca se calculo
  origenLat         Decimal?   @map("origen_lat") @db.Decimal(10, 7)
  origenLng         Decimal?   @map("origen_lng") @db.Decimal(10, 7)
  origenAt          DateTime?  @map("origen_at")
  origenFuente      String?    @map("origen_fuente")
  huellaSet         String?    @map("huella_set")
  ultimoError       String?    @map("ultimo_error")
  // Feature 265 (20260822140000_ruta_secuencia_fuente): QUIEN ordeno la secuencia que hay en
  // `ruta_optimizada_parada` — 'proveedor' o 'local'. NULL = no consta (ruta anterior a la
  // feature, o el caso trivial de 0/1 parada). TEXT y no enum, mismo criterio que
  // `origen_fuente` y `trazado_fuente`. Sin backfill: ver la migracion.
  secuenciaFuente   String?    @map("secuencia_fuente")
  // Trazado persistido (20260814120000_ruta_optimizada_trazado). Las cuatro se escriben y se
  // limpian SIEMPRE juntas: valen para la huella_set de esta misma fila y para ninguna otra.
  // Solo se cachea `trazado_fuente = 'routes'` — ver la migracion.
  trazadoPolilinea  String?    @map("trazado_polilinea")
  trazadoDistanciaM Int?       @map("trazado_distancia_m")
  trazadoDuracionS  Int?       @map("trazado_duracion_s")
  trazadoFuente     String?    @map("trazado_fuente")
  // Guarda de coste del trayecto EN VIVO (20260814160000_ruta_tramo_vivo_at). Contador de
  // gasto, no dato de negocio: solo lo lee la guarda del intervalo minimo.
  tramoVivoAt       DateTime?  @map("tramo_vivo_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  // Default declarado para que coincida con `20260720130000_ruta_optimizada`.
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at")

  mensajero Usuario                @relation("RutaOptimizadaMensajero", fields: [mensajeroId], references: [id], onDelete: Cascade)
  paradas   RutaOptimizadaParada[]

  @@map("ruta_optimizada")
}

// Feature 92 (design §1.1/§5.2, R26): una parada POSICIONADA de la ruta. Los dos indices
// unicos `(rutaId, ordenId)` y `(rutaId, secuencia)` son los que hacen IMPOSIBLE persistir
// una secuencia con posiciones repetidas o con la misma orden dos veces: la invariante la
// garantiza la DB, no solo el codigo. Una orden en reparto SIN fila aqui es una parada
// "sin optimizar" (R28), que la lectura muestra al final.
model RutaOptimizadaParada {
  id              String  @id @default(uuid())
  rutaId          String  @map("ruta_id")
  ordenId         String  @map("orden_id")
  secuencia       Int
  // Tramo que LLEGA a esta parada (20260814140000_ruta_parada_tramo). La fila 1 guarda el
  // origen -> primera parada. No necesita invalidacion propia: `reemplazarSecuencia` borra e
  // reinserta estas filas enteras en cada recalculo.
  tramoPolilinea  String? @map("tramo_polilinea")
  tramoDistanciaM Int?    @map("tramo_distancia_m")
  tramoDuracionS  Int?    @map("tramo_duracion_s")

  ruta  RutaOptimizada @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  orden Orden          @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@unique([rutaId, ordenId])
  @@unique([rutaId, secuencia])
  @@index([ordenId])
  @@map("ruta_optimizada_parada")
}

// Feature 146 (design §1.1) — tipo de PRESENTACION de la notificacion: mapea 1:1 al icono
// que pinta el indicador de avisos. Enum Postgres nativo (patron RolValue / ChatMensajeTipo).
enum NotificacionTipo {
  alert
  box
  warning

  @@map("notificacion_tipo")
}

// Feature 146 (design §1.1) — evento de dominio que origino la notificacion. INVENTARIO
// CERRADO de D1 (exactamente cuatro productores): anadir un evento exige migracion de enum,
// deliberado (mismo criterio que OrdenHistorialOrigenTipo), para que ningun productor no
// especificado se cuele sin revision (R26).
enum NotificacionEvento {
  orden_rechazada
  carga_masiva_terminada
  postulacion_mensajero_pendiente
  cierre_dia_por_aprobar
  postulacion_recurso_pendiente // feature 253 (D6): alguien ofrecio un vehiculo o una bodega desde la landing publica
  dia_reparto_corregido // feature 262 (D7): a una orden asignada le corrigieron el dia de reparto; se avisa AL MENSAJERO asignado y a nadie mas (R46/R51)
  cierre_dia_vencido // feature 271 (§9.2, R38/R39): el corte creo un cierre `vencido`; se avisa al MENSAJERO dueño y a su bodega responsable
  mensajero_bloqueado_por_cierres // feature 271 (§9.2, R40/R41/R42): el mensajero quedo BLOQUEADO por acumular cierres, o por un rechazo; mismo evento para las tres causas porque la accion que pide es la misma

  @@map("notificacion_evento")
}

// Feature 146 (design §1.1) — tipo de la entidad de origen. Discrimina a que tabla apunta
// `entidadId` (referencia POLIMORFICA, sin FK).
enum NotificacionEntidadTipo {
  orden
  usuario
  cierre_dia
  carga
  postulacion_recurso // feature 253 (D6): la entidad es una fila de `postulacion_recurso`, que NO es un `usuario` (no crea cuenta)
  orden_dia_reparto_cambio // feature 262 (D7): la entidad es la fila del RASTRO, no la orden. Con `orden` la clave unica `notificacion_dedupe_key` solo admitiria UN aviso por (evento, orden, mensajero) PARA SIEMPRE, y la segunda correccion de esa orden no avisaria nunca (design §15.2, A20)

  @@map("notificacion_entidad_tipo")
}

// Feature 146 (design §1.2, R1/R4/R5/R6) — una notificacion DIRIGIDA (D4): o a un ROL
// (`destinatarioRol`) o a un USUARIO concreto (`destinatarioUsuarioId`), nunca a ambos ni a
// ninguno (CHECK XOR `notificacion_destinatario_xor` en la migracion; Prisma no expresa
// CHECK). Un evento con N roles destinatarios produce N filas (F1.4-5).
//
// `tiendaId` y `zonaId` son el ALCANCE (F1.4-1): opcionales e INDEPENDIENTES entre si.
// NULL en ambos = visible a todo el rol (R13). Ambos con FK ON DELETE CASCADE (R11).
// `tiendaId` referencia `usuario` porque en este esquema la tienda ES el usuario adminTienda.
//
// `leidaAt` NO vive aqui a proposito (D4): el estado de lectura es POR USUARIO y vive en
// `NotificacionLectura`. Fila INMUTABLE (sin updatedAt): nada de la notificacion cambia
// despues de crearse.
model Notificacion {
  id                    String                  @id @default(uuid())
  tipo                  NotificacionTipo
  evento                NotificacionEvento
  descripcion           String
  anexo                 String?
  entidadTipo           NotificacionEntidadTipo @map("entidad_tipo")
  entidadId             String?                 @map("entidad_id") // referencia polimorfica: SIN FK (design Riesgo 4)
  destinatarioRol       RolValue?               @map("destinatario_rol")
  destinatarioUsuarioId String?                 @map("destinatario_usuario_id")
  tiendaId              String?                 @map("tienda_id") // alcance: el adminTienda dueno de la orden
  zonaId                String?                 @map("zona_id") // alcance: la zona del adminSatelite
  createdAt             DateTime                @default(now()) @map("created_at")

  destinatarioUsuario Usuario? @relation("NotificacionDestinatario", fields: [destinatarioUsuarioId], references: [id], onDelete: Cascade)
  tienda              Usuario? @relation("NotificacionTienda", fields: [tiendaId], references: [id], onDelete: Cascade)
  zona                Zona?    @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  lecturas NotificacionLectura[]

  // Los indices del listado y del alcance son PARCIALES (WHERE ... IS NOT NULL) y van a
  // mano en la migracion; Prisma no los expresa. Lo mismo el unico de dedupe
  // (`notificacion_dedupe_key`, NULLS NOT DISTINCT). Se declaran aqui los btree simples
  // equivalentes para que el cliente generado conozca la forma de la tabla. El `map:` reproduce
  // el nombre que la migracion `20260727120000_notificacion` le puso a mano: sin el, Prisma
  // propone un `ALTER INDEX ... RENAME` en toda migracion futura.
  @@index([entidadTipo, entidadId], map: "notificacion_entidad_idx")
  @@map("notificacion")
}

// Feature 146 (design §1.3, R2/R3) — estado de una notificacion PARA UN USUARIO. La
// AUSENCIA de fila significa "no leida y no descartada". Descartar implica leida (se
// escriben ambos instantes) para que descartar una no leida no descuadre el contador.
// Unico (notificacionId, usuarioId): a lo sumo una fila por par, y es la clave del upsert
// idempotente de marcar/descartar (R37). Que el estado viva aqui —y no en `Notificacion`—
// es lo que hace que un admin que lee NO apague el aviso de los demas admins (R3).
model NotificacionLectura {
  id             String    @id @default(uuid())
  notificacionId String    @map("notificacion_id")
  usuarioId      String    @map("usuario_id")
  leidaAt        DateTime? @map("leida_at")
  descartadaAt   DateTime? @map("descartada_at")

  notificacion Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([notificacionId, usuarioId])
  @@index([usuarioId])
  @@map("notificacion_lectura")
}

// Feature 123 (design §3.1) — ROLLUP DIARIO de analitica. Tabla DERIVADA y reconstruible:
// no es fuente de verdad de nada. La escribe el job diario (feature 124) y la recomputa el
// backfill (feature 125); la consulta la 126. Mientras dura la 123 nace y se queda VACIA
// (R44): esta feature entrega solo el DDL.
//
// GRANO (R2): (fecha, zonaId, tiendaId, mensajeroId, estatusId, causaDevolucion). No es una
// eleccion de esta feature: es la UNION de los `granos` de las metricas con
// `fuente.tipo = "rollup"` del catalogo de la 135 (`lib/analytics/metrics.ts`). La septima
// dimension del catalogo, `metodo_pago`, NO tiene columna (R3): su unica consumidora es
// `clase: "live"` sobre cierres y ledger.
//
// EL `@@unique` DEL GRANO SI SE DECLARA AQUI, Y ES IMPRESCINDIBLE QUE ASI SEA.
// El indice vive en la migracion como `analytics_daily_grano_key` con `NULLS NOT DISTINCT`,
// clausula que Prisma no sabe expresar. Pero "Prisma no expresa la clausula" NO es razon
// para omitir el `@@unique`: son dos cosas distintas. Si el datamodel no declara el indice,
// Prisma no lo VE, y el primer `prisma migrate dev` de la 124 emitiria un
// `DROP INDEX "analytics_daily_grano_key"` mezclado con su cambio legitimo. Al caer el
// unico, el `ON CONFLICT` del upsert deja de tener donde agarrarse y el rollup se duplica
// SIN UN SOLO ERROR — exactamente el fallo silencioso que ese indice existe para impedir
// (ver la cabecera de la migracion). Ningun test que lea el `.sql` o este archivo lo
// detectaria, porque el drift solo aparece al comparar datamodel contra base.
//
// Con el `@@unique` declarado, Prisma reconoce el indice y deja de proponer borrarlo; lo
// unico que le sigue siendo invisible es `NULLS NOT DISTINCT`, que no le impide
// reconocerlo. El `map:` es obligatorio porque el nombre por defecto que Prisma derivaria
// de seis columnas (`analytics_daily_fecha_zona_id_tienda_id_..._key`) rebasa el limite de
// 63 caracteres de un identificador de Postgres.
//
// PRECEDENTE DEL REPO, mismo problema y misma solucion: `tarifa_zona_mensajero` declara
// `@@unique([zonaId, vehiculoId])` (linea ~952) aunque su indice real tambien lleva
// `NULLS NOT DISTINCT`; alli se resolvio nombrando el indice con el nombre que Prisma
// espera —ver `20260711190000_tarifa_zona_mensajero_zona_vehiculo_unique/migration.sql:6`,
// «El nombre del indice coincide con el que Prisma espera para @@unique([zonaId,
// vehiculoId])»—. Aqui se hace al reves, con `map:`, porque el nombre generado no cabe.
// El invariante compartido es el mismo: el datamodel SIEMPRE declara el indice.
//
// Los tres `@@index` llevan `map:` por la misma razon: sin el, Prisma esperaria
// `analytics_daily_tienda_id_fecha_idx` y renombraria los tres de la base.
//
// Recordatorio de por que el unico importa tanto: dos columnas del grano son nullable con
// significado de dominio (`mensajeroId IS NULL` = cubo sin_asignar, `causaDevolucion IS
// NULL` = sin causa tipificada) y con la semantica UNIQUE por defecto —que trata cada NULL
// como distinto— el upsert de la 124 insertaria una fila nueva en cada pasada.
//
// Lo que SI se queda fuera del datamodel son los tres CHECK estructurales
// (`analytics_daily_pio_lte_entregas`, `analytics_daily_ciclo_coherente`,
// `analytics_daily_medidas_no_negativas`): mismo patron que `gestion_orden` /
// `orden_incidente`, Prisma no expresa CHECK. Los tres `@@index` de abajo si son
// declarables y se corresponden con los tres roles `acotado` del catalogo.
//
// MEDIDAS: solo componentes ADITIVOS (R17). Ninguna tasa, promedio ni porcentaje guardado;
// ninguna columna de dinero (R5). `segCicloAcum` es BigInt y no Int por desbordamiento
// (R21) y se atribuye a la fecha del EVENTO TERMINAL (D4/R34); `ordenesEstadoStock` es un
// STOCK al corte y NO se suma por fecha (R28/R29). La semantica completa viaja en los
// `COMMENT ON COLUMN` de la migracion (R30).
model AnalyticsDaily {
  id              String                  @id @default(uuid())
  fecha           DateTime                @db.Date // fecha calendario de COSTA RICA del dia agregado, nunca un instante (R6)
  zonaId          String                  @map("zona_id") // zona DE LA ORDEN, congelada (D9/R34 de la 135; R31)
  tiendaId        String                  @map("tienda_id") // tienda DE LA ORDEN; en este esquema la tienda ES un usuario adminTienda (R31)
  mensajeroId     String?                 @map("mensajero_id") // NULL = cubo sin_asignar, NUNCA "todos los mensajeros" (D5/R30 de la 135; R11)
  estatusId       String                  @map("estatus_id") // estado de la orden EN EL CORTE del dia (R33)
  causaDevolucion GestionCausaDevolucion? @map("causa_devolucion") // NULL = sin causa tipificada (R12)

  ordenesCreadas     Int    @default(0) @map("ordenes_creadas") // FLUJO: ordenes nacidas ese dia; metrica propia del catalogo (R27)
  ordenesEstadoStock Int    @default(0) @map("ordenes_estado_stock") // STOCK al corte: NO sumar por fecha (R28)
  entregas           Int    @default(0) // gestiones vigentes `entregada`
  devoluciones       Int    @default(0) // gestiones vigentes `devuelta`
  rechazos           Int    @default(0) // gestiones vigentes `rechazada`
  reprogramaciones   Int    @default(0) // gestiones vigentes `reprogramada`
  incidentes         Int    @default(0) // gestiones vigentes `incidente`: 4.o termino de DENOMINADOR_GESTIONES (R18)
  primerIntentoOk    Int    @default(0) @map("primer_intento_ok") // CONTEO entero, subconjunto de `entregas` de la misma fila (D1/R23/R24)
  segCicloAcum       BigInt @default(0) @map("seg_ciclo_acum") // numerador: segundos de ciclo acumulados (R20/R21)
  segCicloN          Int    @default(0) @map("seg_ciclo_n") // denominador: ordenes que cerraron ciclo (R20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at") // rastro de la ultima recomputacion (R8)

  // R37: las cuatro FK son ON DELETE RESTRICT / ON UPDATE CASCADE. Borrar una coordenada
  // con historia agregada dejaria el rollup mintiendo (Cascade) o con NULL que colisiona
  // con el significado de "sin asignar" (SetNull); que el borrado falle es lo correcto.
  zona      Zona        @relation(fields: [zonaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tienda    Usuario     @relation("AnalyticsDailyTienda", fields: [tiendaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mensajero Usuario?    @relation("AnalyticsDailyMensajero", fields: [mensajeroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estatus   OrderStatus @relation(fields: [estatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // R14: el unico del grano. El `map:` apunta al indice REAL de la migracion, que ademas
  // lleva `NULLS NOT DISTINCT` (invisible para Prisma, pero irrelevante para que lo
  // reconozca). El orden de campos coincide exactamente con el del CREATE UNIQUE INDEX.
  // Sin esta linea, `prisma migrate dev` propondria borrarlo. Ver el bloque de arriba.
  @@unique([fecha, zonaId, tiendaId, mensajeroId, estatusId, causaDevolucion], map: "analytics_daily_grano_key")
  @@index([tiendaId, fecha], map: "analytics_daily_tienda_fecha_idx") // recorte de adminTienda (122)
  @@index([mensajeroId, fecha], map: "analytics_daily_mensajero_fecha_idx") // recorte de mensajero; cubre el cubo sin_asignar
  @@index([zonaId, fecha], map: "analytics_daily_zona_fecha_idx") // recorte de adminSatelite, por zona DE LA ORDEN
  @@map("analytics_daily")
}

// Feature 196 (design §2.1, R1/R11/R12/R13/R24) — CABECERA del ranking CONGELADO de una
// fecha calendario de Costa Rica. Una fila por fecha; `fecha` es UNIQUE y ESA restriccion
// es la idempotencia del cron (R13): la reejecucion choca en la base, no en el codigo.
//
// `fecha` es DATE (medianoche UTC), convencion del repo para fecha calendario CR (feature
// 46, `fechaComoDate` en lib/analytics/rollup-dia.ts): NO es el `desde` de la ventana.
//
// SIN `updatedAt` a proposito (R12): la fila es INMUTABLE por diseno. Una columna que nunca
// se actualiza es una invitacion a actualizarla.
//
// `minAsignadasPodio` congela el umbral APLICADO en esa corrida: es lo que hace auditable
// el podio el dia que `RANKING_MIN_ASIGNADAS` cambie. `filas` congela el conteo; `0` es un
// dato real ("ese dia no hubo actividad"), distinto de la AUSENCIA de cabecera ("el cron no
// corrio esa fecha") — la distincion que R26 exige y que una tabla plana no podria dar.
//
// RLS habilitada sin policies (va en la migracion, patron ruta_optimizada / analytics_daily):
// son datos de rendimiento de personas identificadas, nunca accesibles desde el cliente (R38).
model RankingSnapshotDia {
  id                String   @id @default(cuid())
  fecha             DateTime @unique @db.Date // fecha calendario de COSTA RICA congelada, nunca un instante (R2)
  generadoAt        DateTime @default(now()) @map("generado_at") // R24: evidencia de que el cron corrio y CUANDO (deja auditable el desfase del premio, Q2)
  minAsignadasPodio Int      @map("min_asignadas_podio") // R1: umbral APLICADO en esta corrida (CHECK >= 1 en la migracion)
  filas             Int // R1/R11: conteo congelado; 0 = dia sin actividad (CHECK >= 0 en la migracion)

  filasSnapshot RankingSnapshotFila[]

  @@map("ranking_snapshot_dia")
}

// Feature 196 (design §2.2, R6/R8/R9/R10/R13/R16/R17/R25) — DETALLE: una fila por mensajero
// CON ACTIVIDAD en la fecha congelada (R5). Patron cabecera+detalle de
// `ruta_optimizada` / `ruta_optimizada_parada`.
//
// `puesto` (1..N) ES el orden congelado: la lectura hace `ORDER BY puesto` y JAMAS reordena
// ni recalcula (R25). `posicion` es 1/2/3 solo si la fila ocupo podio, NULL si no (R6/R9).
//
// `mensajeroNombre` es el nombre CONGELADO (R16): un renombrado posterior no reescribe la
// historia. La FK a `usuario` es ON DELETE RESTRICT (R17), igual que las cuatro de
// `analytics_daily`: ante la duda, que falle el borrado y no que se corrompa la historia.
//
// NO se guarda el porcentaje (R10, regla 3 de `analytics_daily`: nada de tasas persistidas):
// `pct` es funcion pura de `entregadas`/`asignadas`, y el ORDEN —lo unico que un cambio de
// comparador podria mover— ya esta congelado en `puesto`.
//
// NO hay CHECK `entregadas <= asignadas`, y es DELIBERADO: las dos magnitudes salen de
// fuentes distintas (`gestion_orden.created_at` vs `orden.asignado_at`), asi que una orden
// asignada ayer y entregada hoy hace `entregadas > asignadas` legitimamente. Un CHECK ahi
// tumbaria el cron un dia cualquiera.
//
// INDICES QUE VIVEN SOLO EN LA MIGRACION: el UNIQUE PARCIAL
// `(snapshot_id, posicion) WHERE posicion IS NOT NULL` (R13) — Prisma no sabe expresar un
// indice parcial (no hay `WHERE` en `@@unique`), asi que va a mano en el `.sql` y queda
// HUERFANO del datamodel, mismo patron y misma consecuencia aceptada que
// `wallet_movimiento_origen_categoria_uq` y los indices de `purga_pdf_indices`: un
// `prisma migrate dev --create-only` futuro puede proponer un `DROP INDEX` fantasma, que
// NUNCA se resuelve borrando el indice sino descartando la migracion propuesta.
// Declararlo aqui como `@@unique([snapshotId, posicion])` NO es equivalente: seria un
// indice TOTAL, y aunque Postgres trate los NULL como distintos, el indice cargaria con
// todas las filas fuera de podio sin necesidad.
model RankingSnapshotFila {
  id                String   @id @default(cuid())
  snapshotId        String   @map("snapshot_id")
  puesto            Int // 1..N: el orden congelado es DATO, no derivacion (R25)
  posicion          Int? // 1/2/3 si ocupo podio; NULL si no (R6/R9)
  mensajeroId       String   @map("mensajero_id")
  mensajeroNombre   String   @map("mensajero_nombre") // R16: nombre congelado, no el actual
  entregadas        Int // numerador del dia
  asignadas         Int // denominador del dia
  premioMonto       Decimal? @map("premio_monto") @db.Decimal(12, 2) // R7: mismo tipo exacto que premio_ranking.monto; NULL fuera de podio (R8, CHECK en la migracion)
  premioDescripcion String?  @map("premio_descripcion") // R7

  snapshot  RankingSnapshotDia @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  mensajero Usuario            @relation("RankingSnapshotFilaMensajero", fields: [mensajeroId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([snapshotId, mensajeroId]) // R13: un mensajero no puede aparecer dos veces en el mismo dia
  @@unique([snapshotId, puesto]) // R13: dos filas no pueden ocupar el mismo puesto
  @@map("ranking_snapshot_fila")
}

// Feature 253 (design §2.3) — tipo del recurso ofrecido en una postulacion de la landing
// publica. Enum Postgres nativo (patron RolValue / MetodoPagoValue): son DOS y cerrados, y la
// tarjeta que abre el formulario ya los fija (`LandingPostular.tsx`).
enum PostulacionRecursoTipo {
  vehiculo
  bodega

  @@map("postulacion_recurso_tipo")
}

// Feature 253 (design §2.3, R21) — una persona del PUBLICO ofrece un vehiculo o una bodega desde
// la landing. No es una cuenta: sin login, sin documentos, sin cedula y sin aprobacion que
// conceda acceso (por eso NO vive en `usuario`, design §14-C).
//
// POR QUE `atendida_at` + `atendida_por_id` Y NO UN ENUM DE ESTADO (design §3/§14-F): hay
// exactamente DOS situaciones —pendiente (`atendida_at IS NULL`, la escribe la Server Action
// publica) y atendida (la escribe un administrador con nombre y hora)—, y un enum de dos valores
// no guarda QUIEN ni CUANDO, que es justo el dato que se busca cuando alguien pregunta si a esa
// persona la llamaron. Es el mismo patron de mutacion UNICA y en un solo sentido que
// `orden_nota.deleted_at`. NO se declara ningun tercer estado: un valor sin productor es deuda.
//
// SIN `@@unique` sobre `correo` ni sobre `telefono` (R25): quien tiene un vehiculo Y una bodega
// postula dos veces, y quien corrige su mensaje vuelve a enviar.
//
// EL CHECK `postulacion_recurso_atendida_completa` (las dos columnas de la atencion van juntas o
// no van) VIVE SOLO EN LA MIGRACION: Prisma no expresa CHECK (mismo caso que
// `notificacion_destinatario_xor`). Su existencia la afirma el test estatico de la migracion.
model PostulacionRecurso {
  id            String                 @id @default(uuid())
  tipo          PostulacionRecursoTipo
  nombre        String
  telefono      String
  correo        String // normalizado en el borde: recortado y en minusculas (R12/R20)
  mensaje       String // texto libre topado en el borde (R13); sin cota seria una puerta abierta
  createdAt     DateTime               @default(now()) @map("created_at")
  atendidaAt    DateTime?              @map("atendida_at") // NULL = pendiente
  atendidaPorId String?                @map("atendida_por_id")

  atendidaPor Usuario? @relation("PostulacionRecursoAtendidaPor", fields: [atendidaPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([atendidaAt, createdAt]) // R26: el listado del panel (`atendida_at IS NULL ORDER BY created_at DESC`) y el barrido del cron de purga
  @@index([atendidaPorId]) // segunda FK indexada (patron `orden_nota`): sin el, el RESTRICT recorre la tabla al borrar un usuario
  @@map("postulacion_recurso")
}

/// Feature 262 (D4, design §5.1) — RASTRO de las correcciones del dia de reparto de una orden ya
/// asignada. Fila INMUTABLE (patron `orden_historial_estado`): sin `updated_at`, sin `deleted_at`,
/// sin soft delete. Una correccion posterior ANADE una fila; ninguna operacion reescribe una
/// anterior (R23).
///
/// POR QUE UNA TABLA PROPIA Y NO `orden_historial_estado` (design §4.5, A1), y son TRES
/// consecuencias MEDIDAS, no tres opiniones:
///   1. Una fila falsa `por_recoger -> por_recoger` rompe «Deshacer asignacion»:
///      `findOrigenesReversion` elige con `DISTINCT ON` la mas reciente cuyo destino es el estado
///      ACTUAL y devolveria `por_recoger`, que NO esta en `NORMALIZACION_DESTINO` -> `conflict`
///      con «sin historial», que ademas es falso.
///   2. Ni siquiera se podria escribir: `appendCambioEstado` valida contra `TRANSICIONES` y
///      `por_recoger -> por_recoger` no existe en ese grafo (ni debe: un bucle sobre si mismo es
///      una mentira sobre la maquina de estados).
///   3. Emitiria un webhook de estado DUPLICADO a cada integrador suscrito (99/R10-R11) sobre una
///      orden que no se movio.
/// Y una razon de FORMA encima de las tres: una fila del historial no tiene DONDE guardar «de que
/// dia a que dia»; habria que esconder un dato estructurado dentro de `motivo`.
model OrdenDiaRepartoCambio {
  id String @id @default(uuid())

  ordenId String @map("orden_id")

  /// NOT NULL a proposito: la operacion EXIGE dia previo (R5), asi que una fila que dijera «no
  /// tenia dia» no la puede escribir ningun productor. Nullable admitiria un estado irrepresentable.
  fechaAnterior DateTime @map("fecha_anterior") @db.Date

  /// `@db.Date` en las dos: son FECHAS, no instantes. Misma convencion que `orden.fecha_reparto`
  /// (46/246). Un `timestamp` reabriria la trampa de las seis horas que cerro la 166.
  fechaNueva DateTime @map("fecha_nueva") @db.Date

  /// NOT NULL, al reves que `orden_historial_estado.actor_usuario_id` (donde NULL = cron): AQUI
  /// SIEMPRE HAY UNA PERSONA, y quien corrigio es la evidencia. La FK es `Restrict` por el mismo
  /// criterio que `orden_nota.autor_id` y `postulacion_recurso.atendida_por_id`.
  actorUsuarioId String @map("actor_usuario_id")

  /// R21: obligatorio, ya recortado en el borde (`trim().min(10).max(300)`).
  motivo String

  createdAt DateTime @default(now()) @map("created_at")

  orden Orden   @relation("OrdenDiaRepartoCambioOrden", fields: [ordenId], references: [id])
  actor Usuario @relation("OrdenDiaRepartoCambioActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// EL CHECK `orden_dia_reparto_cambio_dia_distinto` (`fecha_nueva <> fecha_anterior`) VIVE SOLO
  /// EN LA MIGRACION: Prisma no expresa CHECK (mismo caso que `notificacion_destinatario_xor`).
  /// Es R7 puesto en la base: una «correccion» que no corrige nada no es escribible ni por error.
  @@index([ordenId, createdAt]) // la UNICA consulta prevista: «el rastro de esta orden», en orden. Cubre ademas la FK a `orden` por prefijo
  @@index([actorUsuarioId]) // la FK RESTRICT, indexada (patron `orden_nota`): sin el, borrar un usuario recorre la tabla
  @@map("orden_dia_reparto_cambio")
}
