generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TipoIdentificacion {
  id    String @id @default(uuid())
  value String @unique // seed: "cedula", "ruc", "pasaporte"

  usuarios Usuario[]

  @@map("tipo_identificacion")
}

model Rol {
  id    String   @id @default(uuid())
  value RolValue @unique // seed: "maestro", "admin", "mensajero", "Admin Tienda", "adminSatelite"

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("rol")
}

enum RolValue {
  maestro
  admin
  mensajero
  adminTienda   @map("Admin Tienda")
  adminSatelite // feature 19: label literal en la DB 'adminSatelite' (slug camelCase, SIN @map)
  apiKey // feature 81 [D1]: cuenta dedicada a una API key. SIN filas en `rol_permiso` (fallo seguro: la key no puede nada hasta que el humano conceda permisos explicitos)

  @@map("rol_value")
}

model Permiso {
  id        String   @id @default(uuid())
  nombre    String
  method    String // verbo HTTP (texto libre, ver design.md "Alternativas descartadas")
  route     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles RolPermiso[]

  @@unique([method, route]) // R6
  @@map("permiso")
}

// Tabla pivote explicita de la relacion N:M rol <-> permiso.
model RolPermiso {
  rolId     String   @map("rol_id")
  permisoId String   @map("permiso_id")
  createdAt DateTime @default(now()) @map("created_at")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId]) // R8: pareja unica
  @@index([permisoId])
  @@map("rol_permiso")
}

enum EstadoUsuario {
  pendiente // recien creado, sin verificar
  activo
  inactivo
  bloqueado // por seguridad / bloqueo por fallos

  @@map("estado_usuario")
}

model Usuario {
  id                   String        @id @default(uuid())
  nombre               String
  primerApellido       String?       @map("primer_apellido") // feature 21: identidad; requerido en postulacion via servicio, nullable en DB
  segundoApellido      String?       @map("segundo_apellido") // feature 21: opcional
  email                String        @unique
  telefono             String
  passwordHash         String        @map("password_hash")
  estado               EstadoUsuario @default(pendiente)
  cedula               String        @unique
  tipoIdentificacionId String        @map("tipo_identificacion_id")
  rolId                String        @map("rol_id")
  vehiculoId           String?       @map("vehiculo_id") // feature 21: solo mensajeros; FK -> vehiculos
  placa                String? // feature 21: placa del vehiculo del mensajero, normalizada uppercase/trim
  fulfillment          Boolean       @default(false) // feature 27: tienda con fulfillment (rol adminTienda); default false
  zonaId               String?       @map("zona_id") // feature 24/R6: nullable; solo mensajero/adminSatelite lo llevan
  ordenEnGestionId     String?       @map("orden_en_gestion_id") // feature 36/R19-R21: orden activa 1-a-1 en gestion; NULL = ninguna
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tipoIdentificacion                  TipoIdentificacion        @relation(fields: [tipoIdentificacionId], references: [id])
  rol                                 Rol                       @relation(fields: [rolId], references: [id])
  vehiculo                            Vehiculo?                 @relation(fields: [vehiculoId], references: [id]) // feature 21
  zona                                Zona?                     @relation(fields: [zonaId], references: [id]) // feature 24/R6/R8: ON DELETE RESTRICT
  ordenEnGestion                      Orden?                    @relation("UsuarioOrdenEnGestion", fields: [ordenEnGestionId], references: [id], onDelete: SetNull) // feature 36/R19-R21
  loginAttempts                       LoginAttempt[]
  trustedDevices                      TrustedDevice[]
  otpChallenges                       EmailOtpChallenge[]
  documentos                          MensajeroDocumento[] // feature 21
  ordenesTienda                       Orden[]                   @relation("OrdenTienda")
  ordenesMensajeria                   Orden[]                   @relation("OrdenMensajeroSugerido") // feature 15: sugerencia de mensajero en carga masiva
  ordenesAsignadas                    Orden[]                   @relation("OrdenMensajeroAsignado") // feature 17: mensajero ASIGNADO (decision del maestro)
  gestionesRealizadas                 GestionOrden[]            @relation("GestionMensajero") // feature 36: gestiones que este mensajero registro
  gestionesAnuladas                   GestionOrden[]            @relation("GestionAnuladaPor") // feature 67/R11: gestiones que este usuario DESHIZO (rastro de la anulacion)
  tarifasTienda                       Tarifa[]                  @relation("TarifaTienda") // tarifas cuya tienda es este usuario (adminTienda)
  cierresRealizados                   CierreDia[]               @relation("CierreMensajero") // feature 37: cierres del dia solicitados por este mensajero
  cierresResueltos                    CierreDia[]               @relation("CierreResueltoPor") // feature 38: cierres que este admin aprobo/rechazo
  cierresBodegaSolicitados            CierreBodega[]            @relation("CierreBodegaSolicitadoPor") // feature 40: cierres de bodega solicitados por este adminSatelite
  cierresBodegaResueltos              CierreBodega[]            @relation("CierreBodegaResueltoPor") // feature 40: cierres de bodega que este maestro aprobo/rechazo
  walletMovimientosRegistrados        WalletMovimiento[]        @relation("WalletMovimientoRegistrador") // feature 42/R2/R15: movimientos manuales que este usuario (maestro) registro
  walletTiendaMovimientos             WalletTiendaMovimiento[]  @relation("WalletTiendaMovimientoTienda") // feature 43/R1/R2: movimientos del ledger de ESTA tienda (rol adminTienda)
  walletTiendaMovimientosRegistrados  WalletTiendaMovimiento[]  @relation("WalletTiendaMovimientoRegistrador") // feature 43/R2: movimientos manuales del ledger de tienda que este usuario registro
  pagoMensajeroMovimientos            PagoMensajeroMovimiento[] @relation("PagoMensajeroMovimientoMensajero") // feature 44/R1/R2: movimientos del libro del pago a ESTE mensajero (rol mensajero)
  pagoMensajeroMovimientosRegistrados PagoMensajeroMovimiento[] @relation("PagoMensajeroMovimientoRegistrador") // feature 44/R2: movimientos manuales del libro del pago que este usuario registro
  historialEstadosActuados            OrdenHistorialEstado[]    @relation("HistorialActor") // feature 49/R21: transiciones de estado que este usuario (actor) origino
  cierreDetallesTienda                CierreDetail[]            @relation("CierreDetailTienda") // feature 69/R6: snapshots que congelaron a esta tienda como destinataria
  apiKey                              ApiKey?                   @relation("ApiKeyUsuario") // feature 81/[D6]: la key dedicada a ESTA cuenta sintetica (1:1)
  apiKeysCreadas                      ApiKey[]                  @relation("ApiKeyCreadaPor") // feature 81/R21: keys que este usuario (maestro) genero
  rutaOptimizada                      RutaOptimizada?           @relation("RutaOptimizadaMensajero") // feature 92/R26: ruta optimizada vigente de ESTE mensajero (1:1)
  plantillasCreadas                   PlantillaMensaje[]        @relation("PlantillaMensajeCreador") // feature 107/R8: plantillas de mensaje que este usuario (maestro) creo
  webhookSuscripcion                  WebhookSuscripcion?       @relation("WebhookSuscripcionOwner") // feature 99/R1: suscripcion de webhook de ESTE owner (usuario dedicado de la API key); 1:1

  @@index([tipoIdentificacionId])
  @@index([rolId])
  @@index([vehiculoId]) // feature 21
  @@index([zonaId]) // feature 24/R6
  @@index([ordenEnGestionId]) // feature 36
  @@map("usuario")
}

// Feature 107: estado de una plantilla de mensaje. Enum Postgres nativo (patron
// EstadoTarifa/RolValue). Cuatro valores EXACTOS (R23). `pending` (estado inicial,
// Decision humana 1) y `refused` quedan RESERVADOS en el enum aunque este alcance NO
// los transiciona desde el front; el front SOLO emite el destino `inactivo` (R24/R25).
enum PlantillaEstado {
  activo
  inactivo
  pending
  refused

  @@map("plantilla_estado")
}

// Feature 107: plantilla de mensaje con cuerpo que admite campos variables `{{clave}}`.
// Configuracion MUTABLE (lleva updatedAt). SOFT DELETE via `deletedAt` (Decision humana
// 3; R27/R28): los listados filtran `deletedAt IS NULL`. El conjunto de variables usadas
// por el cuerpo se persiste como ARRAY de claves (Decision humana 4; R15), text[] nativo.
model PlantillaMensaje {
  id        String          @id @default(uuid())
  nombre    String          @unique // R10: identificador unico
  cuerpo    String // texto con placeholders {{clave}}
  variables String[] // R15: claves detectadas en el cuerpo (text[]), sin duplicados, sincronizadas con `cuerpo`
  estado    PlantillaEstado @default(pending) // R12 (Decision humana 1)
  createdBy String?         @map("created_by") // FK -> usuario (maestro actor); SET NULL al borrar el usuario
  deletedAt DateTime?       @map("deleted_at") // R27: soft delete; NULL = vigente
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  creador Usuario? @relation("PlantillaMensajeCreador", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdAt]) // R6: orden determinista del listado
  @@index([estado]) // filtro por estado
  @@index([deletedAt]) // R28: filtro de vigentes (deletedAt IS NULL)
  @@map("plantilla_mensaje")
}

// Feature 21: documentos de postulacion del mensajero. 1:N (5 tipos por usuario).
// El binario vive en Supabase Storage (bucket privado); aqui solo el path/metadatos.
model MensajeroDocumento {
  id          String                 @id @default(uuid())
  usuarioId   String                 @map("usuario_id")
  tipo        MensajeroDocumentoTipo
  storagePath String                 @map("storage_path") // path en el bucket privado, NO URL publica (R18)
  contentType String                 @map("content_type") // image/jpeg | image/png | image/webp
  createdAt   DateTime               @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo]) // R16: un documento por tipo por usuario
  @@index([usuarioId])
  @@map("mensajero_documento")
}

enum MensajeroDocumentoTipo {
  cedula_anverso
  cedula_reverso
  propiedad_anverso
  propiedad_reverso
  foto_rostro

  @@map("mensajero_documento_tipo")
}

model LoginAttempt {
  id         String   @id @default(uuid())
  usuarioId  String?  @map("usuario_id") // null si el email no resolvio a usuario
  emailUsado String   @map("email_usado")
  exitoso    Boolean
  ipAddress  String   @map("ip_address")
  userAgent  String   @map("user_agent")
  riskScore  Int      @map("risk_score")
  riskReason String   @map("risk_reason") // resumen de senales usadas
  createdAt  DateTime @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempt")
}

model TrustedDevice {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  deviceHash String   @map("device_hash") // hash de fingerprint (UA + atributos), nunca PII cruda
  ipAddress  String   @map("ip_address")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, deviceHash])
  @@index([usuarioId])
  @@map("trusted_device")
}

// Challenge OTP por email para el paso adicional de RBA (R17-R20).
model EmailOtpChallenge {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  codeHash   String    @map("code_hash") // hash del codigo OTP, nunca el codigo en claro
  deviceHash String    @map("device_hash") // dispositivo a confiar si el OTP se supera (R19)
  ipAddress  String    @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
  @@map("email_otp_challenge")
}

// Catalogo de estatus de orden (tabla, no enum Postgres; R1). Seed idempotente
// por `value` (8 valores, ORDER_STATUS_SEED), patron rol/tipo_identificacion.
model OrderStatus {
  id    String @id @default(uuid())
  value String @unique // seed (8): entregada, devuelta, devuelta_origen,
  //   reprogramada, en_fulfillment, en_ruta_bodega_principal, en_bodega, en_preparacion

  ordenes Orden[]

  historialComoOrigen  OrdenHistorialEstado[] @relation("HistorialOrigen") // feature 49: transiciones que SALEN de este estado
  historialComoDestino OrdenHistorialEstado[] @relation("HistorialDestino") // feature 49: transiciones que ENTRAN a este estado

  @@map("order_status")
}

// Geografia jerarquica (feature 6 la creo vacia). Feature 24: la zona pasa a ser un
// catalogo global con pagos al mensajero y flag `es_gam`. Feature 24/R4: la zona ya
// NO cuelga de la provincia; la asignacion vive en `distrito.zona_id` (escalar) mas
// la relacion N:M `ZonaDistrito`. La columna `provincia.zona_id` fue ELIMINADA en la
// DB por la migracion 20260711120000_zonas_catalogo_global_pagos y nunca re-creada;
// feature 55 (F1.4-C) reconcilia el schema removiendo los simbolos huerfanos
// (`Provincia.zonaId`/`Provincia.zona`/`Zona.provincias`). La carga masiva (feature
// 15) deriva `orden.zona_id` del DISTRITO de la orden (`distrito.zona_id`).
model Zona {
  id            String  @id @default(uuid())
  nombre        String  @unique // feature 24: nombre unico (indice zona_nombre_key); feature 54 restaura el @unique perdido en el refactor
  cobroVehiculo Boolean @default(false) @map("cobro_vehiculo") // feature 24: cobro extra por vehiculo en esta zona
  esCentral     Boolean @default(false) @map("es_central") // feature 54: flag de zona central (renombrado del viejo es_gam); a lo sumo una via indice unico parcial

  ordenes              Orden[]
  tarifaZonaMensajeros TarifaZonaMensajero[]
  distritos            ZonaDistrito[] // feature 24: relacion N:M con distrito
  usuarios             Usuario[] // feature 54: lado opuesto de Usuario.zona (mensajero/adminSatelite)
  cierresDestino       CierreDia[] // feature 37: cierres cuyo destino_zona_id apunta a esta zona
  cierresBodega        CierreBodega[] // feature 40: cierres de bodega de esta zona satelite
  cierreDetalles       CierreDetail[] // feature 69/R6: snapshots que congelaron esta zona

  @@map("zona")
}

model Provincia {
  id     String @id @default(uuid())
  nombre String
  // feature 55 (F1.4-C): `provincia.zona_id` fue ELIMINADO en la DB (la zona ya no
  // cuelga de la provincia; la asignacion vive en distrito.zona_id + N:M ZonaDistrito).

  cantones Canton[]
  ordenes  Orden[]

  @@map("provincia")
}

model Canton {
  id          String @id @default(uuid())
  nombre      String
  provinciaId String @map("provincia_id")

  provincia Provincia  @relation(fields: [provinciaId], references: [id])
  distritos Distrito[]
  ordenes   Orden[]

  @@index([provinciaId])
  @@map("canton")
}

model Distrito {
  id       String @id @default(uuid())
  nombre   String
  cantonId String @map("canton_id")

  canton  Canton         @relation(fields: [cantonId], references: [id])
  ordenes Orden[]
  zonas   ZonaDistrito[] // feature 24: relacion N:M con zona (unica fuente de verdad; la columna escalar zona_id se elimino en 20260713000000)

  @@index([cantonId])
  @@map("distrito")
}

// Feature 24 (redefinida): tabla puente N:M zona <-> distrito. Par (zona, distrito)
// unico. ON DELETE CASCADE en ambas FKs (ver migracion zona_distrito_nm).
model ZonaDistrito {
  id         String @id @default(uuid())
  zonaId     String @map("zona_id")
  distritoId String @map("distrito_id")

  zona     Zona     @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  distrito Distrito @relation(fields: [distritoId], references: [id], onDelete: Cascade)

  @@unique([zonaId, distritoId])
  @@index([zonaId])
  @@index([distritoId])
  @@map("zona_distrito")
}

// Orden de negocio (R7-R14a). Borrado logico via deleted_at (soft delete).
model Orden {
  id                     String    @id @default(uuid())
  numGuia                Int?      @unique @map("num_guia") // feature 17/R1: nullable, sin default; asignado en "Generar guia" via nextval(orden_num_guia_seq)
  numRemision            String    @unique @map("num_remision") // R9/R14: lo provee el usuario
  estatusId              String    @map("estatus_id") // R10: FK not null
  destinatario           String
  telefonoDest           String    @map("telefono_dest")
  tiendaId               String    @map("tienda_id") // R11: FK -> usuario, not null
  zonaId                 String    @map("zona_id") // R12: NOT NULL
  provinciaId            String    @map("provincia_id") // R12: NOT NULL
  cantonId               String    @map("canton_id") // R12: NOT NULL
  distritoId             String?   @map("distrito_id") // R12: nullable (unico FK nullable)
  producto               String
  peso                   Decimal?  @db.Decimal(10, 3) // feature 15/R4: nullable (carga masiva sin peso)
  notas                  String? // R14a: texto nullable
  direccion              String? // feature 15/R1: nuevo, carga masiva
  montoCobrar            Decimal?  @map("monto_cobrar") @db.Decimal(12, 2) // feature 15/R1
  mensajeroSugeridoId    String?   @map("mensajero_sugerido_id") // feature 15/R1/R2: SUGERENCIA de la carga masiva
  mensajeroAsignadoId    String?   @map("mensajero_asignado_id") // feature 17/R7: mensajero ASIGNADO (decision del maestro), distinto del sugerido
  asignadoAt             DateTime? @map("asignado_at") // feature 76/R23/R24: instante de la ultima (re)asignacion de mensajero (NULL = nunca asignado / historicas); fuente del denominador del ranking diario
  cobraComision          Boolean   @default(true) @map("cobra_comision") // feature 42/R26: la orden lleva cobro de comision COD (default true = retro-compatible); la 42 la LEE (no la captura editable, deuda A5)
  prioridad              Boolean   @default(false) @map("prioridad") // feature 101/R1: flag de reasignacion prioritaria (ON al liberar por SLA 99, OFF al reasignar mensajero desde bodega); default false = sin backfill (R11)
  liberadaReprogramadaAt DateTime? @map("liberada_reprogramada_at") // feature 46/R13/R18: instante de liberacion programada (NULL = nunca liberada por reprogramacion); auditoria + fuente del aviso derivado
  // Feature 91 (design §1.1, R1): resultado de la geocodificacion de `direccion`. TODAS
  // nullable: una orden sin geocodificar las tiene vacias. `geocode_precision` y
  // `geocode_status` son String? y NO enums nativos a proposito: son vocabulario OPACO del
  // proveedor (OK / ZERO_RESULTS / ROOFTOP / APPROXIMATE / ...), ampliable por Google sin
  // avisar; un enum obligaria a un ALTER TYPE por cada valor nuevo. Sin indice: no hay
  // consumidor todavia (design §1.1).
  latitud                Decimal?  @db.Decimal(10, 7)
  longitud               Decimal?  @db.Decimal(10, 7)
  geocodedAt             DateTime? @map("geocoded_at")
  geocodePrecision       String?   @map("geocode_precision")
  geocodeStatus          String?   @map("geocode_status")
  deletedAt              DateTime? @map("deleted_at") // soft delete
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  estatus           OrderStatus @relation(fields: [estatusId], references: [id])
  tienda            Usuario     @relation("OrdenTienda", fields: [tiendaId], references: [id])
  zona              Zona        @relation(fields: [zonaId], references: [id])
  provincia         Provincia   @relation(fields: [provinciaId], references: [id])
  canton            Canton      @relation(fields: [cantonId], references: [id])
  distrito          Distrito?   @relation(fields: [distritoId], references: [id])
  mensajeroSugerido Usuario?    @relation("OrdenMensajeroSugerido", fields: [mensajeroSugeridoId], references: [id])
  mensajeroAsignado Usuario?    @relation("OrdenMensajeroAsignado", fields: [mensajeroAsignadoId], references: [id], onDelete: SetNull) // feature 17/R7

  gestiones             GestionOrden[] // feature 36: gestiones registradas sobre esta orden
  mensajerosGestionando Usuario[]              @relation("UsuarioOrdenEnGestion") // feature 36: lado inverso del puntero de bloqueo 1-a-1
  historialEstados      OrdenHistorialEstado[] // feature 49: linea de tiempo append-only de transiciones (R1/R5)
  cierreDetalles        CierreDetail[] // feature 69/R1: snapshots congelados de esta orden (uno por cierre en que aparecio)
  rutaParadas           RutaOptimizadaParada[] // feature 92/R26: posicion de esta orden en la ruta optimizada de su mensajero

  @@index([tiendaId])
  @@index([estatusId])
  @@index([createdAt])
  @@index([mensajeroSugeridoId])
  @@index([mensajeroAsignadoId]) // feature 17/R7
  @@index([mensajeroAsignadoId, asignadoAt]) // feature 76/R1: denominador del ranking diario (asignadas HOY por mensajero)
  @@map("orden")
}

// Feature 36 (R5, decision F1.4-c): metodo de pago del recaudo al cliente en una
// ENTREGA. Enum Postgres nativo (patron RolValue/VehiculoValue), fuente unica de
// verdad reflejada en lib/types/metodo-pago.ts. OJO 'SINPE' en mayusculas (medio de
// pago de Costa Rica). Feature 118: corregido el typo historico del valor via
// ALTER TYPE ... RENAME VALUE (migracion _metodo_pago_rename_simpe_to_sinpe).
enum MetodoPagoValue {
  efectivo
  SINPE
  transferencia

  @@map("metodo_pago_value")
}

// Feature 36 (R6, decision F1.4-d): discriminador del resultado de una gestion.
enum GestionResultado {
  entregada
  reprogramada
  devuelta
  rechazada

  @@map("gestion_resultado")
}

// Feature 73 (R1, decision F1.4-d): causa TIPIFICADA de una devolucion — lista CERRADA de 3
// valores, sin "Otro" y sin reservar futuros (anadir una 4.ª causa el dia que se pida es un
// `ALTER TYPE ... ADD VALUE`, aditivo y barato). Los valores van en INGLES aunque el enum
// hermano `gestion_resultado` los tenga en espanol: decision CONSCIENTE del humano aceptada
// en la gate (F1.4-g), NO es deuda tecnica ni un descuido — no abrir tickets de
// "consistencia" por esto. El front traduce (R3, `causa-devolucion-options.ts`).
enum GestionCausaDevolucion {
  not_found // Cliente no localizado
  wrong_number // Numero de celular errado
  wrong_address // Direccion errada

  @@map("gestion_causa_devolucion")
}

// Feature 36 (R6-R8, decision F1.4-d): UN registro por gestion de orden, con un
// discriminador `resultado` y campos NULLABLE segun resultado. La evidencia se
// guarda como `storage_path` de un bucket PRIVADO (nunca URL publica, R8); se
// firma al mostrar. RLS habilitada sin policies (solo service role, patron
// mensajero_documento/orden). Una orden puede acumular varias gestiones a lo
// largo de reintentos (features 46/47): NO se fuerza @@unique(ordenId).
model GestionOrden {
  id                   String                  @id @default(uuid())
  ordenId              String                  @map("orden_id") // FK -> orden
  mensajeroId          String                  @map("mensajero_id") // FK -> usuario (el actor)
  resultado            GestionResultado
  montoRecibido        Decimal?                @map("monto_recibido") @db.Decimal(12, 2) // ENTREGADA
  metodoPago           MetodoPagoValue?        @map("metodo_pago") // ENTREGADA
  evidenciaStoragePath String?                 @map("evidencia_storage_path") // ENTREGADA/RECHAZO: path bucket privado, NO URL
  evidenciaContentType String?                 @map("evidencia_content_type") // image/jpeg|png|webp
  motivo               String? // REPROGRAMAR/DEVOLUCION/RECHAZO
  fechaReprogramacion  DateTime?               @map("fecha_reprogramacion") @db.Date // REPROGRAMAR
  // Feature 73/R11 (F1.4-a): DEVOLUCION. NULLABLE como el resto de campos por rama: NULL =
  // gestion no-`devuelta`, o `devuelta` anterior a la feature 73 (el historico NO se
  // backfillea, R16). La obligatoriedad vive en el BORDE (zod, R6), sin CHECK en la base
  // (F1.4-b), igual que monto_recibido/metodo_pago/evidencia de la 36.
  // OJO (F1.4-c): esta columna nace de SOLO ESCRITURA por decision APROBADA del humano —
  // nadie la lee en este ciclo. Que no tenga consumidores NO es codigo muerto ni un olvido:
  // es el estado esperado. Mostrarla/agruparla es follow-up (ver requirements.md §F1.4-c).
  causaDevolucion      GestionCausaDevolucion? @map("causa_devolucion") // DEVOLUCION
  cierreId             String?                 @map("cierre_id") // feature 37/R13: nullable; NULL = gestion del dia aun no cerrada
  pagoMensajero        Decimal?                @map("pago_mensajero") @db.Decimal(12, 2) // feature 39/R12: snapshot del pago al mensajero; NULL mientras no se cierra
  ingresoBodegaRechazo Decimal?                @map("ingreso_bodega_rechazo") @db.Decimal(12, 2) // feature 56/R11: snapshot del ingreso de bodega por rechazo; NULL mientras no se cierra
  anuladaAt            DateTime?               @map("anulada_at") // feature 67/R11: instante de la anulacion; NULL = gestion VIGENTE (patron cierre_id IS NULL de la 37)
  anuladaPor           String?                 @map("anulada_por") // feature 67/R11: FK -> usuario que la deshizo (espejo de cierre_dia.resuelto_por)
  createdAt            DateTime                @default(now()) @map("created_at")

  orden             Orden                  @relation(fields: [ordenId], references: [id])
  mensajero         Usuario                @relation("GestionMensajero", fields: [mensajeroId], references: [id])
  cierre            CierreDia?             @relation(fields: [cierreId], references: [id]) // feature 37/R13: cierre que agrupa esta gestion
  // Feature 67/R11: quien deshizo la gestion. ON DELETE SET NULL como el actor del historial
  // (49/R21): borrar al usuario no borra el rastro de la anulacion.
  anuladaPorUsuario Usuario?               @relation("GestionAnuladaPor", fields: [anuladaPor], references: [id], onDelete: SetNull)
  historialEstados  OrdenHistorialEstado[] // feature 49: transiciones de estado causadas por esta gestion (familia gestion)

  @@index([ordenId]) // R7
  @@index([mensajeroId]) // R7
  @@index([cierreId]) // feature 37/R3: listar gestiones sin cierre (cierre_id IS NULL)
  @@index([anuladaPor]) // feature 67: FK del actor de la anulacion
  // Feature 67 (F1.4-d): el indice PARCIAL de la ruta caliente
  // `(mensajero_id) WHERE cierre_id IS NULL AND anulada_at IS NULL` (/cierre-dia + corte
  // diario) NO se expresa aqui: Prisma no soporta indices parciales -> vive en el SQL de la
  // migracion `*_gestion_orden_anulacion` (patron orden_liberada_reprogramada_at_idx).
  @@map("gestion_orden")
}

// Feature 37 (R13/R18, decision F1.4-d): estado del cierre del dia del mensajero.
// La 37 SOLO crea en `solicitado`; `aprobado`/`rechazado` se reservan para la
// feature 38 (patron "reservar valores del enum"). Fuente unica de verdad en
// lib/types/cierre.ts (CIERRE_ESTADO_SEED).
enum CierreEstado {
  solicitado
  aprobado
  rechazado
  vencido // feature 41 (R2): lo crea el corte diario; bloqueante y resoluble como solicitado

  @@map("cierre_estado")
}

// Feature 37 (R15, decision F1.4-e): destino derivado del cierre segun la zona del
// mensajero. `bodega_central` si la zona es la central (findCentralZonaId);
// `bodega_satelite` en caso contrario.
enum CierreDestinoTipo {
  bodega_central
  bodega_satelite

  @@map("cierre_destino_tipo")
}

// Feature 37 (R13-R16/R18/R19, decision F1.4-a,e,f): UN registro por solicitud de
// cierre del dia de un mensajero. Los totales por metodo de pago + general se
// SNAPSHOTEAN al crear (R14, money-critical); el detalle se deriva de las
// gestion_orden vinculadas (cierre_id). Destino derivado server-side al solicitar
// (para la feature 38). RLS habilitada sin policies (solo service role, patron
// gestion_orden/orden).
model CierreDia {
  id                         String            @id @default(uuid())
  mensajeroId                String            @map("mensajero_id") // FK -> usuario (el actor)
  estado                     CierreEstado      @default(solicitado)
  destinoTipo                CierreDestinoTipo @map("destino_tipo") // central/satelite derivado al solicitar
  destinoZonaId              String            @map("destino_zona_id") // zona del mensajero (central o satelite)
  totalEfectivo              Decimal           @default(0) @map("total_efectivo") @db.Decimal(12, 2) // snapshot R14
  totalSimpe                 Decimal           @default(0) @map("total_simpe") @db.Decimal(12, 2) // snapshot R14
  totalTransferencia         Decimal           @default(0) @map("total_transferencia") @db.Decimal(12, 2) // snapshot R14
  totalGeneral               Decimal           @default(0) @map("total_general") @db.Decimal(12, 2) // snapshot R14
  totalPagoMensajero         Decimal           @default(0) @map("total_pago_mensajero") @db.Decimal(12, 2) // feature 39/R13: snapshot total del pago al mensajero
  totalIngresoBodegaRechazos Decimal           @default(0) @map("total_ingreso_bodega_rechazos") @db.Decimal(12, 2) // feature 56/R12: snapshot total del ingreso de bodega por rechazos
  solicitadoAt               DateTime          @default(now()) @map("solicitado_at")
  resueltoPor                String?           @map("resuelto_por") // feature 38/R14: FK -> usuario (admin actor); NULL mientras solicitado
  resueltoAt                 DateTime?         @map("resuelto_at") // feature 38/R14: marca de tiempo de la resolucion
  motivoRechazo              String?           @map("motivo_rechazo") // feature 38/R11: obligatorio SOLO al rechazar; NULL en aprobado/solicitado
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  cierreBodegaId String? @map("cierre_bodega_id") // feature 40: nullable; NULL = cierre_dia aun no consolidado en bodega

  mensajero          Usuario        @relation("CierreMensajero", fields: [mensajeroId], references: [id])
  destinoZona        Zona           @relation(fields: [destinoZonaId], references: [id])
  resueltoPorUsuario Usuario?       @relation("CierreResueltoPor", fields: [resueltoPor], references: [id]) // feature 38/R14
  cierreBodega       CierreBodega?  @relation(fields: [cierreBodegaId], references: [id], onDelete: SetNull) // feature 40
  gestiones          GestionOrden[] // gestiones incluidas en este cierre (cierre_id)
  detalle            CierreDetail[] // feature 69/R1: snapshot congelado por orden de este cierre

  @@index([mensajeroId])
  @@index([destinoTipo, destinoZonaId]) // feature 38: filtra por rol+zona destino
  @@index([estado])
  @@index([resueltoPor]) // feature 38/R14: auditoria de quien resolvio
  @@index([cierreBodegaId]) // feature 40: listar consolidables (cierre_bodega_id IS NULL)
  @@index([mensajeroId, estado]) // feature 41 (R12/R23): bloqueo derivado del mensajero (ruta caliente de asignacion)
  @@map("cierre_dia")
}

// Feature 40 (R8-R10/R16-R22, decision F1.4-a,b,e,g,k): cierre de NIVEL BODEGA. El
// adminSatelite consolida los cierre_dia `aprobado` de su zona y solicita el cierre a
// la bodega central; el maestro lo aprueba/rechaza. Reusa el enum CierreEstado (37).
// Totales agregados SNAPSHOT (money-critical, R10). Auditoria del maestro (patron 38,
// R20). Indice unico parcial (zona_id) WHERE estado='solicitado' + RLS habilitada sin
// policies van a mano en el SQL de la migracion (Prisma no los expresa).
model CierreBodega {
  id                         String       @id @default(uuid())
  zonaId                     String       @map("zona_id") // zona satelite que cierra
  solicitadoPor              String       @map("solicitado_por") // adminSatelite actor (FK usuario)
  estado                     CierreEstado @default(solicitado) // reuso enum feature 37 (F1.4-b)
  totalEfectivo              Decimal      @default(0) @map("total_efectivo") @db.Decimal(12, 2) // snapshot agregado R10
  totalSimpe                 Decimal      @default(0) @map("total_simpe") @db.Decimal(12, 2) // snapshot agregado R10
  totalTransferencia         Decimal      @default(0) @map("total_transferencia") @db.Decimal(12, 2) // snapshot agregado R10
  totalGeneral               Decimal      @default(0) @map("total_general") @db.Decimal(12, 2) // snapshot agregado R10
  totalPagoMensajero         Decimal      @default(0) @map("total_pago_mensajero") @db.Decimal(12, 2) // feature 39/R19: snapshot agregado del pago a mensajeros
  totalIngresoBodegaRechazos Decimal      @default(0) @map("total_ingreso_bodega_rechazos") @db.Decimal(12, 2) // feature 56/R18: snapshot agregado del ingreso de bodega por rechazos
  solicitadoAt               DateTime     @default(now()) @map("solicitado_at")
  resueltoPor                String?      @map("resuelto_por") // maestro actor; NULL mientras solicitado (R20)
  resueltoAt                 DateTime?    @map("resuelto_at") // marca de tiempo de la resolucion (R20)
  motivoRechazo              String?      @map("motivo_rechazo") // obligatorio SOLO al rechazar (R17); NULL si aprobado/solicitado
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  zona                 Zona        @relation(fields: [zonaId], references: [id])
  solicitadoPorUsuario Usuario     @relation("CierreBodegaSolicitadoPor", fields: [solicitadoPor], references: [id])
  resueltoPorUsuario   Usuario?    @relation("CierreBodegaResueltoPor", fields: [resueltoPor], references: [id])
  cierresDia           CierreDia[] // los cierre_dia incluidos (cierre_bodega_id)

  @@index([zonaId])
  @@index([estado])
  @@index([solicitadoPor])
  @@index([resueltoPor])
  @@map("cierre_bodega")
}

// Tarifa: tarifas de flete/comision, tabla multi-fila con `nombre` para
// distinguirlas (feature 18, D1). zona_id NOT NULL: cada tarifa pertenece a una
// zona (feature 24). Se agrego via la migracion de rename cuando la tabla estaba
// vacia. Borrado logico via deleted_at.
model Tarifa {
  id                    String       @id @default(uuid())
  valorFlete            Decimal      @map("valor_flete") @db.Decimal(12, 2) // R2 (monto)
  valorFleteDevuelto    Decimal      @map("valor_flete_devuelto") @db.Decimal(12, 2) // R2 (monto)
  valorFleteGam         Decimal      @map("valor_flete_gam") @db.Decimal(12, 2) // R2/R4 (GAM -> gam)
  valorFleteDevueltoGam Decimal      @map("valor_flete_devuelto_gam") @db.Decimal(12, 2) // R2/R4
  fulfillment           Decimal      @db.Decimal(12, 2) // R2/D3 (monto)
  comisionCod           Decimal      @map("comision_cod") @db.Decimal(5, 2) // R3/D3 (porcentaje 0..100)
  ivaFlete              Decimal      @map("iva_flete") @db.Decimal(5, 2) // R3/D2 (porcentaje 0..100)
  ivaComisionCod        Decimal      @map("iva_comision_cod") @db.Decimal(5, 2) // R3/D2 (porcentaje 0..100)
  tiendaId              String       @map("tienda_id") // FK -> usuario (tienda duena; el service exige rol adminTienda)
  status                EstadoTarifa @default(activo) // activo/inactivo; pasa a inactivo si la tienda deja de ser adminTienda
  deletedAt             DateTime?    @map("deleted_at") // soft delete (R19/R24)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  tienda         Usuario        @relation("TarifaTienda", fields: [tiendaId], references: [id])
  cierreDetalles CierreDetail[] // feature 69/R8: cierres que liquidaron contra ESTA fila de tarifa (hace auditable la deuda (g))

  @@index([createdAt])
  @@index([tiendaId])
  @@map("tarifas")
}

enum EstadoTarifa {
  activo
  inactivo

  @@map("estado_tarifa")
}

// TarifaZonaMensajero: tarifa de comision por zona pagada al mensajero
// (feature 24). vehiculo_id nullable (tarifa general de la zona si no aplica
// por tipo de vehiculo); zona_id obligatoria.
model TarifaZonaMensajero {
  id             String  @id @default(uuid())
  cobroEntregado Decimal @map("cobro_entregado") @db.Decimal(12, 2)
  cobroRechazado Decimal @map("cobro_rechazado") @db.Decimal(12, 2)
  vehiculoId     String? @map("vehiculo_id")
  zonaId         String  @map("zona_id")

  vehiculo Vehiculo? @relation(fields: [vehiculoId], references: [id])
  zona     Zona      @relation(fields: [zonaId], references: [id])

  // feature 24: una sola tarifa por (zona, vehiculo). El indice en SQL usa
  // NULLS NOT DISTINCT (PG15+), de modo que a lo sumo exista UNA tarifa por
  // defecto (vehiculo_id NULL) por zona, haciendo determinista la resolucion
  // "sin vehiculo -> tarifa por defecto de la zona". Prisma no expresa
  // NULLS NOT DISTINCT: ver la migracion tarifa_zona_mensajero_zona_vehiculo_unique.
  @@unique([zonaId, vehiculoId])
  @@index([vehiculoId])
  @@index([zonaId])
  @@map("tarifa_zona_mensajero")
}

// Catalogo de tipos de vehiculo (feature 50). Backed por enum Postgres
// vehiculo_value. OJO: columna "name" (NO "value" como rol/order_status/tipo_id).
// El id (uuid PK) queda listo para el FK usuario.vehiculo_id de la feature 21
// (NO se implementa ese FK aqui). Solo-lectura sembrado (P1=A), sin escritura.
model Vehiculo {
  id   String        @id @default(uuid())
  name VehiculoValue @unique // seed (3): moto, carro, camion

  usuarios             Usuario[] // feature 21: mensajeros que declararon este vehiculo
  tarifaZonaMensajeros TarifaZonaMensajero[] // feature 24

  @@map("vehiculos")
}

enum VehiculoValue {
  moto
  carro
  camion

  @@map("vehiculo_value")
}

// Feature 42 (design §1.1): tipo del movimiento de la wallet. El signo del balance lo
// da `tipo`; el `monto` es SIEMPRE positivo. Enum Postgres nativo (patron RolValue).
enum WalletMovimientoTipo {
  ingreso
  egreso

  @@map("wallet_movimiento_tipo")
}

// Feature 42 (design §1.1): categoria (concepto) del movimiento. La 42 SOLO EMITE
// categorias `ingreso_*` (los 6 conceptos de Ordenex + `ingreso_ajuste` manual). Las
// `egreso_*` quedan RESERVADAS para 43/44/45 (patron "reservar valores del enum" de la
// feature 37), disponibles sin nueva migracion de enum.
enum WalletMovimientoCategoria {
  ingreso_flete // entregada: valorFlete[Gam]
  ingreso_flete_devolucion // devuelta/rechazada: valorFleteDevuelto[Gam] (A1)
  ingreso_comision_cod // entregada + orden.cobraComision (Q1)
  ingreso_iva_flete // ivaFlete% sobre flete
  ingreso_iva_flete_devolucion // ivaFlete% sobre flete de devolucion (A1)
  ingreso_iva_comision_cod // ivaComisionCod% sobre comision (solo si hubo comision)
  ingreso_ajuste // manual (F1.4-Q6)
  egreso_pago_tienda // reservado feature 43
  egreso_pago_mensajero // reservado feature 44
  egreso_gasto // feature 42: reservado; queda SIN USO en la 45 (Postgres no permite DROP VALUE)
  egreso_sueldo // feature 45: sueldo (registro manual)
  egreso_ajuste // manual (F1.4-Q6)
  egreso_gasto_fijo // feature 45: gasto fijo (lo EMITE el cron mensual, no el form manual)
  egreso_gasto_variable // feature 45: gasto variable (registro manual)

  @@map("wallet_movimiento_categoria")
}

// Feature 42 (design §1.1): tipo de origen polimorfico. `cierre_dia` = ingreso por
// cierre aprobado (42); `manual` = ajuste del maestro (origen_id NULL). El resto queda
// RESERVADO para 43/44/45.
enum WalletOrigenTipo {
  cierre_dia
  gestion_orden
  manual
  pago_tienda
  pago_mensajero
  gasto

  @@map("wallet_origen_tipo")
}

// Feature 42 (design §1.2): LIBRO append-only de movimientos de la wallet (caja
// PRINCIPAL de Ordenex). Fila INMUTABLE (R1/R3): SIN updatedAt/deletedAt, sin soft
// delete; una correccion se hace con un movimiento de ajuste compensatorio, nunca
// alterando el original. El balance se DERIVA (SUM ingreso - SUM egreso), no se almacena
// (R16). Idempotencia por indice unico parcial (origen_tipo, origen_id, categoria) WHERE
// origen_id IS NOT NULL — va a mano en la migracion (Prisma no expresa indice parcial).
// RLS habilitada sin policies (solo service role, patron gestion_orden/cierre_dia).
model WalletMovimiento {
  id              String                    @id @default(uuid())
  tipo            WalletMovimientoTipo
  categoria       WalletMovimientoCategoria
  monto           Decimal                   @db.Decimal(12, 2) // > 0 (siempre positivo; el signo lo da `tipo`)
  origenTipo      WalletOrigenTipo          @map("origen_tipo")
  origenId        String?                   @map("origen_id") // NULL solo para origen_tipo = manual
  descripcion     String? // obligatoria en manual (validacion en service/zod)
  registradoPor   String?                   @map("registrado_por") // FK usuario (actor) en manual; NULL en automaticos
  fechaMovimiento DateTime                  @default(now()) @map("fecha_movimiento")
  createdAt       DateTime                  @default(now()) @map("created_at")
  // SIN updatedAt / deletedAt: la fila es INMUTABLE (R3). No hay soft-delete.

  registrador Usuario? @relation("WalletMovimientoRegistrador", fields: [registradoPor], references: [id])

  @@index([fechaMovimiento]) // R24: listado del libro por fecha (desc)
  @@index([tipo, categoria]) // R24: filtros por tipo/categoria
  @@index([origenTipo, origenId]) // R24: buscar movimientos de un origen
  @@map("wallet_movimiento")
}

// Feature 43 (design §1.1): tipo del movimiento del ledger POR TIENDA. `credito` = a favor
// de la tienda (COD recaudado); `debito` = descuento de Ordenex (flete/comision/IVAs) o pago
// a la tienda. El signo del saldo lo da `tipo`; `monto` es SIEMPRE positivo. Enum Postgres
// nativo (patron WalletMovimientoTipo).
enum WalletTiendaMovimientoTipo {
  credito
  debito

  @@map("wallet_tienda_movimiento_tipo")
}

// Feature 43 (design §1.1): categoria (concepto) del movimiento por tienda. Los 6 debitos
// son ESPEJO 1:1 de los 6 conceptos de ingreso de la 42 (R8). `cod_recaudado` es el credito
// (Q2). `pago_tienda` queda RESERVADO para el follow-up de pago/liquidacion (F1.4-Q4).
// `ajuste_credito`/`ajuste_debito` = correccion compensatoria inmutable (R3/R29).
enum WalletTiendaMovimientoCategoria {
  // credito (a favor de la tienda)
  cod_recaudado
  // debitos (espejo 1:1 de los 6 conceptos de ingreso de la 42, R8)
  flete
  flete_devolucion
  comision_cod
  iva_flete
  iva_flete_devolucion
  iva_comision_cod
  // pago/liquidacion (F1.4-Q4; RESERVADO aunque el pago sea follow-up)
  pago_tienda
  // ajustes manuales (inmutables, correccion compensatoria R3/R29)
  ajuste_credito
  ajuste_debito

  @@map("wallet_tienda_movimiento_categoria")
}

// Feature 43 (design §1.2): LEDGER append-only del saldo POR TIENDA (cuanto le debe ENTREGAR
// Ordenex a cada tienda). Fila INMUTABLE (R1/R3): SIN updatedAt/deletedAt; una correccion es
// un movimiento de ajuste compensatorio, nunca alterando el original. El saldo se DERIVA
// (SUM credito - SUM debito), no se almacena (R16). Idempotencia por indice unico parcial
// (origen_tipo, origen_id, tienda_id, categoria) WHERE origen_id IS NOT NULL — va a mano en
// la migracion (Prisma no expresa indice parcial). RLS habilitada sin policies (solo service
// role, patron wallet_movimiento/cierre_dia), acotado por tienda en el WHERE (R19/R24).
model WalletTiendaMovimiento {
  id              String                          @id @default(uuid())
  tiendaId        String                          @map("tienda_id") // FK -> usuario (rol adminTienda)
  tipo            WalletTiendaMovimientoTipo
  categoria       WalletTiendaMovimientoCategoria
  monto           Decimal                         @db.Decimal(12, 2) // > 0 (el signo lo da `tipo`)
  origenTipo      WalletOrigenTipo                @map("origen_tipo") // cierre_dia | pago_tienda | manual
  origenId        String?                         @map("origen_id") // NULL solo en manual
  descripcion     String?
  registradoPor   String?                         @map("registrado_por") // FK usuario (actor) en manual; NULL en automaticos
  fechaMovimiento DateTime                        @default(now()) @map("fecha_movimiento")
  createdAt       DateTime                        @default(now()) @map("created_at")
  // SIN updatedAt / deletedAt: la fila es INMUTABLE (R3). No hay soft-delete.

  tienda      Usuario  @relation("WalletTiendaMovimientoTienda", fields: [tiendaId], references: [id])
  registrador Usuario? @relation("WalletTiendaMovimientoRegistrador", fields: [registradoPor], references: [id])

  @@index([tiendaId, fechaMovimiento]) // R26: saldo/listado por tienda por fecha (desc)
  @@index([tiendaId, categoria]) // R26: filtro por concepto por tienda
  @@index([origenTipo, origenId]) // R26: movimientos de un origen (cierre)
  @@map("wallet_tienda_movimiento")
}

// Feature 44 (design §1.1): tipo del movimiento del LIBRO del pago al mensajero. `devengo` =
// Ordenex le debe al mensajero (aumenta la cuenta por pagar); `pago` = Ordenex ya le entrego
// (tomado del efectivo recaudado, o una liquidacion posterior; reduce la cuenta por pagar). El
// signo del saldo lo da `tipo`; `monto` es SIEMPRE positivo. Enum Postgres nativo (patron
// WalletMovimientoTipo).
enum PagoMensajeroMovimientoTipo {
  devengo
  pago

  @@map("pago_mensajero_movimiento_tipo")
}

// Feature 44 (design §1.1): categoria (concepto) del movimiento del pago al mensajero.
// `pago_devengado` = cierre_dia.total_pago_mensajero (snapshot 39). `pago_efectivo` = min(P,E):
// parte tomada del efectivo recaudado AL APROBAR ("lo ya pagado"). `liquidacion` queda RESERVADO
// para el follow-up de saldar la cuenta por pagar (F1.4-Qf; sin migracion futura).
// `ajuste_devengo`/`ajuste_pago` = correccion compensatoria inmutable (R3).
enum PagoMensajeroMovimientoCategoria {
  // devengo (Ordenex le debe al mensajero)
  pago_devengado
  // pago (lo ya entregado)
  pago_efectivo
  // liquidacion posterior de la cuenta por pagar (F1.4-Qf; RESERVADO)
  liquidacion
  // ajustes manuales (inmutables, correccion compensatoria R3)
  ajuste_devengo
  ajuste_pago

  @@map("pago_mensajero_movimiento_categoria")
}

// Feature 44 (design §1.2): LIBRO append-only del pago POR MENSAJERO (lo que Ordenex le debe y
// lo que ya le pago). Fila INMUTABLE (R1/R3): SIN updatedAt/deletedAt; una correccion es un
// movimiento de ajuste compensatorio, nunca alterando el original. La cuenta por pagar se DERIVA
// (SUM devengo - SUM pago), no se almacena (R14/R16). Idempotencia por indice unico parcial
// (origen_tipo, origen_id, mensajero_id, categoria) WHERE origen_id IS NOT NULL — va a mano en la
// migracion (Prisma no expresa indice parcial). Reutiliza el enum wallet_origen_tipo de la 42
// (cierre_dia | pago_mensajero | manual). RLS habilitada sin policies (solo service role, patron
// wallet_movimiento/cierre_dia), acotado por mensajero en el WHERE (R20/R24).
model PagoMensajeroMovimiento {
  id              String                           @id @default(uuid())
  mensajeroId     String                           @map("mensajero_id") // FK -> usuario (rol mensajero)
  tipo            PagoMensajeroMovimientoTipo
  categoria       PagoMensajeroMovimientoCategoria
  monto           Decimal                          @db.Decimal(12, 2) // > 0 (el signo lo da `tipo`)
  origenTipo      WalletOrigenTipo                 @map("origen_tipo") // cierre_dia | pago_mensajero | manual
  origenId        String?                          @map("origen_id") // NULL solo en manual
  descripcion     String?
  registradoPor   String?                          @map("registrado_por") // FK usuario (actor) en manual; NULL en automaticos
  fechaMovimiento DateTime                         @default(now()) @map("fecha_movimiento")
  createdAt       DateTime                         @default(now()) @map("created_at")
  // SIN updatedAt / deletedAt: la fila es INMUTABLE (R3). No hay soft-delete.

  mensajero   Usuario  @relation("PagoMensajeroMovimientoMensajero", fields: [mensajeroId], references: [id])
  registrador Usuario? @relation("PagoMensajeroMovimientoRegistrador", fields: [registradoPor], references: [id])

  @@index([mensajeroId, fechaMovimiento]) // R26: saldo/listado por mensajero por fecha (desc)
  @@index([origenTipo, origenId]) // R26: movimientos de un origen (cierre)
  @@map("pago_mensajero_movimiento")
}

// Feature 84: unidad de la periodicidad de una plantilla de gasto fijo. Con `periodicidadCantidad`
// expresa el pedido del humano y cualquier otro ciclo: diaria = 1 dias; semanal = 1 semanas;
// quincenal = 2 semanas; mensual = 1 meses; y tambien cada-3-dias, cada-6-meses, etc.
enum PeriodicidadUnidad {
  dias
  semanas
  meses
}

// Feature 45 (design §1.2): plantilla recurrente de GASTO FIJO. CONFIGURACION mutable (NO es
// el libro wallet_movimiento, que es inmutable): SI lleva updatedAt y se edita/activa/
// desactiva. NO se borra (R25): la desactivacion (activa=false) detiene la generacion futura
// y preserva el rastro de que genero cada egreso. El cron DIARIO
// (`/api/cron/generar-gastos-fijos`, `0 6 * * *`) lee las ACTIVAS, filtra las que aplican HOY
// segun su periodicidad (`lib/utils/periodicidad.ts`) y emite un egreso `egreso_gasto_fijo` en
// la caja principal por cada una. RLS habilitada sin policies (solo service role, patron
// wallet_movimiento/wallet_tienda_movimiento, R20).
//
// Feature 84 — periodicidad ARBITRARIA (antes: SIEMPRE mensual dia 1, clavada). Modelo
// unidad + cantidad + fecha de cobro: `fechaCobro` es el PRIMER cobro y el ANCLA del ciclo
// (antes de esa fecha no se cobra nada); los siguientes caen cada `periodicidadCantidad` x
// `periodicidadUnidad` a partir de ella. En `meses` el dia se CLAMPEA al ultimo dia del mes
// (ancla 31 -> 28/feb, 30/abr), nunca se saltea el mes.
//
// IDEMPOTENCIA (ojo, aca se puede duplicar plata): la clave `origen_id` es
// `<plantillaId>:<periodo>` bajo el indice unico parcial (origen_tipo, origen_id, categoria).
// Para `meses` el periodo SIGUE siendo `YYYY-MM` — mismo formato que pre-84, para que la clave
// no cambie en el deploy y no haya doble cobro. Para `dias`/`semanas` es `YYYY-MM-DD`.
// Ver `lib/utils/periodicidad.ts#periodoDe`.
//
// La periodicidad vive SOLO aca (plantilla -> `egreso_gasto_fijo`). Un `egreso_gasto_variable`
// es un movimiento suelto sin plantilla: por construccion, un variable no puede ser periodico.
model GastoFijoPlantilla {
  id                   String             @id @default(uuid())
  concepto             String // nombre/concepto del gasto fijo (obligatorio, no vacio)
  monto                Decimal            @db.Decimal(12, 2) // > 0
  activa               Boolean            @default(true)
  periodicidadUnidad   PeriodicidadUnidad @default(meses) @map("periodicidad_unidad")
  periodicidadCantidad Int                @default(1) @map("periodicidad_cantidad") // CHECK >= 1 en la migracion
  fechaCobro           DateTime           @db.Date @map("fecha_cobro") // ancla: fecha del PRIMER cobro
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([activa]) // cron: WHERE activa = true (R27)
  @@map("gasto_fijo_plantilla")
}

// Feature 76 (R8/R21/design §4.3): tabla de PREMIOS del ranking diario. Exactamente 3
// posiciones (1,2,3), cada una con un monto OPCIONAL en colones. `monto` NULLABLE =
// "sin premio asignado" (R9, decision F1.4-d): NUNCA es cero ni error. Monto-only (sin
// columna `etiqueta`). El ganador NO se guarda: el ocupante del podio se calcula on-read
// (R14/R15) cruzando el ranking con estas filas por posicion. Migracion aditiva con RLS.
model PremioRanking {
  id          String   @id @default(cuid())
  posicion    Int      @unique // 1, 2 o 3 (CHECK en la migracion); UNIQUE garantiza R8
  monto       Decimal? @db.Decimal(12, 2) // NULLABLE = sin premio asignado (R9)
  descripcion String?  @map("descripcion") // feature 76 (cambio de alcance 2026-07-16): rotulo libre opcional por posicion, INDEPENDIENTE del monto (NULLABLE = sin descripcion)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("premio_ranking")
}

// Feature 49 (design §1.2, R23): tipo de ORIGEN de una transicion de estado — clasifica
// cual de los 12 call-sites de escritura de `orden.estatus_id` la produjo. Enum Postgres
// nativo (patron WalletMovimientoCategoria/GestionResultado), fuente unica de verdad
// reflejada en lib/types/orden-historial.ts.
enum OrdenHistorialOrigenTipo {
  carga_masiva // feature 15/27: estado inicial en createMany
  creacion_manual // feature 6: OrdenService.crear (create individual)
  generacion_guia // feature 17/30: generarGuiaLote
  asignacion_bodega // feature 17: asignarBodegaLote
  ruteo_satelite // feature 30: rutearBodegaSateliteLote
  recepcion_satelite // feature 33: recibirEnSatelite
  asignacion_satelite // feature 34: asignarSateliteLote
  recoleccion // feature 36: recogerLote
  gestion // feature 36: crearGestionYTransicionar
  liberacion_reprogramada // feature 46: liberarOrden (cron)
  ajuste_estado // feature 6: OrdenService.actualizar (CRUD generico)
  deshacer_gestion // feature 67 (F1.4-b): CierreDiaRepository.anularGestionYDevolverAGestion
  carga_api // feature 88 (D7): estado inicial en createManyOrdenesConGuia (canal integrador)
  liberacion_devuelta_sla // feature 99: cron SLA, devuelta -> en_bodega/en_bodega_satelite (reintento)
  escalado_devuelta_sla // feature 99: cron SLA, devuelta -> rechazada (escalado; enlaza gestion sintetica)
  reprogramacion_tienda // feature 100: adminTienda reprograma devuelta -> reprogramada (gestion sintetica reprogramada)
  recuperacion_manual // feature 100: bodega recupera devuelta -> en_bodega/en_bodega_satelite (accion manual, actor admin)
  cancelacion_api // feature 106: tienda cancela via API key en_bodega/en_ruta_bodega_principal -> devuelta_origen (marcador motivo="cancelada por tienda")
  corte_sin_gestionar // feature 109: corte diario transiciona en_reparto -> sin_gestionar (actor null/cron)
  liberacion_sin_gestionar // feature 109: al APROBAR el cierre, sin_gestionar -> en_bodega/en_bodega_satelite (actor admin)

  @@map("orden_historial_origen_tipo")
}

// Feature 49 (design §1.1/§1.3): HISTORIAL append-only de las transiciones de estado de
// una orden (linea de tiempo). Fila INMUTABLE (R2): SIN updatedAt/deletedAt, sin soft
// delete; una correccion se representa con una NUEVA transicion, jamas alterando una fila
// previa. `estatusOrigenId` NULL = creacion (R1/R20); `actorUsuarioId` NULL = sistema/cron
// (R21). RLS habilitada sin policies (solo service role, patron gestion_orden/cierre_dia/
// wallet_movimiento, R3). La orden usa soft-delete, no borrado fisico, asi que el historial
// nunca queda huerfano.
model OrdenHistorialEstado {
  id               String                   @id @default(uuid())
  ordenId          String                   @map("orden_id")
  estatusOrigenId  String?                  @map("estatus_origen_id") // NULL = creacion (R1/R20)
  estatusDestinoId String                   @map("estatus_destino_id")
  actorUsuarioId   String?                  @map("actor_usuario_id") // NULL = sistema/cron (R21)
  origenTipo       OrdenHistorialOrigenTipo @map("origen_tipo") // clasificacion (R23)
  motivo           String? // de la gestion (R22); vacio en las demas transiciones
  gestionOrdenId   String?                  @map("gestion_orden_id") // enlaza la gestion que causo la transicion (familia gestion)
  createdAt        DateTime                 @default(now()) @map("created_at") // instante de la transicion (R1)
  // SIN updated_at / deleted_at: fila INMUTABLE (R2).

  orden          Orden         @relation(fields: [ordenId], references: [id])
  estatusOrigen  OrderStatus?  @relation("HistorialOrigen", fields: [estatusOrigenId], references: [id])
  estatusDestino OrderStatus   @relation("HistorialDestino", fields: [estatusDestinoId], references: [id])
  actor          Usuario?      @relation("HistorialActor", fields: [actorUsuarioId], references: [id], onDelete: SetNull)
  // Feature 67 (F1.4-i): ON DELETE **Restrict** EXPLICITO (no el default `SetNull` de una
  // relacion opcional). Este enlace sostiene el derivador de intentos (47/49), que dispara
  // `rechazada` -> cobroRechazado (56, dinero): un SET NULL silencioso lo corromperia sin
  // error. Declarado en el MODELO (no solo en SQL) para no reintroducir el drift que la
  // migracion 20260714123909 vino a eliminar. Las gestiones NO se borran: se ANULAN (67/R11).
  gestion        GestionOrden? @relation(fields: [gestionOrdenId], references: [id], onDelete: Restrict)

  @@index([ordenId, createdAt]) // R5: linea de tiempo de UNA orden
  @@index([ordenId, estatusDestinoId]) // R24: conteo de intentos (destinos `devuelta`)
  @@map("orden_historial_estado")
}

// Feature 69 (R1/R2/R6/R7/R8/R10/R11, design §2.1/§2.2): SNAPSHOT congelado del detalle de
// cada orden incluida en un cierre del dia. Grano (cierre_id, orden_id): a lo sumo UNA fila
// por orden y cierre, aunque la orden acumule varias gestiones vigentes en el mismo cierre
// (R2). Fila INMUTABLE (patron orden_historial_estado): SIN updated_at/deleted_at, sin soft
// delete — ninguna operacion posterior a la creacion del cierre la modifica (R10).
//
// El PORQUE: los feeds de wallet (42/43) leian `orden`/`zona`/`tarifas` VIVAS dentro de la tx
// de APROBACION. Editar `monto_cobrar` o la tarifa entre SOLICITAR y APROBAR descuadraba en
// silencio los `total_*` snapshot del cierre (37/R14) contra los movimientos emitidos. Aqui el
// cierre deja de PREGUNTAR y pasa a RECORDAR: se congela al crear el cierre (R3, misma tx).
//
// Se congelan las ENTRADAS de la formula, no los conceptos derivados (decision (b), design
// §7.1): los conceptos dependen del `resultado` de la GESTION, no de la orden, y exigirian el
// grano gestion. Con las entradas + `derivarIngresoOrden` (sin cambios, R21) la fila es
// re-derivable y auditable.
//
// `es_central` y los 5 nombres son COLUMNAS aunque exista el FK: `zona.es_central` y los
// nombres son MUTABLES; guardar solo el FK dejaria abierto el mismo vector (cambiar la zona
// central re-etiquetaria cierres viejos).
//
// Dinero DECIMAL(12,2), porcentajes DECIMAL(5,2); money-safe: nunca number/parseFloat (R11).
// RLS habilitada sin policies va en el SQL de la migracion (Prisma no la expresa, R25).
model CierreDetail {
  id       String @id @default(uuid())
  cierreId String @map("cierre_id")
  ordenId  String @map("orden_id")

  // --- money-critical (R6): las entradas de la formula de derivacion ---
  montoCobrar   Decimal? @map("monto_cobrar") @db.Decimal(12, 2) // `orden.monto_cobrar` (ya nullable en origen)
  cobraComision Boolean  @map("cobra_comision") // `orden.cobra_comision`
  zonaId        String   @map("zona_id") // `orden.zona_id`
  tiendaId      String   @map("tienda_id") // `orden.tienda_id`: a quien se acredita (43), CONGELADO
  esCentral     Boolean  @map("es_central") // `zona.es_central` EN ESE INSTANTE (elige columna GAM, R21)

  // --- tarifa congelada (R8): todas o ninguna. NULL = la tienda no tenia tarifa vigente al
  // solicitar (gap R9, decision (c)): conceptos 0.00, NO bloquea el cierre. `tarifa_id` deja
  // rastro de QUE FILA se uso (contrapartida auditable de la deuda (g), design §6.1).
  tarifaId                    String?  @map("tarifa_id")
  tarifaValorFlete            Decimal? @map("tarifa_valor_flete") @db.Decimal(12, 2) // monto
  tarifaValorFleteGam         Decimal? @map("tarifa_valor_flete_gam") @db.Decimal(12, 2) // monto
  tarifaValorFleteDevuelto    Decimal? @map("tarifa_valor_flete_devuelto") @db.Decimal(12, 2) // monto
  tarifaValorFleteDevueltoGam Decimal? @map("tarifa_valor_flete_devuelto_gam") @db.Decimal(12, 2) // monto
  tarifaComisionCod           Decimal? @map("tarifa_comision_cod") @db.Decimal(5, 2) // porcentaje 0..100
  tarifaIvaFlete              Decimal? @map("tarifa_iva_flete") @db.Decimal(5, 2) // porcentaje 0..100
  tarifaIvaComisionCod        Decimal? @map("tarifa_iva_comision_cod") @db.Decimal(5, 2) // porcentaje 0..100

  // --- descriptivos (R7): lo que el admin ve del cierre (38), congelado ---
  numGuia         Int?    @map("num_guia") // SIN @unique: es copia, no identidad
  numRemision     String  @map("num_remision")
  destinatario    String
  direccion       String? // `orden.direccion` (nullable en origen)
  producto        String
  tiendaNombre    String  @map("tienda_nombre")
  zonaNombre      String  @map("zona_nombre")
  provinciaNombre String  @map("provincia_nombre")
  cantonNombre    String  @map("canton_nombre")
  distritoNombre  String? @map("distrito_nombre") // el distrito es el unico FK nullable de la orden

  createdAt DateTime @default(now()) @map("created_at")
  // SIN updated_at / deleted_at: fila INMUTABLE (R10).

  cierre CierreDia @relation(fields: [cierreId], references: [id])
  orden  Orden     @relation(fields: [ordenId], references: [id])
  zona   Zona      @relation(fields: [zonaId], references: [id])
  tienda Usuario   @relation("CierreDetailTienda", fields: [tiendaId], references: [id])
  tarifa Tarifa?   @relation(fields: [tarifaId], references: [id])

  @@unique([cierreId, ordenId]) // R2: el grano. Es tambien el indice de la ruta caliente (los feeds filtran por cierre_id)
  @@index([ordenId]) // trazar en que cierres aparecio una orden
  @@map("cierre_detail")
}

// Feature 81 (design §2): una API key emitida por un maestro. La key en claro NUNCA
// se persiste: solo su hash SHA-256 [D7] (R16) y un `key_prefix` no secreto (R17)
// para poder identificarla visualmente sin revelarla. 1:1 con su usuario dedicado
// [D6]: `usuario_id` UNIQUE. Sin `revoked_at`/`expires_at`/`last_used_at`: fuera de
// alcance (81b), se añaden aditivamente cuando el humano los pida.
// Ciclo de vida de una API key (rotar/activar/desactivar). El estado de la key es
// PROPIO de la fila `api_key`, NO se reusa el estado del usuario dedicado: activar o
// desactivar una key no debe tocar la cuenta (ni al reves). `activa` autoriza la carga
// (feature 88/R7), `inactiva` la revoca sin borrar la fila (ni el hash ni el rastro).
enum EstadoApiKey {
  activa
  inactiva

  @@map("estado_api_key")
}

model ApiKey {
  id            String       @id @default(uuid())
  identificador String // input crudo (recortado) para mostrar. No unico [D8]
  slug          String // normalizado; base del email/cedula sinteticos (R5)
  keyPrefix     String       @map("key_prefix") // `ordx_` + 7 chars, en claro (R17)
  keyHash       String       @unique @map("key_hash") // SHA-256 hex del secreto completo (R16/R25)
  estado        EstadoApiKey @default(activa) @map("estado") // ciclo de vida propio de la key (activar/desactivar)
  usuarioId     String       @unique @map("usuario_id") // [D6] 1:1 con la cuenta dedicada (R21)
  createdById   String       @map("created_by_id") // actor que la genero (R21)
  createdAt     DateTime     @default(now()) @map("created_at") // R21
  updatedAt     DateTime     @updatedAt @map("updated_at")

  usuario   Usuario @relation("ApiKeyUsuario", fields: [usuarioId], references: [id])
  createdBy Usuario @relation("ApiKeyCreadaPor", fields: [createdById], references: [id])

  @@index([createdById])
  @@map("api_key")
}

// Feature 99 (design §1.1, R1/R2) — suscripcion de webhook por OWNER (el usuario dueno de
// las ordenes; para integradores, el usuario dedicado de la API key). El identificador del
// suscriptor NO se inventa: es `owner_usuario_id` (unico -> a lo sumo UNA suscripcion por
// owner, R1; el re-registro es un upsert por esa clave, R6). `secret` guarda el CIPHERTEXT
// del secreto de firma (AES-256-GCM, design §1.3/§3.1, D2/R32): NUNCA texto plano. RLS
// habilitada SIN policies (R2), patron api_key / jobs / geocode_cache: la tabla guarda un
// secreto y solo es accesible desde el rol de servicio. El vinculo con las ordenes ya
// existe (`orden.tienda_id = owner_usuario_id`), no se crea uno nuevo.
model WebhookSuscripcion {
  id             String   @id @default(uuid())
  ownerUsuarioId String   @unique @map("owner_usuario_id") // R1: 1 por owner; R6: upsert por esta clave
  url            String // callback https absoluta (validada en el borde, R5)
  secret         String // CIPHERTEXT del secreto de firma HMAC (design §1.3, D2/R32) — nunca en claro
  activa         Boolean  @default(true) // R8: baja = activa=false
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner Usuario @relation("WebhookSuscripcionOwner", fields: [ownerUsuarioId], references: [id], onDelete: Restrict)

  @@map("webhook_suscripcion")
}

// Feature 90 (design §1.1): tipo de un background job. Enum NATIVO de Postgres con
// `@@map`, ampliable por `ALTER TYPE ... ADD VALUE` en las features 91/92 (geocodificacion,
// webhooks). En v1 solo existe el job recurrente de liberacion de reprogramadas (feature 46).
enum JobTipo {
  liberar_reprogramadas // 91/92 anaden valores aditivamente
  geocodificacion // feature 91: geocodifica la direccion de UNA orden (payload { ordenId })
  optimizacion_ruta // feature 92: reoptimiza la ruta de UN mensajero (payload { mensajeroId })
  webhook_estado // feature 99: entrega firmada del cambio de estado de UNA orden a su integrador (payload { ordenId, estatusDestinoId, ocurridoAt })

  @@map("job_tipo")
}

// Feature 90 (design §1.1): estado del ciclo de vida de un job en la cola. Enum NATIVO
// de Postgres con `@@map`. `pending` (encolado, vencido o no), `processing` (reclamado por
// un worker), `done` (ejecutado con exito), `failed` (dead-letter tras agotar intentos).
enum JobEstado {
  pending
  processing
  done
  failed

  @@map("job_estado")
}

// Feature 90 (design §1.2): una fila de la cola de background jobs (patron
// transactional-outbox + worker sobre Postgres). El drenador `procesar-jobs` reclama
// lotes vencidos con `FOR UPDATE SKIP LOCKED`, ejecuta el handler por tipo y aplica
// complete / backoff / dead-letter. Los indices REALES son PARCIALES (seleccion de
// pendientes vencidos y unicidad de `dedupe_key` no nulo) y la RLS sin policies van a
// mano en la migracion (Prisma no expresa ni indices parciales ni RLS). RLS habilitada
// sin policies (solo service role), patron api_key / wallet_movimiento / premio_ranking.
model Job {
  id          String    @id @default(uuid())
  tipo        JobTipo
  payload     Json      @default("{}") @db.JsonB
  estado      JobEstado @default(pending)
  intentos    Int       @default(0)
  maxIntentos Int       @map("max_intentos")
  runAfter    DateTime  @default(now()) @map("run_after")
  lockedAt    DateTime? @map("locked_at")
  lastError   String?   @map("last_error")
  dedupeKey   String?   @unique @map("dedupe_key") // el indice REAL es unico PARCIAL (WHERE dedupe_key IS NOT NULL)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("jobs")
}

// Feature 91 (design §1.2, R2/R28): cache de direcciones YA resueltas, indexada por la
// HUELLA de la direccion normalizada (nunca la direccion en claro: es dato personal).
// Evita re-pagar al proveedor por direcciones repetidas y abarata los reintentos de la
// cola. Solo se cachean resultados SATISFACTORIOS: un ZERO_RESULTS vive en la orden
// (`geocode_status`), no aqui. Retencion PERMANENTE, sin TTL (gate F1.4-Q7): la
// invalidacion es implicita, una direccion distinta produce una huella distinta.
// RLS habilitada sin policies (solo service role), patron jobs / api_key: guarda
// coordenadas y no es accesible desde el cliente.
model GeocodeCache {
  id            String   @id @default(uuid())
  direccionHash String   @unique @map("direccion_hash")
  latitud       Decimal  @db.Decimal(10, 7)
  longitud      Decimal  @db.Decimal(10, 7)
  precision     String
  payloadCrudo  Json?    @map("payload_crudo") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("geocode_cache")
}

// Feature 92 (design §1.1, R27/R30): estado de la ruta optimizada de un mensajero. Enum
// NATIVO (patron JobEstado): vocabulario PROPIO y cerrado. `desactualizada` significa que
// la ultima llamada al proveedor fallo y se CONSERVA el orden anterior (R27): la secuencia
// previa NUNCA se borra ni se cae en silencio a `createdAt desc`.
enum RutaEstado {
  vigente
  desactualizada

  @@map("ruta_estado")
}

// Feature 92 (design §1.1, R23/R26/R27): cabecera de la ruta optimizada de UN mensajero
// (una fila por mensajero, `mensajeroId` unico). Guarda el origen desde el que se calculo
// la ruta con su fuente (gps | ultima_conocida | centroide) y la huella del conjunto de
// paradas + origen, que es la guarda de coste R36 (mismo conjunto -> no se vuelve a pagar).
// `ultimoError` guarda un mensaje AGREGADO: NUNCA credencial, token, direccion ni
// coordenadas (R14). RLS habilitada sin policies (solo service role, va en la migracion):
// guarda geolocalizacion de una persona y no es accesible desde el cliente.
model RutaOptimizada {
  id           String     @id @default(uuid())
  mensajeroId  String     @unique @map("mensajero_id")
  estado       RutaEstado @default(vigente)
  calculadaAt  DateTime?  @map("calculada_at") // NULL = nunca se calculo
  origenLat    Decimal?   @map("origen_lat") @db.Decimal(10, 7)
  origenLng    Decimal?   @map("origen_lng") @db.Decimal(10, 7)
  origenAt     DateTime?  @map("origen_at")
  origenFuente String?    @map("origen_fuente")
  huellaSet    String?    @map("huella_set")
  ultimoError  String?    @map("ultimo_error")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  mensajero Usuario                @relation("RutaOptimizadaMensajero", fields: [mensajeroId], references: [id], onDelete: Cascade)
  paradas   RutaOptimizadaParada[]

  @@map("ruta_optimizada")
}

// Feature 92 (design §1.1/§5.2, R26): una parada POSICIONADA de la ruta. Los dos indices
// unicos `(rutaId, ordenId)` y `(rutaId, secuencia)` son los que hacen IMPOSIBLE persistir
// una secuencia con posiciones repetidas o con la misma orden dos veces: la invariante la
// garantiza la DB, no solo el codigo. Una orden en reparto SIN fila aqui es una parada
// "sin optimizar" (R28), que la lectura muestra al final.
model RutaOptimizadaParada {
  id        String @id @default(uuid())
  rutaId    String @map("ruta_id")
  ordenId   String @map("orden_id")
  secuencia Int

  ruta  RutaOptimizada @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  orden Orden          @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@unique([rutaId, ordenId])
  @@unique([rutaId, secuencia])
  @@index([ordenId])
  @@map("ruta_optimizada_parada")
}
